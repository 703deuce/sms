generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  /// Supabase Connect → Session pooler URI (port 5432). Required for `npm run db:push`.
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMINISTRATOR
  MANAGER
  CAMPAIGN_CREATOR
  INBOX_AGENT
  ANALYST
  READ_ONLY
}

enum ContactStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BLOCKED
  INVALID
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  FAILED
  PAUSED
  CANCELED
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
  SNOOZED
  SPAM
}

enum FlowStatus {
  ACTIVE
  DRAFT
  PAUSED
  ERROR
  ARCHIVED
}

enum ComplianceStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum MessagingStepStatus {
  not_started
  action_required
  submitted
  in_review
  approved
  failed
  suspended
  ready
}

enum RecipientWorkflowStatus {
  pending
  scheduled
  in_progress
  waiting
  completed
  stopped
  failed
  opted_out
}

enum JobQueueStatus {
  pending
  processing
  completed
  failed
  deferred
}

enum PaymentLinkStatus {
  pending
  paid
  expired
  canceled
}

enum WorkspaceType {
  PERSONAL
  BUSINESS
}

enum ProductKey {
  SMS
  NUMBERS
  VOICE
}

enum ProductAccessStatus {
  ACTIVE
  INACTIVE
  TRIAL
}

/// Transovo product features (MCTB, Smart Routing, add-ons) — workspace-scoped.
enum WorkspaceProductFeatureKey {
  MCTB
  MASS_TEXTING
  SMART_ROUTING
  CALL_FORWARDING
  VISUAL_VOICEMAIL
  CALLBACK_REQUESTS
  AI_TRANSCRIPTION
}

/// Shared inbox product discriminator (MCTB vs Mass Texting vs manual).
enum ConversationProductSource {
  MCTB
  MASS_TEXT
  MANUAL
  AUTOMATION
}

/// Separate A2P/messaging registration profiles per product use case.
enum MessagingProductUseCase {
  MCTB_CUSTOMER_CARE
  MASS_TEXT_MARKETING
}

/// Mass Texting billing lifecycle (trial → paid production).
enum MassTextingLifecycleState {
  TRIAL_PENDING_A2P
  TRIAL_ACTIVE
  TRIAL_LIMIT_REACHED
  TRIAL_EXPIRED
  CONVERSION_SELECTED
  PAYMENT_REQUIRED
  PRODUCTION_A2P_PENDING
  PRODUCTION_ACTIVE
  CANCELED
}

enum MassTextA2pFeeStatus {
  NOT_REQUIRED
  PENDING
  PAID
  WAIVED
}

enum MassTextCreditReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

model User {
  id                  String       @id @default(cuid())
  email               String       @unique
  name                String
  passwordHash        String?
  phone               String?
  phoneVerifiedAt     DateTime?
  isPlatformAdmin     Boolean      @default(false)
  totpSecretEnc       String?
  totpEnabled         Boolean      @default(false)
  totpBackupCodes     String[]     @default([])
  /// Last product the user opened (sms | numbers) for multi-product login routing.
  lastActiveProduct   ProductKey?
  /// Signup source / product intent preserved across authentication.
  productIntent       ProductKey?
  deletionRequestedAt DateTime?
  createdAt           DateTime     @default(now())
  memberships         Membership[]
  assignedConversations Conversation[] @relation("Assignee")
  auditLogs           AuditLog[]
  phoneAssignments    PhoneNumberAssignment[]
  premiumNumberReservations PremiumNumberReservation[]
  premiumNumberSearchLogs   PremiumNumberSearchLog[]
  numberServiceSubscriptions NumberServiceSubscription[]
  inAppNotifications  InAppNotification[]
  invitesSent         WorkspaceInvite[] @relation("InviteSender")
  ownedWorkspaces     Workspace[] @relation("WorkspaceOwner")

  @@index([phone])
}

model Workspace {
  id                   String        @id @default(cuid())
  name                 String
  slug                 String        @unique
  type                 WorkspaceType @default(BUSINESS)
  ownerUserId          String?
  displayName          String?
  logoUrl              String?
  primaryColor         String?  @default("#0f766e")
  accentColor          String?  @default("#0ea5e9")
  shortLinkDomain      String?
  formTheme            String?  @default("light")
  reviewLinkUrl        String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  billingPlan          String?  @default("growth")
  creditBalanceCents   Int      @default(0)
  customFieldsConfig   Json?
  activeFromNumberId   String?
  createdAt            DateTime @default(now())
  memberships Membership[]
  phoneNumbers PhoneNumber[]
  premiumNumberReservations PremiumNumberReservation[]
  premiumNumberSearchLogs PremiumNumberSearchLog[]
  numberServiceSubscriptions NumberServiceSubscription[]
  marketplaceStripeRefunds  MarketplaceStripeRefund[]
  contacts    Contact[]
  lists       ContactList[]
  segments    Segment[]
  tags        Tag[]
  campaigns   Campaign[]
  conversations Conversation[]
  templates   Template[]
  flows       AutomationFlow[]
  triggerDeployments TriggerDeployment[]
  solutionSetups SolutionSetup[]
  platformEvents PlatformEvent[]
  keywords    Keyword[]
  autoReplies AutoReply[]
  forms       OptInForm[]
  consentRecords ConsentRecord[]
  qrCodes     QrCode[]
  clickToTextLinks ClickToTextLink[]
  brand       ComplianceBrand?
  complianceCampaign ComplianceCampaign?
  messagingRegistration MessagingRegistration?
  messagingRegistrationEvents MessagingRegistrationEvent[]
  messagingProductRegistrations MessagingProductRegistration[]
  listImportAttestations ListImportAttestation[]
  campaignLaunchAudits CampaignLaunchAudit[]
  massTextingBillingAccount MassTextingBillingAccount?
  massTextingCreditReservations MassTextingCreditReservation[]
  massTextingBillingEvents MassTextingBillingEvent[]
  campaignRecipients CampaignRecipient[]
  campaignMessages CampaignMessage[]
  suppressions Suppression[]
  jobQueue    JobQueue[]
  integrationWebhooks IntegrationWebhookEndpoint[]
  integrationWebhookEvents IntegrationWebhookEvent[]
  apiKeys     ApiKey[]
  webhooks    Webhook[]
  auditLogs   AuditLog[]
  usageRecords UsageRecord[]
  automationExecutions AutomationExecution[]
  formSubmissions FormSubmission[]
  voiceAgents VoiceAgent[]
  voiceAgentVersions VoiceAgentVersion[]
  voiceAgentPhoneNumbers VoiceAgentPhoneNumber[]
  voiceKnowledgeBases VoiceKnowledgeBase[]
  voiceKnowledgeSources VoiceKnowledgeSource[]
  voiceAgentKnowledgeBases VoiceAgentKnowledgeBase[]
  voiceTools VoiceTool[]
  voiceAgentTools VoiceAgentTool[]
  voiceCalendarConnections VoiceCalendarConnection[]
  voiceServices VoiceService[]
  voiceStaffMembers VoiceStaffMember[]
  voiceRoutingRules VoiceRoutingRule[]
  voiceCampaigns VoiceCampaign[]
  voiceCampaignContacts VoiceCampaignContact[]
  voiceCampaignAttempts VoiceCampaignAttempt[]
  voiceCalls VoiceCall[]
  voiceCallLegs VoiceCallLeg[]
  voiceCallEvents VoiceCallEvent[]
  voiceTransfers VoiceTransfer[]
  voiceRecordings VoiceRecording[]
  voiceTranscripts VoiceTranscript[]
  voiceTranscriptSegments VoiceTranscriptSegment[]
  voiceConversationInsights VoiceConversationInsight[]
  voiceToolExecutions VoiceToolExecution[]
  voiceAppointments VoiceAppointment[]
  appointmentSlotHolds AppointmentSlotHold[]
  voiceTestRuns VoiceTestRun[]
  voiceComplianceProfile VoiceComplianceProfile?
  voiceUsageRecords VoiceUsageRecord[]
  voiceIntegrationSecrets VoiceIntegrationSecret[]
  providerWebhookEvents ProviderWebhookEvent[]
  linkClickEvents LinkClickEvent[]
  mediaAssets MediaAsset[]
  surveys Survey[]
  surveyResponses SurveyResponse[]
  growWidgets GrowWidget[]
  contactCardProfile ContactCardProfile?
  messagingSettings WorkspaceMessagingSettings?
  emailToSmsAddresses EmailToSmsAddress[]
  paymentLinks PaymentLink[]
  portRequests PortRequest[]
  portOutRequests PortOutRequest[]
  humanCalls HumanCall[]
  humanCallEvents HumanCallEvent[]
  pushSubscriptions PushSubscription[]
  notificationPrefs WorkspaceNotificationPrefs[]
  workspaceLimits WorkspaceLimits?
  workspaceDataPrefs WorkspaceDataPrefs?
  workspacePhoneSettings WorkspacePhoneSettings?
  creditLedgerEntries CreditLedgerEntry[]
  senderPools SenderPool[]
  invites WorkspaceInvite[]
  inAppNotifications InAppNotification[]
  contests Contest[]
  integrationConnections IntegrationConnection[]
  callQueues CallQueue[]
  ivrMenus IvrMenu[]
  callParkSlots CallParkSlot[]
  conferenceCalls ConferenceCall[]
  conferenceParticipants ConferenceParticipant[]
  voicemailBoxes VoicemailBox[]
  voicemailMessages VoicemailMessage[]
  callForwardingRules CallForwardingRule[]
  softphonePresence SoftphonePresence[]
  softphoneDevices SoftphoneDevice[]
  softphoneUserSettings SoftphoneUserSettings[]
  crmObjectMappings CrmObjectMapping[]
  crmFieldMappings CrmFieldMapping[]
  crmSyncRuns CrmSyncRun[]
  crmSyncEvents CrmSyncEvent[]
  crmAuditLogs CrmAuditLog[]
  crmWebhookEvents CrmWebhookEvent[]
  crmDeadLetters CrmDeadLetter[]
  integrationActionLogs IntegrationActionLog[]
  aiActionApprovals AiActionApproval[]
  integrationAlerts IntegrationAlert[]
  integrationContextCaches IntegrationContextCache[]
  integrationTasks IntegrationTask[]
  integrationOrders IntegrationOrder[]
  workspaceAiIntegrationPolicy WorkspaceAiIntegrationPolicy?
  voiceAiConversations VoiceAiConversation[]
  voiceAiConversationMessages VoiceAiConversationMessage[]
  voiceMemoryConfigs VoiceMemoryConfig[]
  voiceInsightDefinitions VoiceInsightDefinition[]
  voiceInsightGroups VoiceInsightGroup[]
  voiceScheduledEvents VoiceScheduledEvent[]
  voiceMcpServers VoiceMcpServer[]
  voiceCanaryDeploys VoiceCanaryDeploy[]
  voiceAssistantTests VoiceAssistantTest[]
  voiceTestSuites VoiceTestSuite[]
  voiceAssistantTestRuns VoiceAssistantTestRun[]
  voiceAssistantTags VoiceAssistantTag[]
  voiceObservabilityConfigs VoiceObservabilityConfig[]
  voiceConcurrencyAllocations VoiceConcurrencyAllocation[]
  voiceFailureDiagnostics VoiceFailureDiagnostic[]
  voiceTransferDestinations VoiceTransferDestination[]
  voiceWidgetConfigs VoiceWidgetConfig[]
  voiceRemoteVersions VoiceRemoteAssistantVersion[]
  missedCallTextConfig MissedCallTextConfig?
  missedCallEvents MissedCallEvent[]
  missedCallTextTraces MissedCallTextTrace[]
  mctbVoiceBridgeCallEvents MctbVoiceBridgeCallEvent[]
  agentConfigurationChanges AgentConfigurationChange[]
  smartRoutingFlows SmartRoutingFlow[]
  smartRoutingDestinations SmartRoutingDestination[]
  smartRoutingAudioAssets SmartRoutingAudioAsset[]
  smartRoutingCallSessions SmartRoutingCallSession[]
  smartRoutingSmsConsentEvents SmartRoutingSmsConsentEvent[]
  smartRoutingWorkspaceSettings SmartRoutingWorkspaceSettings?
  callForwardingWorkspaceSettings CallForwardingWorkspaceSettings?
  callForwardingAuthorizedCallers CallForwardingAuthorizedCaller[]
  callForwardingOutboundCalls CallForwardingOutboundCall[]
  smartRoutingAuthorizedCallers SmartRoutingAuthorizedCaller[]
  smartRoutingOutboundCalls SmartRoutingOutboundCall[]
  smartRoutingAccessSessions SmartRoutingAccessSession[]
  smartRoutingAiProposals SmartRoutingAiProposal[]
  smartRoutingAiRecommendations SmartRoutingAiRecommendation[]
  smartRoutingEmployeeAccessTokens SmartRoutingEmployeeAccessToken[]
  smartRoutingCallRecordings SmartRoutingCallRecording[]
  smartRoutingCallControlSessions SmartRoutingCallControlSession[]
  smartRoutingCallbackCodes SmartRoutingCallbackCode[]
  productEntitlements ProductEntitlement[]
  workspaceProductFeatures WorkspaceProductFeature[]
  platformProductSubscriptions PlatformProductSubscription[]
  platformTranscriptionUsageRecords PlatformTranscriptionUsageRecord[]
  callbackRequests CallbackRequest[]
  mctbRequestFormSubmissions MctbRequestFormSubmission[]
  owner           User?     @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([ownerUserId])
  @@index([type])
}

model ProductEntitlement {
  id            String              @id @default(cuid())
  workspaceId   String
  productKey    ProductKey
  status        ProductAccessStatus @default(ACTIVE)
  activatedAt   DateTime?
  deactivatedAt DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, productKey])
  @@index([workspaceId])
  @@index([productKey, status])
}

model WorkspaceProductFeature {
  id            String                    @id @default(cuid())
  workspaceId   String
  featureKey    WorkspaceProductFeatureKey
  status        ProductAccessStatus       @default(ACTIVE)
  activatedAt   DateTime?
  deactivatedAt DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  workspace     Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, featureKey])
  @@index([workspaceId])
  @@index([featureKey, status])
  @@map("workspace_product_features")
}

/// Workspace-level Transovo product subscriptions (MCTB, Smart Routing) — one Stripe sub per family.
model PlatformProductSubscription {
  id                    String    @id @default(cuid())
  workspaceId           String
  productFamily         String
  tier                  String
  stripeCustomerId      String?
  stripeSubscriptionId  String    @unique
  stripePriceId         String
  status                String    @default("active")
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean   @default(false)
  includedMinutes       Int?
  minutesUsedThisPeriod Int       @default(0)
  transcriptionMinutesUsedThisPeriod Int @default(0)
  usagePeriodStart      DateTime?
  usagePeriodEnd        DateTime?
  overageMinutesBilled  Int       @default(0)
  metadataJson          Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  usageRecords          PlatformSmartRoutingUsageRecord[]
  callForwardingUsageRecords PlatformCallForwardingUsageRecord[]
  transcriptionUsageRecords PlatformTranscriptionUsageRecord[]

  @@unique([workspaceId, productFamily])
  @@index([workspaceId, status])
  @@index([stripeCustomerId])
  @@map("platform_product_subscriptions")
}

/// Idempotent Smart Routing conversation-minute accounting.
model PlatformSmartRoutingUsageRecord {
  id                String   @id @default(cuid())
  workspaceId       String
  subscriptionId    String
  callSessionId     String   @unique
  conversationMinutes Int
  recordedAt        DateTime @default(now())
  billingPeriodStart DateTime?
  subscription      PlatformProductSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, recordedAt])
  @@index([subscriptionId])
  @@map("platform_smart_routing_usage_records")
}

/// AI transcription usage — separate from Smart Routing conversation minutes.
model PlatformTranscriptionUsageRecord {
  id                  String   @id @default(cuid())
  workspaceId         String
  subscriptionId      String?
  sourceType          String
  sourceId            String
  provider            String?
  audioDurationSeconds Int?
  transcriptionMinutes Int
  transcriptionProvider String  @default("deepgram")
  transcriptionModel  String    @default("nova-3")
  status              String    @default("completed")
  idempotencyKey      String    @unique
  recordedAt          DateTime  @default(now())
  billingPeriodStart  DateTime?
  errorMessage        String?
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription        PlatformProductSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, recordedAt])
  @@index([subscriptionId])
  @@map("platform_transcription_usage_records")
}

model CallbackRequest {
  id                    String    @id @default(cuid())
  workspaceId           String
  callerE164            String
  businessE164          String?
  phoneNumberId         String?
  smartRoutingSessionId String?
  sourceRoute           String?
  reason                String?
  status                String    @default("new")
  notes                 String?
  assignedToUserId      String?
  completedByUserId     String?
  voicemailMessageId    String?
  requestedAt           DateTime  @default(now())
  contactedAt           DateTime?
  completedAt           DateTime?
  dismissedAt           DateTime?
  metadata              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, requestedAt])
  @@index([workspaceId, callerE164])
  @@map("callback_requests")
}

model SenderPool {
  id              String   @id @default(cuid())
  workspaceId     String
  name            String
  description     String?
  phoneNumberIds  String[] @default([])
  status          String   @default("Active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("sender_pools")
}

model Membership {
  id          String    @id @default(cuid())
  role        Role      @default(INBOX_AGENT)
  userId      String
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model PhoneNumber {
  id               String   @id @default(cuid())
  workspaceId      String
  e164             String
  type             String
  areaCode         String?
  friendlyName     String?
  /// Upstream telephony provider that owns this DID (telnyx | twilio).
  provider         String   @default("telnyx")
  twilioSid        String?
  providerNumberId String?
  providerOrderId  String?
  a2pStatus        ComplianceStatus @default(PENDING)
  messagingService String?
  monthlyCostCents Int      @default(115)
  status           String   @default("Active")
  purchasedAt      DateTime?
  releasedAt       DateTime?
  voiceForwardTo   String?
  webhookUrl       String?
  capabilitiesJson Json?
  settingsJson     Json?
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignments      PhoneNumberAssignment[]
  triggerDeployments TriggerDeployment[]
  numberServiceSubscriptions NumberServiceSubscription[]

  @@unique([workspaceId, e164])
  @@index([twilioSid])
}

model PremiumNumberReservation {
  id                   String    @id @default(cuid())
  workspaceId          String
  userId               String
  phoneNumber          String
  vanityDisplay        String?
  displayNumber        String?
  searchMode           String
  searchContextJson    Json?
  businessMatchScore   Int       @default(0)
  numberQualityScore   Int       @default(0)
  premiumPriceCents    Int
  premiumPriceBand     String?
  telnyxReservationId  String?
  /// telnyx | twilio — which upstream API must provision/release this number.
  provider             String   @default("telnyx")
  providerReference      String?
  reservationExpiresAt DateTime?
  reservationStatus    String    @default("reserving")
  paymentStatus        String    @default("none")
  orderStatus          String    @default("none")
  telnyxOrderId        String?
  phoneNumberId        String?
  searchLogId          String?
  stripeSessionId      String?
  stripePaymentIntentId String?
  fulfillmentStatus    String    @default("none")
  stripeRefundId       String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketplaceRefunds   MarketplaceStripeRefund[]

  @@index([workspaceId, phoneNumber])
  @@index([telnyxReservationId])
  @@index([stripeSessionId])
  @@map("premium_number_reservations")
}

/// Fixed recurring marketplace services (Vault, Voicemail, Forwarding) synced to Stripe via API.
model MarketplaceBillingProduct {
  id                   String   @id @default(cuid())
  productKey           String   @unique
  displayName          String
  description          String?
  amountCents          Int
  currency             String   @default("usd")
  billingInterval      String   @default("month")
  includedUsageMinutes Int?
  stripeProductId      String?
  stripePriceId        String?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  subscriptions        NumberServiceSubscription[]
  priceHistory         MarketplaceBillingPriceHistory[]

  @@map("marketplace_billing_products")
}

/// Historical Stripe Price IDs — active catalog row points at current price for new purchases.
model MarketplaceBillingPriceHistory {
  id                    String   @id @default(cuid())
  productId             String
  stripePriceId         String   @unique
  amountCents           Int
  activeForNewPurchases Boolean  @default(false)
  createdAt             DateTime @default(now())
  product               MarketplaceBillingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@map("marketplace_billing_price_history")
}

/// Per-number recurring service subscription (Vault / Voicemail / Forwarding).
model NumberServiceSubscription {
  id                       String   @id @default(cuid())
  workspaceId              String
  userId                   String
  phoneNumberId            String
  productKey               String
  productId                String
  stripeCustomerId         String?
  stripeSubscriptionId     String?  @unique
  stripePriceId            String?
  status                   String   @default("pending")
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  cancelAtPeriodEnd        Boolean  @default(false)
  includedMinutesPerPeriod Int?
  minutesUsedThisPeriod    Int      @default(0)
  usagePeriodStart         DateTime?
  usagePeriodEnd           DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber              PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  product                  MarketplaceBillingProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([workspaceId, phoneNumberId])
  @@index([phoneNumberId, productKey])
  @@index([stripeSubscriptionId])
  @@map("number_service_subscriptions")
}

/// Stripe refund audit trail for marketplace purchases and service billing.
model MarketplaceStripeRefund {
  id                    String   @id @default(cuid())
  workspaceId           String
  reservationId         String?
  phoneNumberId         String?
  stripePaymentIntentId String?
  stripeRefundId        String   @unique
  amountCents           Int
  reason                String
  status                String   @default("succeeded")
  createdAt             DateTime @default(now())
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reservation           PremiumNumberReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([reservationId])
  @@map("marketplace_stripe_refunds")
}

model PremiumNumberSearchLog {
  id                  String   @id @default(cuid())
  workspaceId         String
  userId              String?
  mode                String
  areaCode            String
  industry            String?
  keywordsJson        Json?
  businessMatchCount  Int      @default(0)
  memorableMatchCount Int      @default(0)
  totalResults        Int      @default(0)
  resultsJson         Json?
  selectedNumber      String?
  checkoutStarted     Boolean  @default(false)
  purchaseCompleted   Boolean  @default(false)
  createdAt           DateTime @default(now())
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("premium_number_search_logs")
}

model PhoneNumberAssignment {
  id            String   @id @default(cuid())
  phoneNumberId String
  userId        String
  createdAt     DateTime @default(now())
  phoneNumber   PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([phoneNumberId, userId])
  @@index([userId])
  @@map("phone_number_assignments")
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        Role      @default(INBOX_AGENT)
  tokenHash   String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User?     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@map("workspace_invites")
}

model InAppNotification {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  type        String
  title       String
  body        String?
  href        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([workspaceId, userId, readAt])
  @@map("in_app_notifications")
}

model Contest {
  id               String    @id @default(cuid())
  workspaceId      String
  name             String
  keywordId        String?
  keywordText      String
  startAt          DateTime?
  endAt            DateTime?
  maxEntries       Int?
  winnerCount      Int       @default(1)
  status           String    @default("draft")
  rulesText        String?
  prizeDescription String?
  winnerContactIds String[]  @default([])
  drawnAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries          ContestEntry[]

  @@index([workspaceId, status])
  @@map("contests")
}

model ContestEntry {
  id        String   @id @default(cuid())
  contestId String
  contactId String?
  phone     String
  createdAt DateTime @default(now())
