enum VoiceAgentStatus {
  DRAFT
  TESTING
  ACTIVE
  PAUSED
  ARCHIVED
  CONFIGURATION_ERROR
}

enum VoiceCallDirection {
  INBOUND
  OUTBOUND
}

enum VoiceCallStatus {
  QUEUED
  INITIATED
  RINGING
  ANSWERED
  IN_PROGRESS
  COMPLETED
  NO_ANSWER
  BUSY
  FAILED
  CANCELLED
  VOICEMAIL
  TRANSFERRED
}

enum VoiceCampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

model VoiceAgent {
  id              String           @id @default(cuid())
  workspaceId     String
  name            String
  description     String?
  agentType       String           @default("custom")
  status          VoiceAgentStatus @default(DRAFT)
  displayName     String?
  purpose         String?
  phoneNumberId   String?
  directions      String[]         @default(["inbound", "outbound"])
  draftConfig     Json?
  publishedVersionId String?
  telnyxAssistantId String?
  telnyxConnectionId String?
  callsHandled    Int              @default(0)
  conversionRate  Float            @default(0)
  healthStatus    String           @default("ok")
  healthMessage   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  archivedAt      DateTime?
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions        VoiceAgentVersion[]
  phoneAssignments VoiceAgentPhoneNumber[]
  knowledgeLinks  VoiceAgentKnowledgeBase[]
  toolLinks       VoiceAgentTool[]
  calls           VoiceCall[]
  campaigns       VoiceCampaign[]
  routingRules    VoiceRoutingRule[]
  testRuns        VoiceTestRun[]

  @@index([workspaceId, status])
  @@map("voice_agents")
}

model VoiceAgentVersion {
  id          String   @id @default(cuid())
  workspaceId String
  agentId     String
  version     Int
  config      Json
  changeLog   String?
  publishedAt DateTime @default(now())
  publishedBy String?
  agent       VoiceAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  calls       VoiceCall[]

  @@unique([agentId, version])
  @@index([workspaceId])
  @@map("voice_agent_versions")
}

model VoiceAgentPhoneNumber {
  id            String   @id @default(cuid())
  workspaceId   String
  agentId       String
  phoneNumberId String
  inboundEnabled Boolean @default(true)
  outboundEnabled Boolean @default(true)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  agent         VoiceAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([agentId, phoneNumberId])
  @@index([workspaceId])
  @@map("voice_agent_phone_numbers")
}

model VoiceKnowledgeBase {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  status      String   @default("active")
  /// Telnyx Cloud Storage bucket used for RAG embeddings (bucket_ids on retrieval tool).
  telnyxBucketName String?
  telnyxEmbeddingStatus String?
  telnyxEmbeddingTaskId String?
  lastEmbeddedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sources     VoiceKnowledgeSource[]
  agentLinks  VoiceAgentKnowledgeBase[]

  @@index([workspaceId])
  @@map("voice_knowledge_bases")
}

model VoiceKnowledgeSource {
  id              String   @id @default(cuid())
  workspaceId     String
  knowledgeBaseId String
  sourceType      String
  name            String
  status          String   @default("pending")
  contentText     String?
  fileUrl         String?
  fileMeta        Json?
  crawlUrl        String?
  extractedPreview String?
  chunkCount      Int      @default(0)
  /// Object key inside the Telnyx storage bucket (for file/text uploads).
  telnyxObjectKey String?
  lastSyncedAt    DateTime?
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  knowledgeBase   VoiceKnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([knowledgeBaseId])
  @@index([workspaceId])
  @@map("voice_knowledge_sources")
}

model VoiceAgentKnowledgeBase {
  id              String @id @default(cuid())
  workspaceId     String
  agentId         String
  knowledgeBaseId String
  agent           VoiceAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  knowledgeBase   VoiceKnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([agentId, knowledgeBaseId])
  @@map("voice_agent_knowledge_bases")
}

model VoiceTool {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  toolType    String
  config      Json
  inputSchema Json?
  outputSchema Json?
  secretRef   String?
  timeoutMs   Int      @default(30000)
  retryPolicy Json?
  isAsync     Boolean  @default(false)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentLinks  VoiceAgentTool[]
  executions  VoiceToolExecution[]

  @@index([workspaceId])
  @@map("voice_tools")
}

model VoiceAgentTool {
  id          String @id @default(cuid())
  workspaceId String
  agentId     String
  toolId      String
  agent       VoiceAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool        VoiceTool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([agentId, toolId])
  @@map("voice_agent_tools")
}

model VoiceCalendarConnection {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  provider    String
  status      String   @default("connected")
  config      Json?
  credentialsRef String?
  lastSyncAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  services    VoiceService[]
  staff       VoiceStaffMember[]

  @@index([workspaceId])
  @@map("voice_calendar_connections")
}

model VoiceService {
  id              String   @id @default(cuid())
  workspaceId     String
  calendarId      String?
  name            String
  durationMinutes Int      @default(30)
  bufferMinutes   Int      @default(0)
  config          Json?
  calendar        VoiceCalendarConnection? @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("voice_services")
}

model VoiceStaffMember {
  id          String   @id @default(cuid())
  workspaceId String
  calendarId  String?
  name        String
  email       String?
  timezone    String?
  config      Json?
  calendar    VoiceCalendarConnection? @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("voice_staff_members")
}

model VoiceRoutingRule {
  id          String   @id @default(cuid())
  workspaceId String
  agentId     String?
  name        String
  priority    Int      @default(0)
  isActive    Boolean  @default(true)
  conditions  Json
  actions     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agent       VoiceAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, priority])
  @@map("voice_routing_rules")
}

model VoiceCampaign {
  id              String              @id @default(cuid())
  workspaceId     String
  agentId         String
  name            String
  status          VoiceCampaignStatus @default(DRAFT)
  callerIdNumberId String?
  audienceType    String              @default("list")
  audienceConfig  Json?
  scheduleConfig  Json?
  callingRules    Json?
  voicemailRules  Json?
  followUpActions Json?
  concurrency     Int                 @default(1)
  dailyLimit      Int?
  maxAttempts     Int                 @default(3)
  timezone        String?
  totalContacts   Int                 @default(0)
  completedCount  Int                 @default(0)
  qualifiedCount  Int                 @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
