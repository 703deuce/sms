  campaignContact   VoiceCampaignContact @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([workspaceId])
  @@map("voice_campaign_attempts")
}

model VoiceCall {
  id                String            @id @default(cuid())
  workspaceId       String
  agentId           String?
  agentVersionId    String?
  contactId         String?
  campaignId        String?
  direction         VoiceCallDirection
  status            VoiceCallStatus   @default(QUEUED)
  outcome           String?
  fromE164          String
  toE164            String
  phoneNumberId     String?
  isTest            Boolean           @default(false)
  leadScore         Int?
  appointmentBooked Boolean           @default(false)
  transferred       Boolean           @default(false)
  voicemailDetected Boolean           @default(false)
  durationSeconds   Int?
  costCents         Int               @default(0)
  providerCostCents Int               @default(0)
  aiMinutes         Float             @default(0)
  telnyxCallControlId String?
  telnyxConversationId String?
  telnyxCallSessionId String?
  dynamicVariables  Json?
  metadata          Json?
  errorMessage      String?
  startedAt         DateTime          @default(now())
  answeredAt        DateTime?
  endedAt           DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  agent             VoiceAgent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentVersion      VoiceAgentVersion? @relation(fields: [agentVersionId], references: [id], onDelete: SetNull)
  campaign          VoiceCampaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  legs              VoiceCallLeg[]
  events            VoiceCallEvent[]
  transfers         VoiceTransfer[]
  recordings        VoiceRecording[]
  transcripts       VoiceTranscript[]
  insights          VoiceConversationInsight[]
  toolExecutions    VoiceToolExecution[]
  appointments      VoiceAppointment[]

  @@index([workspaceId, startedAt])
  @@index([workspaceId, status])
  @@index([telnyxCallControlId])
  @@index([agentId])
  @@map("voice_calls")
}

model VoiceCallLeg {
  id          String   @id @default(cuid())
  workspaceId String
  callId      String
