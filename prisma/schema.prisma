generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  /// Supabase Connect → Session pooler URI (port 5432). Required for `npm run db:push`.
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMINISTRATOR
  MANAGER
  CAMPAIGN_CREATOR
  INBOX_AGENT
  ANALYST
  READ_ONLY
}

enum ContactStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BLOCKED
  INVALID
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  FAILED
  PAUSED
  CANCELED
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
  SNOOZED
  SPAM
}

enum FlowStatus {
  ACTIVE
  DRAFT
  PAUSED
  ERROR
  ARCHIVED
}

enum ComplianceStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum MessagingStepStatus {
  not_started
  action_required
  submitted
  in_review
  approved
  failed
  suspended
  ready
}

enum RecipientWorkflowStatus {
  pending
  scheduled
  in_progress
  waiting
  completed
  stopped
  failed
  opted_out
}

enum JobQueueStatus {
  pending
  processing
  completed
  failed
  deferred
}

enum PaymentLinkStatus {
  pending
  paid
  expired
  canceled
}

model User {
  id                  String       @id @default(cuid())
  email               String       @unique
  name                String
  passwordHash        String?
  phone               String?
  phoneVerifiedAt     DateTime?
  isPlatformAdmin     Boolean      @default(false)
  totpSecretEnc       String?
  totpEnabled         Boolean      @default(false)
  totpBackupCodes     String[]     @default([])
  deletionRequestedAt DateTime?
  createdAt           DateTime     @default(now())
  memberships         Membership[]
  assignedConversations Conversation[] @relation("Assignee")
  auditLogs           AuditLog[]
  phoneAssignments    PhoneNumberAssignment[]
  inAppNotifications  InAppNotification[]
  invitesSent         WorkspaceInvite[] @relation("InviteSender")

  @@index([phone])
}

model Workspace {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  displayName          String?
  logoUrl              String?
  primaryColor         String?  @default("#0f766e")
  accentColor          String?  @default("#0ea5e9")
  shortLinkDomain      String?
  formTheme            String?  @default("light")
  reviewLinkUrl        String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  billingPlan          String?  @default("growth")
  creditBalanceCents   Int      @default(0)
  customFieldsConfig   Json?
  activeFromNumberId   String?
  createdAt            DateTime @default(now())
  memberships Membership[]
  phoneNumbers PhoneNumber[]
  contacts    Contact[]
  lists       ContactList[]
  segments    Segment[]
  tags        Tag[]
  campaigns   Campaign[]
  conversations Conversation[]
  templates   Template[]
  flows       AutomationFlow[]
  keywords    Keyword[]
  forms       OptInForm[]
  consentRecords ConsentRecord[]
  qrCodes     QrCode[]
  clickToTextLinks ClickToTextLink[]
  brand       ComplianceBrand?
  complianceCampaign ComplianceCampaign?
  messagingRegistration MessagingRegistration?
  messagingRegistrationEvents MessagingRegistrationEvent[]
  campaignRecipients CampaignRecipient[]
  campaignMessages CampaignMessage[]
  suppressions Suppression[]
  jobQueue    JobQueue[]
  integrationWebhooks IntegrationWebhookEndpoint[]
  integrationWebhookEvents IntegrationWebhookEvent[]
  apiKeys     ApiKey[]
  webhooks    Webhook[]
  auditLogs   AuditLog[]
  usageRecords UsageRecord[]
  automationExecutions AutomationExecution[]
  formSubmissions FormSubmission[]
  voiceAgents VoiceAgent[]
  voiceAgentVersions VoiceAgentVersion[]
  voiceAgentPhoneNumbers VoiceAgentPhoneNumber[]
  voiceKnowledgeBases VoiceKnowledgeBase[]
  voiceKnowledgeSources VoiceKnowledgeSource[]
  voiceAgentKnowledgeBases VoiceAgentKnowledgeBase[]
  voiceTools VoiceTool[]
  voiceAgentTools VoiceAgentTool[]
  voiceCalendarConnections VoiceCalendarConnection[]
  voiceServices VoiceService[]
  voiceStaffMembers VoiceStaffMember[]
  voiceRoutingRules VoiceRoutingRule[]
  voiceCampaigns VoiceCampaign[]
  voiceCampaignContacts VoiceCampaignContact[]
  voiceCampaignAttempts VoiceCampaignAttempt[]
  voiceCalls VoiceCall[]
  voiceCallLegs VoiceCallLeg[]
  voiceCallEvents VoiceCallEvent[]
  voiceTransfers VoiceTransfer[]
  voiceRecordings VoiceRecording[]
  voiceTranscripts VoiceTranscript[]
  voiceTranscriptSegments VoiceTranscriptSegment[]
  voiceConversationInsights VoiceConversationInsight[]
  voiceToolExecutions VoiceToolExecution[]
  voiceAppointments VoiceAppointment[]
  voiceTestRuns VoiceTestRun[]
  voiceComplianceProfile VoiceComplianceProfile?
  voiceUsageRecords VoiceUsageRecord[]
  voiceIntegrationSecrets VoiceIntegrationSecret[]
  providerWebhookEvents ProviderWebhookEvent[]
  linkClickEvents LinkClickEvent[]
  mediaAssets MediaAsset[]
  surveys Survey[]
  surveyResponses SurveyResponse[]
  growWidgets GrowWidget[]
  contactCardProfile ContactCardProfile?
  messagingSettings WorkspaceMessagingSettings?
  emailToSmsAddresses EmailToSmsAddress[]
  paymentLinks PaymentLink[]
  portRequests PortRequest[]
  humanCalls HumanCall[]
  humanCallEvents HumanCallEvent[]
  pushSubscriptions PushSubscription[]
  notificationPrefs WorkspaceNotificationPrefs[]
  workspaceLimits WorkspaceLimits?
  workspaceDataPrefs WorkspaceDataPrefs?
  workspacePhoneSettings WorkspacePhoneSettings?
  creditLedgerEntries CreditLedgerEntry[]
  senderPools SenderPool[]
  invites WorkspaceInvite[]
  inAppNotifications InAppNotification[]
  contests Contest[]
  integrationConnections IntegrationConnection[]
  callQueues CallQueue[]
  ivrMenus IvrMenu[]
  callParkSlots CallParkSlot[]
  conferenceCalls ConferenceCall[]
  conferenceParticipants ConferenceParticipant[]
  voicemailBoxes VoicemailBox[]
  voicemailMessages VoicemailMessage[]
  callForwardingRules CallForwardingRule[]
  softphonePresence SoftphonePresence[]
  softphoneDevices SoftphoneDevice[]
  softphoneUserSettings SoftphoneUserSettings[]
  crmObjectMappings CrmObjectMapping[]
  crmFieldMappings CrmFieldMapping[]
  crmSyncRuns CrmSyncRun[]
  crmSyncEvents CrmSyncEvent[]
  crmAuditLogs CrmAuditLog[]
  crmWebhookEvents CrmWebhookEvent[]
  crmDeadLetters CrmDeadLetter[]
}

model SenderPool {
  id              String   @id @default(cuid())
  workspaceId     String
  name            String
  description     String?
  phoneNumberIds  String[] @default([])
  status          String   @default("Active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("sender_pools")
}

model Membership {
  id          String    @id @default(cuid())
  role        Role      @default(INBOX_AGENT)
  userId      String
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model PhoneNumber {
  id               String   @id @default(cuid())
  workspaceId      String
  e164             String
  type             String
  areaCode         String?
  friendlyName     String?
  twilioSid        String?
  providerNumberId String?
  a2pStatus        ComplianceStatus @default(PENDING)
  messagingService String?
  monthlyCostCents Int      @default(115)
  status           String   @default("Active")
  purchasedAt      DateTime?
  releasedAt       DateTime?
  voiceForwardTo   String?
  webhookUrl       String?
  capabilitiesJson Json?
  settingsJson     Json?
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignments      PhoneNumberAssignment[]

  @@unique([workspaceId, e164])
  @@index([twilioSid])
}

model PhoneNumberAssignment {
  id            String   @id @default(cuid())
  phoneNumberId String
  userId        String
  createdAt     DateTime @default(now())
  phoneNumber   PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([phoneNumberId, userId])
  @@index([userId])
  @@map("phone_number_assignments")
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        Role      @default(INBOX_AGENT)
  tokenHash   String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User?     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@map("workspace_invites")
}

model InAppNotification {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  type        String
  title       String
  body        String?
  href        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([workspaceId, userId, readAt])
  @@map("in_app_notifications")
}

model Contest {
  id               String    @id @default(cuid())
  workspaceId      String
  name             String
  keywordId        String?
  keywordText      String
  startAt          DateTime?
  endAt            DateTime?
  maxEntries       Int?
  winnerCount      Int       @default(1)
  status           String    @default("draft")
  rulesText        String?
  prizeDescription String?
  winnerContactIds String[]  @default([])
  drawnAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries          ContestEntry[]

  @@index([workspaceId, status])
  @@map("contests")
}

model ContestEntry {
  id        String   @id @default(cuid())
  contestId String
  contactId String?
  phone     String
  createdAt DateTime @default(now())
  contest   Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([contestId, phone])
  @@index([contestId, createdAt])
  @@map("contest_entries")
}

model IntegrationConnection {
  id                   String    @id @default(cuid())
  workspaceId          String
  provider             String
  status               String    @default("disconnected")
  accessToken          String?
  refreshToken         String?
  expiresAt            DateTime?
  externalId           String?
  /// CRM-connected user (external) who authorized OAuth.
  connectedUserId      String?
  /// CRM org / company / account display name.
  connectedAccountName String?
  configJson           Json?
  lastSyncAt           DateTime?
  lastFailedSyncAt     DateTime?
  lastError            String?
  /// idle | syncing | healthy | degraded | error
  syncStatus           String    @default("idle")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([workspaceId])
  @@map("integration_connections")
}

model CallQueue {
  id              String   @id @default(cuid())
  workspaceId     String
  name            String
  strategy        String   @default("ring_all") // ring_all | round_robin | longest_idle | sequential
  timeoutSeconds  Int      @default(30)
  maxWaitSeconds  Int      @default(300)
  memberUserIds   String[] @default([])
  overflowAction  String   @default("voicemail") // voicemail | external | ai_agent | hangup | callback
  overflowTarget  String?
  holdMusicUrl    String?
  announcementUrl String?
  callbackEnabled Boolean  @default(false)
  active          Boolean  @default(true)
  configJson      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("call_queues")
}

model IvrMenu {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  greeting    String?
  optionsJson Json     @default("[]")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("ivr_menus")
}

model PlatformSettings {
  id        String   @id @default("default")
  plansJson Json     @default("[]")
  flagsJson Json     @default("{}")
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model PortRequest {
  id             String   @id @default(cuid())
  workspaceId    String
  phone          String
  currentCarrier String?
  accountNumber  String?
  accountPin     String?
  billingPhone   String?
  businessName   String?
  address        String?
  /// pending | docs_needed | submitted | in_progress | foc_confirmed | completed | rejected | cancelled
  status         String   @default("pending")
  authorizedName String?
  numberType     String?
  notes          String?
  rejectionReason String?
  /// Estimated FOC / cutover date when known (never a fake promise).
  focDate        DateTime?
  temporaryForwardNumber String?
  providerPortId String?
  requestedByUserId String?
  /// Timeline of status changes for the porting center.
  statusHistoryJson Json     @default("[]")
  /// Checklist / docs required and uploaded metadata.
  documentsJson  Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model Contact {
  id            String        @id @default(cuid())
  workspaceId   String
  firstName     String?
  lastName      String?
  phone         String
  email         String?
  status        ContactStatus @default(SUBSCRIBED)
  consentSource String?
  consentDate   DateTime?
  lastMessaged  DateTime?
  lastReply     DateTime?
  assignedUser  String?
  company       String?
  /// IANA timezone for campaign calling windows (e.g. America/Chicago).
  timezone      String?
  customFields  Json?
  createdAt     DateTime      @default(now())
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  listMembers   ContactListMember[]
  tagMembers    ContactTag[]
  consentRecords ConsentRecord[]
  conversations Conversation[]
  automationExecutions AutomationExecution[]
  formSubmissions FormSubmission[]

  @@unique([workspaceId, phone])
}

model ContactList {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     ContactListMember[]
}

model ContactListMember {
  id       String @id @default(cuid())
  listId   String
  contactId String
  list     ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact  Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([listId, contactId])
}

model Segment {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  conditions  Json
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Tag {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts    ContactTag[]

  @@unique([workspaceId, name])
}

model ContactTag {
  id        String @id @default(cuid())
  tagId     String
  contactId String
  tag       Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([tagId, contactId])
}

model Campaign {
  id             String         @id @default(cuid())
  workspaceId    String
  name           String
  type           String
  /// One of the ~14 Transovo campaign categories (broadcast, follow_up, …)
  category       String?
  audience       String
  body           String
  status         CampaignStatus @default(DRAFT)
  scheduledAt    DateTime?
  sequenceJson   Json?
  /// Category-specific builder options (trigger, delays, stop rules, …)
  configJson     Json?
  senderPoolId   String?
  successMode    String         @default("click")
  dailySendLimit Int?
  sendWindowStart Int?
  sendWindowEnd   Int?
  sent           Int            @default(0)
  delivered      Int            @default(0)
  replies        Int            @default(0)
  clicks         Int            @default(0)
  optOuts        Int            @default(0)
  costCents      Int            @default(0)
  createdBy      String?
  createdAt      DateTime       @default(now())
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages       Message[]
  recipients     CampaignRecipient[]
  campaignMessages CampaignMessage[]

  @@index([workspaceId, category])
}

model Message {
  id            String   @id @default(cuid())
  campaignId    String?
  workspaceId   String?
  to            String
  from          String
  body          String
  status        String
  segments      Int      @default(1)
  costCents     Int      @default(0)
  providerId    String?
  idempotencyKey String?
  trackingToken String?  @unique
  destinationUrl String?
  createdAt     DateTime @default(now())
  campaign      Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, idempotencyKey])
  @@index([trackingToken])
  @@index([providerId])
}

/// Per-workspace Twilio ISV registration state (one row per workspace).
model MessagingRegistration {
  id                        String              @id @default(cuid())
  workspaceId               String              @unique
  overallStatus             MessagingStepStatus @default(not_started)
  messagingEnabled          Boolean             @default(false)
  paused                    Boolean             @default(false)

  // Twilio subaccount (retained for rollback / audit)
  subaccountSid             String?
  subaccountAuthTokenEnc    String?

  // TrustHub / A2P SIDs (Twilio — retained temporarily)
  secondaryProfileSid       String?
  trustProductSid           String?
  brandSid                  String?
  messagingServiceSid       String?
  a2pCampaignSid            String?

  // Provider-neutral messaging fields (Telnyx-first)
  messagingProvider         String?   // mock | twilio | telnyx
  messagingProfileId        String?
  phoneNumberId             String?
  brandId                   String?
  campaignId                String?
  brandStatusRaw            String?
  campaignStatusRaw         String?
  messagingActivationStatus String?   // draft | … | approved | rejected | suspended
  registrationSubmittedAt   DateTime?
  registrationApprovedAt    DateTime?
  registrationFailureReason String?

  // Phone
  phoneE164                 String?
  phoneSid                  String?
  phoneAttached             Boolean             @default(false)
  phonePurchasedAt          DateTime?

  // Step statuses
  profileStatus             MessagingStepStatus @default(not_started)
  trustStatus               MessagingStepStatus @default(not_started)
  brandStatus               MessagingStepStatus @default(not_started)
  messagingServiceStatus    MessagingStepStatus @default(not_started)
  campaignStatus            MessagingStepStatus @default(not_started)
  numberStatus              MessagingStepStatus @default(not_started)

  // Business details (TrustHub)
  legalBusinessName         String?
  dbaName                   String?
  businessType              String?
  businessIndustry          String?
  businessIdentity          String?
  businessRegistrationId    String? // EIN / tax id
  websiteUrl                String?
  street                    String?
  city                      String?
  region                    String?
  postalCode                String?
  country                   String?             @default("US")
  contactFirstName          String?
  contactLastName           String?
  contactEmail              String?
  contactPhone              String?
  contactTitle              String?

  // Use case / campaign
  useCase                   String?
  useCaseDescription        String?
  sampleMessages            String[]            @default([])
  optInDescription          String?
  helpMessage               String?
  stopMessage               String?
  messageVolume             String?
  vertical                  String?
  privacyPolicyUrl          String?
  optInKeywords             String?
  optOutKeywords            String?
  helpKeywords              String?
  optInFormUrl              String?
  campaignDisplayName       String?
  subscriberOptIn           Boolean             @default(true)
  subscriberOptOut          Boolean             @default(true)
  embeddedLinks             Boolean             @default(true)
  embeddedPhone             Boolean             @default(false)
  ageGated                  Boolean             @default(false)
  directLending             Boolean             @default(false)
  affiliateMarketing        Boolean             @default(false)
  numberPoolSize            Int                 @default(1)

  certifiedAt               DateTime?
  lastError                 String?
  lastAdvancedAt            DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  workspace                 Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events                    MessagingRegistrationEvent[]

  @@index([overallStatus])
  @@map("messaging_registrations")
}

model MessagingRegistrationEvent {
  id             String   @id @default(cuid())
  workspaceId    String
  registrationId String
  eventType      String
  message        String?
  payload        Json?
  createdAt      DateTime @default(now())

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  registration   MessagingRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId, createdAt])
  @@map("messaging_registration_events")
}

model CampaignRecipient {
  id             String                  @id @default(cuid())
  workspaceId    String
  campaignId     String
  contactId      String?
  phone          String?
  email          String?
  displayName    String?
  /// Active-enrollment identity (`p:+1…` / `e:a@b.c`); null when terminal so re-enroll works.
  enrollmentKey  String?                 @unique
  workflowStatus RecipientWorkflowStatus @default(pending)
  currentStep    String?
  nextActionAt   DateTime?
  enrolledAt     DateTime                @default(now())
  completedAt    DateTime?
  stopReason     String?
  metadata       Json?
  updatedAt      DateTime                @updatedAt

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  messages       CampaignMessage[]

  @@index([campaignId, workflowStatus, nextActionAt])
  @@index([workspaceId, phone])
  @@map("campaign_recipients")
}

model CampaignMessage {
  id              String    @id @default(cuid())
  workspaceId     String
  campaignId      String
  recipientId     String
  channel         String    @default("sms")
  stepKey         String?
  to              String
  body            String
  status          String    @default("queued")
  scheduledFor    DateTime?
  sentAt          DateTime?
  providerId      String?
  trackingToken   String?   @unique
  destinationUrl  String?
  error           String?
  deliveredCounted Boolean  @default(false)
  clickedCounted  Boolean   @default(false)
  sentCounted     Boolean   @default(false)
  advancedAfterSend Boolean @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient       CampaignRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([campaignId, status])
  @@unique([recipientId, stepKey])
  @@map("campaign_messages")
}

model Suppression {
  id             String   @id @default(cuid())
  workspaceId    String
  phone          String?
  email          String?
  /// Normalized identity `p:+E164` or `e:email@x` for idempotent STOP inserts.
  suppressionKey String   @unique
  reason         String
  source         String?
  createdAt      DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, phone])
  @@index([workspaceId, email])
  @@map("review_request_suppression")
}

model JobQueue {
  id           String         @id @default(cuid())
  workspaceId  String?
  jobType      String
  queueName    String         @default("default")
  payload      Json
  status       JobQueueStatus @default(pending)
  idempotencyKey String?      @unique
  attempts     Int            @default(0)
  maxAttempts  Int            @default(8)
  /// Lower number = higher priority (CRM high=10, medium=50, low=90).
  priority     Int            @default(50)
  runAfter     DateTime       @default(now())
  lockedAt     DateTime?
  lastError    String?
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  workspace    Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([status, priority, runAfter, queueName])
  @@index([jobType, status])
  @@map("job_queue")
}

/// Inbound automation webhooks (Zapier/Make/n8n) — not outbound Webhook destinations.
model IntegrationWebhookEndpoint {
  id                String   @id @default(cuid())
  workspaceId       String
  name              String
  token             String   @unique
  campaignId        String?
  sendDelayMinutes  Int      @default(0)
  fieldMap          Json?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  rotatedAt         DateTime?
  revokedAt         DateTime?

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events            IntegrationWebhookEvent[]

  @@index([workspaceId, active])
  @@map("integration_webhook_endpoints")
}

model IntegrationWebhookEvent {
  id          String   @id @default(cuid())
  workspaceId String
  endpointId  String
  idempotencyKey String?
  payload     Json
  status      String   @default("received")
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  processedAt DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  endpoint    IntegrationWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, idempotencyKey])
  @@index([workspaceId, createdAt])
  @@map("integration_webhook_events")
}

model Conversation {
