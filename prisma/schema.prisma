  objectType    String? // optional primary object focus
  startedAt     DateTime?
  finishedAt    DateTime?
  durationMs    Int?
  attempts      Int      @default(0)
  statsJson     Json?
  lastError     String?
  cursorJson    Json?
  triggeredBy   String? // userId | system | webhook
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
