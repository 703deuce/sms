generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMINISTRATOR
  MANAGER
  CAMPAIGN_CREATOR
  INBOX_AGENT
  ANALYST
  READ_ONLY
}

enum ContactStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BLOCKED
  INVALID
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  FAILED
  PAUSED
  CANCELED
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
  SNOOZED
  SPAM
}

enum FlowStatus {
  ACTIVE
  DRAFT
  PAUSED
  ERROR
  ARCHIVED
}

enum ComplianceStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum MessagingStepStatus {
  not_started
  action_required
  submitted
  in_review
  approved
  failed
  suspended
  ready
}

enum RecipientWorkflowStatus {
  pending
  scheduled
  in_progress
  waiting
  completed
  stopped
  failed
  opted_out
}

enum JobQueueStatus {
  pending
  processing
  completed
  failed
  deferred
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String?
  isPlatformAdmin Boolean   @default(false)
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  assignedConversations Conversation[] @relation("Assignee")
  auditLogs    AuditLog[]
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now())
  memberships Membership[]
  phoneNumbers PhoneNumber[]
  contacts    Contact[]
  lists       ContactList[]
  segments    Segment[]
  tags        Tag[]
  campaigns   Campaign[]
  conversations Conversation[]
  templates   Template[]
  flows       AutomationFlow[]
  keywords    Keyword[]
  forms       OptInForm[]
  consentRecords ConsentRecord[]
  qrCodes     QrCode[]
  clickToTextLinks ClickToTextLink[]
  brand       ComplianceBrand?
  complianceCampaign ComplianceCampaign?
  messagingRegistration MessagingRegistration?
  messagingRegistrationEvents MessagingRegistrationEvent[]
  campaignRecipients CampaignRecipient[]
  campaignMessages CampaignMessage[]
  suppressions Suppression[]
  jobQueue    JobQueue[]
  integrationWebhooks IntegrationWebhookEndpoint[]
  integrationWebhookEvents IntegrationWebhookEvent[]
  apiKeys     ApiKey[]
  webhooks    Webhook[]
  auditLogs   AuditLog[]
  usageRecords UsageRecord[]
}

model Membership {
  id          String    @id @default(cuid())
  role        Role      @default(INBOX_AGENT)
  userId      String
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model PhoneNumber {
  id               String   @id @default(cuid())
  workspaceId      String
  e164             String
  type             String
  areaCode         String?
  friendlyName     String?
  twilioSid        String?
  providerNumberId String?
  a2pStatus        ComplianceStatus @default(PENDING)
  messagingService String?
  monthlyCostCents Int      @default(115)
  status           String   @default("Active")
  purchasedAt      DateTime?
  releasedAt       DateTime?
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, e164])
  @@index([twilioSid])
}

model Contact {
  id            String        @id @default(cuid())
  workspaceId   String
  firstName     String?
  lastName      String?
  phone         String
  email         String?
  status        ContactStatus @default(SUBSCRIBED)
  consentSource String?
  consentDate   DateTime?
  lastMessaged  DateTime?
  lastReply     DateTime?
  assignedUser  String?
  company       String?
  customFields  Json?
  createdAt     DateTime      @default(now())
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  listMembers   ContactListMember[]
  tagMembers    ContactTag[]
  consentRecords ConsentRecord[]
  conversations Conversation[]

  @@unique([workspaceId, phone])
}

model ContactList {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     ContactListMember[]
}

model ContactListMember {
  id       String @id @default(cuid())
  listId   String
  contactId String
  list     ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact  Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([listId, contactId])
}

model Segment {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  conditions  Json
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Tag {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts    ContactTag[]

  @@unique([workspaceId, name])
}

model ContactTag {
  id        String @id @default(cuid())
  tagId     String
  contactId String
  tag       Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([tagId, contactId])
}

model Campaign {
  id             String         @id @default(cuid())
  workspaceId    String
  name           String
  type           String
  /// One of the ~14 Transovo campaign categories (broadcast, follow_up, …)
  category       String?
  audience       String
  body           String
  status         CampaignStatus @default(DRAFT)
  scheduledAt    DateTime?
  sequenceJson   Json?
  /// Category-specific builder options (trigger, delays, stop rules, …)
  configJson     Json?
  successMode    String         @default("click")
  dailySendLimit Int?
  sendWindowStart Int?
  sendWindowEnd   Int?
  sent           Int            @default(0)
  delivered      Int            @default(0)
  replies        Int            @default(0)
  clicks         Int            @default(0)
  optOuts        Int            @default(0)
  costCents      Int            @default(0)
  createdBy      String?
  createdAt      DateTime       @default(now())
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages       Message[]
  recipients     CampaignRecipient[]
  campaignMessages CampaignMessage[]

  @@index([workspaceId, category])
}

model Message {
  id            String   @id @default(cuid())
  campaignId    String?
  workspaceId   String?
  to            String
  from          String
  body          String
  status        String
  segments      Int      @default(1)
  costCents     Int      @default(0)
  providerId    String?
  idempotencyKey String?
  trackingToken String?  @unique
  destinationUrl String?
  createdAt     DateTime @default(now())
  campaign      Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, idempotencyKey])
  @@index([trackingToken])
  @@index([providerId])
}

/// Per-workspace Twilio ISV registration state (one row per workspace).
model MessagingRegistration {
  id                        String              @id @default(cuid())
  workspaceId               String              @unique
  overallStatus             MessagingStepStatus @default(not_started)
  messagingEnabled          Boolean             @default(false)
  paused                    Boolean             @default(false)

  // Twilio subaccount (retained for rollback / audit)
  subaccountSid             String?
  subaccountAuthTokenEnc    String?

  // TrustHub / A2P SIDs (Twilio — retained temporarily)
  secondaryProfileSid       String?
  trustProductSid           String?
  brandSid                  String?
  messagingServiceSid       String?
  a2pCampaignSid            String?

  // Provider-neutral messaging fields (Telnyx-first)
  messagingProvider         String?   // mock | twilio | telnyx
  messagingProfileId        String?
  phoneNumberId             String?
  brandId                   String?
  campaignId                String?
  brandStatusRaw            String?
  campaignStatusRaw         String?
  messagingActivationStatus String?   // draft | … | approved | rejected | suspended
  registrationSubmittedAt   DateTime?
  registrationApprovedAt    DateTime?
  registrationFailureReason String?

  // Phone
  phoneE164                 String?
  phoneSid                  String?
  phoneAttached             Boolean             @default(false)
  phonePurchasedAt          DateTime?

  // Step statuses
  profileStatus             MessagingStepStatus @default(not_started)
  trustStatus               MessagingStepStatus @default(not_started)
  brandStatus               MessagingStepStatus @default(not_started)
  messagingServiceStatus    MessagingStepStatus @default(not_started)
  campaignStatus            MessagingStepStatus @default(not_started)
  numberStatus              MessagingStepStatus @default(not_started)

  // Business details (TrustHub)
  legalBusinessName         String?
  dbaName                   String?
  businessType              String?
  businessIndustry          String?
  businessIdentity          String?
  businessRegistrationId    String? // EIN / tax id
  websiteUrl                String?
  street                    String?
  city                      String?
  region                    String?
  postalCode                String?
  country                   String?             @default("US")
  contactFirstName          String?
  contactLastName           String?
  contactEmail              String?
  contactPhone              String?
  contactTitle              String?

  // Use case / campaign
  useCase                   String?
  useCaseDescription        String?
  sampleMessages            String[]            @default([])
  optInDescription          String?
  helpMessage               String?
  stopMessage               String?
  messageVolume             String?
  vertical                  String?

  certifiedAt               DateTime?
  lastError                 String?
  lastAdvancedAt            DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  workspace                 Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events                    MessagingRegistrationEvent[]

  @@index([overallStatus])
  @@map("messaging_registrations")
}

model MessagingRegistrationEvent {
  id             String   @id @default(cuid())
  workspaceId    String
  registrationId String
  eventType      String
  message        String?
  payload        Json?
  createdAt      DateTime @default(now())

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  registration   MessagingRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId, createdAt])
  @@map("messaging_registration_events")
}

model CampaignRecipient {
  id             String                  @id @default(cuid())
  workspaceId    String
  campaignId     String
  contactId      String?
  phone          String?
  email          String?
  displayName    String?
  /// Active-enrollment identity (`p:+1…` / `e:a@b.c`); null when terminal so re-enroll works.
  enrollmentKey  String?                 @unique
  workflowStatus RecipientWorkflowStatus @default(pending)
  currentStep    String?
  nextActionAt   DateTime?
  enrolledAt     DateTime                @default(now())
  completedAt    DateTime?
  stopReason     String?
  metadata       Json?
  updatedAt      DateTime                @updatedAt

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  messages       CampaignMessage[]

  @@index([campaignId, workflowStatus, nextActionAt])
  @@index([workspaceId, phone])
  @@map("campaign_recipients")
}

model CampaignMessage {
  id              String    @id @default(cuid())
  workspaceId     String
  campaignId      String
  recipientId     String
  channel         String    @default("sms")
  stepKey         String?
  to              String
  body            String
  status          String    @default("queued")
  scheduledFor    DateTime?
  sentAt          DateTime?
  providerId      String?
  trackingToken   String?   @unique
  destinationUrl  String?
  error           String?
  deliveredCounted Boolean  @default(false)
  clickedCounted  Boolean   @default(false)
  sentCounted     Boolean   @default(false)
  advancedAfterSend Boolean @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient       CampaignRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([campaignId, status])
  @@unique([recipientId, stepKey])
  @@map("campaign_messages")
}

model Suppression {
  id             String   @id @default(cuid())
  workspaceId    String
  phone          String?
  email          String?
  /// Normalized identity `p:+E164` or `e:email@x` for idempotent STOP inserts.
  suppressionKey String   @unique
  reason         String
  source         String?
  createdAt      DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, phone])
  @@index([workspaceId, email])
  @@map("review_request_suppression")
}

model JobQueue {
  id           String         @id @default(cuid())
  workspaceId  String?
  jobType      String
  queueName    String         @default("default")
  payload      Json
  status       JobQueueStatus @default(pending)
  idempotencyKey String?      @unique
  attempts     Int            @default(0)
  maxAttempts  Int            @default(8)
  runAfter     DateTime       @default(now())
  lockedAt     DateTime?
  lastError    String?
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  workspace    Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([status, runAfter, queueName])
  @@index([jobType, status])
  @@map("job_queue")
}

/// Inbound automation webhooks (Zapier/Make/n8n) — not outbound Webhook destinations.
model IntegrationWebhookEndpoint {
  id                String   @id @default(cuid())
  workspaceId       String
  name              String
  token             String   @unique
  campaignId        String?
  sendDelayMinutes  Int      @default(0)
  fieldMap          Json?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  rotatedAt         DateTime?
  revokedAt         DateTime?

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events            IntegrationWebhookEvent[]

  @@index([workspaceId, active])
  @@map("integration_webhook_endpoints")
}

model IntegrationWebhookEvent {
  id          String   @id @default(cuid())
  workspaceId String
  endpointId  String
  idempotencyKey String?
  payload     Json
  status      String   @default("received")
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  processedAt DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  endpoint    IntegrationWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, idempotencyKey])
  @@index([workspaceId, createdAt])
  @@map("integration_webhook_events")
}

model Conversation {
  id          String             @id @default(cuid())
  workspaceId String
  contactId   String
  assigneeId  String?
  status      ConversationStatus @default(OPEN)
  tags        String[]
  unread      Boolean            @default(true)
  updatedAt   DateTime           @updatedAt
  createdAt   DateTime           @default(now())
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee    User?              @relation("Assignee", fields: [assigneeId], references: [id])
  messages    ConversationMessage[]
}

model ConversationMessage {
  id                String   @id @default(cuid())
  conversationId    String
  direction         String
  body              String
  userName          String?
  providerMessageId String?  @unique
  createdAt         DateTime @default(now())
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([providerMessageId])
}

model Template {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  category    String
  type        String
  channel     String  @default("SMS")
  body        String
  shared      Boolean @default(true)
  tags        String[]
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AutomationFlow {
  id             String     @id @default(cuid())
  workspaceId    String
  name           String
  trigger        String
  definition     Json
  enrolled       Int        @default(0)
  messagesSent   Int        @default(0)
  completionRate Float      @default(0)
  status         FlowStatus @default(DRAFT)
  updatedAt      DateTime   @updatedAt
  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Keyword {
  id            String  @id @default(cuid())
  workspaceId   String
  keyword       String
  phoneNumber   String
  listName      String
  confirmation  String
  status        String  @default("Active")
  subscribers   Int     @default(0)
  /// Optional tags to apply on join (JSON string array)
  tagsJson      Json?
  /// Optional campaign/workflow to start on keyword
  startCampaignId String?
  autoReply     String?
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, keyword, phoneNumber])
}

model OptInForm {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  listName    String
  slug        String?
  url         String?
  status      String @default("Active")
  submissions Int    @default(0)
  config      Json?
  disclosureText String?
  disclosureVersion String? @default("v1")
  thankYouMessage String?
  doubleOptIn Boolean @default(false)
  startCampaignId String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, slug])
}

model ConsentRecord {
  id               String   @id @default(cuid())
  workspaceId      String
  contactId        String?
  phone            String
  consentDate      DateTime
  source           String
  disclosureVersion String?
  disclosureText   String?
  ipAddress        String?
  userAgent        String?
  formUrl          String?
  doubleOptInStatus String?
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact          Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([workspaceId, phone])
}

/// QR codes for signup forms, click-to-text, review/booking/payment links.
model QrCode {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  targetType  String   // form | click_to_text | url | review | booking | payment
  targetUrl   String
  scans       Int      @default(0)
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// sms:+1…?body=JOIN style acquisition links.
model ClickToTextLink {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  phoneE164   String
  body        String
  href        String
  clicks      Int      @default(0)
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model ComplianceBrand {
  id          String           @id @default(cuid())
  workspaceId String           @unique
  legalName   String?
  dba         String?
  ein         String?
  entityType  String?
  industry    String?
  website     String?
  status      ComplianceStatus @default(DRAFT)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ComplianceCampaign {
  id          String           @id @default(cuid())
  workspaceId String           @unique
  useCase     String?
  description String?
  optInMethod String?
  status      ComplianceStatus @default(DRAFT)
  samples     String[]
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  prefix      String
  hashedKey   String
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Webhook {
  id          String   @id @default(cuid())
  workspaceId String
  url         String
  events      String[]
  active      Boolean  @default(true)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  userId      String?
  event       String
  detail      String?
  createdAt   DateTime @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model UsageRecord {
  id          String   @id @default(cuid())
  workspaceId String
  periodStart DateTime
  periodEnd   DateTime
  smsSegments Int      @default(0)
  mmsMessages Int      @default(0)
  inbound     Int      @default(0)
  outbound    Int      @default(0)
  costCents   Int      @default(0)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}
