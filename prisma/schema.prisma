model AutomationFlow {
  id                   String     @id @default(cuid())
  workspaceId          String
  name                 String
  description          String?
  trigger              String
  definition           Json
  publishedDefinition  Json?
  version              Int        @default(0)
  enrolled             Int        @default(0)
  messagesSent         Int        @default(0)
  completionRate       Float      @default(0)
  status               FlowStatus @default(DRAFT)
  sourceSolutionSetupId String?
  /// VoiceAgent that owns this workflow (agent_workflow). Null for standalone automations.
  ownerAgentId         String?
  /// agent_workflow | standalone
  ownershipKind        String     @default("standalone")
  /// Customer-facing owner label, e.g. "Missed Call Text-Back Agent"
  ownerLabel           String?
  linkedAgentIds       String[]   @default([])
  linkedCampaignIds    String[]   @default([])
  linkedPhoneNumberIds String[]   @default([])
  linkedCalendarIds    String[]   @default([])
  linkedTemplateIds    String[]   @default([])
  /// True when the visual builder made structural changes the wizard cannot safely represent.
  advancedCustomized   Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  publishedAt          DateTime?
  workspace            Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceSolutionSetup  SolutionSetup? @relation(fields: [sourceSolutionSetupId], references: [id], onDelete: SetNull)
  ownerAgent           VoiceAgent? @relation("AgentPrimaryFlows", fields: [ownerAgentId], references: [id], onDelete: SetNull)
  executions           AutomationExecution[]
  triggerDeployments   TriggerDeployment[]

  @@index([workspaceId, sourceSolutionSetupId])
  @@index([workspaceId, ownerAgentId])
  @@index([workspaceId, ownershipKind])
}

/// Compiled from a workflow trigger node on Activate.
/// Source of truth for editing = trigger node on the canvas.
/// This record is what the backend audits, conflicts on, and My Numbers displays.
/// For inbound voice, activation also publishes direct Telnyx routing (not via the automation worker audio path).
model TriggerDeployment {
  id                String   @id @default(cuid())
  workspaceId       String
  flowId            String
  triggerNodeId     String
  /// inbound_call | call_missed | incoming_sms | …
  triggerBlockType  String
  /// voice | sms | email | webhook | schedule | manual
  channel           String
  phoneNumberId     String?
  /// every_call | overflow | after_hours | unanswered | keyword | always
  eventType         String   @default("every_call")
  /// always | business_hours | custom
  scheduleKey       String   @default("always")
  /// draft | test | live | paused | error
  status            String   @default("draft")
  /// human | voicemail | backup_flow | reject
  pauseFallback     String   @default("human")
  pauseFallbackNumber String?
  pauseFallbackFlowId String?
  /// Provider payload snapshot (Telnyx connection/app ids, last error, etc.)
  providerConfig    Json?
  errorMessage      String?
  deployedAt        DateTime?
  pausedAt          DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  flow              AutomationFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  phoneNumber       PhoneNumber? @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)

  @@unique([flowId, triggerNodeId])
  @@index([workspaceId, phoneNumberId, status])
  @@index([workspaceId, status, eventType])
  @@map("trigger_deployments")
}

