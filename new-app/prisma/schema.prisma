  contact                            Contact                             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee                           User?                               @relation("Assignee", fields: [assigneeId], references: [id])
  messages                           ConversationMessage[]
  platformSenderAssignments          MctbPlatformSenderAssignment[]
  arSmsReplySessions                 ArSmsReplySession[]
  platformProductConsumerAssignments PlatformProductConsumerAssignment[]

  @@index([workspaceId, productSource, updatedAt])
  @@index([workspaceId, phoneNumberId, updatedAt])
  @@index([workspaceId, campaignId])
  @@index([workspaceId, contactId, productSource])
}

model ConversationMessage {
  id                String       @id @default(cuid())
  conversationId    String
  direction         String
  body              String
  mediaUrls         String[]     @default([])
  userName          String?
  providerMessageId String?      @unique
  fromE164          String?
  campaignMessageId String?
  createdAt         DateTime     @default(now())
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([providerMessageId])
  @@index([conversationId, createdAt])
}

model Template {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  category    String
  type        String
  channel     String    @default("SMS")
  body        String
  shared      Boolean   @default(true)
  tags        String[]
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Packaged solution instance created by a wizard (one customer-facing "system").
model SolutionSetup {
  id                   String           @id @default(cuid())
  workspaceId          String
  /// Outcome registry slug, e.g. missed-call-text-back
  solutionType         String
  name                 String
  status               String           @default("DRAFT")
  /// Simple wizard settings (synced into linked AutomationFlow nodes when possible)
  configJson           Json?
  linkedAgentIds       String[]         @default([])
  linkedAutomationIds  String[]         @default([])
  linkedCampaignIds    String[]         @default([])
  linkedPhoneNumberIds String[]         @default([])
  linkedCalendarIds    String[]         @default([])
  linkedRoutingRuleIds String[]         @default([])
  linkedTemplateIds    String[]         @default([])
  /// Primary generated AutomationFlow for this agent (wizard → workflow).
  primaryFlowId        String?
  /// Stable key for idempotent create-or-update per workspace+solution
  externalKey          String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  workspace            Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  flows                AutomationFlow[]
  agents               VoiceAgent[]

  @@unique([workspaceId, solutionType, externalKey])
  @@index([workspaceId, solutionType])
  @@index([workspaceId, status])
  @@index([workspaceId, primaryFlowId])
  @@map("solution_setups")
}

/// Cross-system activity events consumed by automations and reporting.
model PlatformEvent {
  id              String    @id @default(cuid())
  workspaceId     String
  type            String
  contactId       String?
  solutionSetupId String?
  automationId    String?
  agentId         String?
  campaignId      String?
  callId          String?
  messageId       String?
  payload         Json?
  idempotencyKey  String?
  createdAt       DateTime  @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, type, createdAt])
  @@index([workspaceId, contactId])
  @@map("platform_events")
}

model AutomationFlow {
  id                    String                @id @default(cuid())
  workspaceId           String
  name                  String
  description           String?
  trigger               String
  definition            Json
  publishedDefinition   Json?
  version               Int                   @default(0)
  enrolled              Int                   @default(0)
  messagesSent          Int                   @default(0)
  completionRate        Float                 @default(0)
  status                FlowStatus            @default(DRAFT)
  sourceSolutionSetupId String?
  /// VoiceAgent that owns this workflow (agent_workflow). Null for standalone automations.
  ownerAgentId          String?
  /// agent_workflow | standalone
  ownershipKind         String                @default("standalone")
  /// Customer-facing owner label, e.g. "Missed Call Text-Back Agent"
  ownerLabel            String?
  linkedAgentIds        String[]              @default([])
  linkedCampaignIds     String[]              @default([])
  linkedPhoneNumberIds  String[]              @default([])
  linkedCalendarIds     String[]              @default([])
  linkedTemplateIds     String[]              @default([])
  /// True when the visual builder made structural changes the wizard cannot safely represent.
  advancedCustomized    Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  publishedAt           DateTime?
  workspace             Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceSolutionSetup   SolutionSetup?        @relation(fields: [sourceSolutionSetupId], references: [id], onDelete: SetNull)
  ownerAgent            VoiceAgent?           @relation("AgentPrimaryFlows", fields: [ownerAgentId], references: [id], onDelete: SetNull)
  executions            AutomationExecution[]
  triggerDeployments    TriggerDeployment[]

  @@index([workspaceId, sourceSolutionSetupId])
  @@index([workspaceId, ownerAgentId])
  @@index([workspaceId, ownershipKind])
}

/// Compiled from a workflow trigger node on Activate.
/// Source of truth for editing = trigger node on the canvas.
/// This record is what the backend audits, conflicts on, and My Numbers displays.
/// For inbound voice, activation also publishes direct Telnyx routing (not via the automation worker audio path).
model TriggerDeployment {
  id                  String         @id @default(cuid())
  workspaceId         String
  flowId              String
  triggerNodeId       String
  /// inbound_call | call_missed | incoming_sms | …
  triggerBlockType    String
  /// voice | sms | email | webhook | schedule | manual
  channel             String
  phoneNumberId       String?
  /// every_call | overflow | after_hours | unanswered | keyword | always
  eventType           String         @default("every_call")
  /// always | business_hours | custom
  scheduleKey         String         @default("always")
  /// draft | test | live | paused | error
  status              String         @default("draft")
  /// human | voicemail | backup_flow | reject
  pauseFallback       String         @default("human")
  pauseFallbackNumber String?
  pauseFallbackFlowId String?
  /// Provider payload snapshot (Telnyx connection/app ids, last error, etc.)
  providerConfig      Json?
  errorMessage        String?
  deployedAt          DateTime?
  pausedAt            DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  workspace           Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  flow                AutomationFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  phoneNumber         PhoneNumber?   @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)

  @@unique([flowId, triggerNodeId])
  @@index([workspaceId, phoneNumberId, status])
  @@index([workspaceId, status, eventType])
  @@map("trigger_deployments")
}

enum AutomationExecutionStatus {
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
  PAUSED
}

model AutomationExecution {
  id            String                    @id @default(cuid())
  workspaceId   String
  flowId        String
  flowVersion   Int
  contactId     String
  enrollmentKey String                    @unique
  status        AutomationExecutionStatus @default(RUNNING)
  currentNodeId String?
  nextActionAt  DateTime?
  metadata      Json?
  startedAt     DateTime                  @default(now())
  completedAt   DateTime?
  failedAt      DateTime?
  error         String?
  flow          AutomationFlow            @relation(fields: [flowId], references: [id], onDelete: Cascade)
  contact       Contact                   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workspace     Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps         AutomationStepExecution[]

  @@index([workspaceId, flowId])
  @@index([status, nextActionAt])
}

model AutomationStepExecution {
  id           String              @id @default(cuid())
  executionId  String
  nodeId       String
  status       String              @default("pending")
  attemptCount Int                 @default(0)
  scheduledFor DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  branchTaken  String?
  output       Json?
  error        String?
  execution    AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, nodeId])
  @@index([executionId])
}

model Keyword {
  id              String    @id @default(cuid())
  workspaceId     String
  keyword         String
  phoneNumber     String
  listName        String
  confirmation    String
  status          String    @default("Active")
  subscribers     Int       @default(0)
