// Phone, receptionist, power-dialer, MCTB and SMS models below are legacy, unused by new-app
// (retained so production Postgres is not destructively migrated). Clips models are appended at EOF.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  /// Supabase Connect → Session pooler URI (port 5432). Required for `npm run db:push`.
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMINISTRATOR
  MANAGER
  CAMPAIGN_CREATOR
  INBOX_AGENT
  ANALYST
  READ_ONLY
}

enum ContactStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BLOCKED
  INVALID
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  FAILED
  PAUSED
  CANCELED
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
  SNOOZED
  SPAM
}

enum FlowStatus {
  ACTIVE
  DRAFT
  PAUSED
  ERROR
  ARCHIVED
}

enum ComplianceStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum MessagingStepStatus {
  not_started
  action_required
  submitted
  in_review
  approved
  failed
  suspended
  ready
}

enum RecipientWorkflowStatus {
  pending
  scheduled
  in_progress
  waiting
  completed
  stopped
  failed
  opted_out
}

enum JobQueueStatus {
  pending
  processing
  completed
  failed
  deferred
}

enum PaymentLinkStatus {
  pending
  paid
  expired
  canceled
}

enum PaymentRequestStatus {
  draft
  ready
  sent
  delivered
  opened
  paid
  failed
  expired
  cancelled
  refunded
  partially_refunded
}

enum PaymentRequestSourceType {
  standalone
  conversation
  mctb_conversation
  appointment
  other
}

enum PaymentRequestDeliveryStatus {
  not_sent
  queued
  sent
  delivered
  failed
}

enum WorkspaceType {
  PERSONAL
  BUSINESS
}

enum ProductKey {
  SMS
  NUMBERS
  VOICE
}

enum ProductAccessStatus {
  ACTIVE
  INACTIVE
  TRIAL
}

/// Transovo product features (MCTB, Smart Routing, add-ons) — workspace-scoped.
enum WorkspaceProductFeatureKey {
  MCTB
  MASS_TEXTING
  SMART_ROUTING
  CALL_FORWARDING
  VISUAL_VOICEMAIL
  CALLBACK_REQUESTS
  AI_TRANSCRIPTION
  FAX
  VERIFY
}

/// MCTB outbound SMS sender selection (ingress DID is separate).
enum MctbSenderMode {
  WORKSPACE
  PLATFORM
}

enum MctbPlatformSenderAssignmentState {
  ACTIVE
  RELEASED
}

/// Shared inbox product discriminator (MCTB vs Mass Texting vs manual).
enum ConversationProductSource {
  MCTB
  MASS_TEXT
  MANUAL
  AUTOMATION
  APPOINTMENT_REMINDERS
  REVIEW_REQUESTS
}

enum ArSmsReplySessionState {
  AWAITING_REPLY
  RESCHEDULING
  AWAITING_CANCEL_CONFIRM
  AWAITING_STAFF_APPROVAL
  COMPLETED
  EXPIRED
  SENDER_REUSE_BLOCKED
  NEEDS_CLARIFICATION
  HELD_PENDING_SEND
}

enum ArSmsInboundHeldState {
  HELD
  RESOLVED
  DISMISSED
}

enum ArPlatformSmsInboundReceiptState {
  RECEIVED
  ROUTED
  PROCESSING
  COMPLETED
  RETRY_PENDING
  HELD
  FAILED
}

/// Separate A2P/messaging registration profiles per product use case.
enum MessagingProductUseCase {
  MCTB_CUSTOMER_CARE
  MASS_TEXT_MARKETING
  REVIEW_SOLICITATION
}

enum PlatformProductConsumerSource {
  mass_text
  review_requests
}

/// Mass Texting billing lifecycle (trial → paid production).
enum MassTextingLifecycleState {
  TRIAL_PENDING_A2P
  TRIAL_ACTIVE
  TRIAL_LIMIT_REACHED
  TRIAL_EXPIRED
  CONVERSION_SELECTED
  PAYMENT_REQUIRED
  PRODUCTION_A2P_PENDING
  PRODUCTION_ACTIVE
  CANCELED
}

enum MassTextA2pFeeStatus {
  NOT_REQUIRED
  PENDING
  PAID
  WAIVED
}

enum MassTextCreditReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

model User {
  id                         String                      @id @default(cuid())
  email                      String                      @unique
  name                       String
  passwordHash               String?
  phone                      String?
  phoneVerifiedAt            DateTime?
  isPlatformAdmin            Boolean                     @default(false)
  totpSecretEnc              String?
  totpEnabled                Boolean                     @default(false)
  totpBackupCodes            String[]                    @default([])
  /// Last product the user opened (sms | numbers) for multi-product login routing.
  lastActiveProduct          ProductKey?
  /// Signup source / product intent preserved across authentication.
  productIntent              ProductKey?
  deletionRequestedAt        DateTime?
  createdAt                  DateTime                    @default(now())
  memberships                Membership[]
  assignedConversations      Conversation[]              @relation("Assignee")
  auditLogs                  AuditLog[]
  phoneAssignments           PhoneNumberAssignment[]
  premiumNumberReservations  PremiumNumberReservation[]
  premiumNumberSearchLogs    PremiumNumberSearchLog[]
  numberServiceSubscriptions NumberServiceSubscription[]
  inAppNotifications         InAppNotification[]
  invitesSent                WorkspaceInvite[]           @relation("InviteSender")
  ownedWorkspaces            Workspace[]                 @relation("WorkspaceOwner")

  @@index([phone])
}

