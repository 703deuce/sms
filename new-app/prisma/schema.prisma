  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events      CrmSyncEvent[]

  @@index([workspaceId, provider, createdAt])
  @@index([status, createdAt])
  @@map("crm_sync_runs")
}

