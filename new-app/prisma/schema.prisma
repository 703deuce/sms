  assistantTests        VoiceAssistantTest[]
  tags                  VoiceAssistantTag[]
  observabilityConfigs  VoiceObservabilityConfig[]

  @@index([workspaceId, status])
  @@index([workspaceId, primaryFlowId])
  @@map("voice_agents")
}

