// --- Phone Call Forwarding + Auto Attendant (new-app) ---

model ForwardingDestination {
  id                     String    @id @default(cuid())
  workspaceId            String
  name                   String
  /// external_phone | workspace_number
  destinationKind        String    @default("external_phone")
  phoneE164              String?
  workspacePhoneNumberId String?
  enabled                Boolean   @default(true)
  screeningEnabled       Boolean   @default(false)
  press1Required         Boolean   @default(false)
  privateAnnouncement    String?
  ringTimeoutSec         Int       @default(25)
  callerIdPolicy         String    @default("original") // original | business_line
  lastTestedAt           DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  workspace            Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspacePhoneNumber PhoneNumber?            @relation(fields: [workspacePhoneNumberId], references: [id], onDelete: SetNull)
  groupMembers         ForwardingGroupMember[]

  @@unique([workspaceId, phoneE164])
  @@unique([workspaceId, workspacePhoneNumberId])
  @@index([workspaceId, enabled])
  @@map("forwarding_destinations")
}

model ForwardingGroup {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  strategy     String   @default("sequential") // sequential | simultaneous
  enabled      Boolean  @default(true)
  fallbackJson Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace         Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members           ForwardingGroupMember[]
  answeringPolicies PhoneNumberAnsweringPolicy[]

  @@index([workspaceId])
  @@map("forwarding_groups")
}

model ForwardingGroupMember {
  id            String  @id @default(cuid())
  groupId       String
  destinationId String
  priority      Int     @default(0)
  enabled       Boolean @default(true)

  group       ForwardingGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  destination ForwardingDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([groupId, destinationId])
  @@index([groupId, priority])
  @@map("forwarding_group_members")
}

model AutoAttendantMenu {
  id                     String   @id @default(cuid())
  workspaceId            String
  name                   String
  description            String?
  status                 String   @default("draft") // draft | published | disabled
  publishedVersion       Int      @default(0)
  greetingMode           String   @default("tts") // tts | audio
  greetingText           String?
  greetingAudioUrl       String?
  voice                  String?  @default("Telnyx.KokoroTTS.af")
  language               String?  @default("en-US")
  inputTimeoutMs         Int      @default(5000)
  maxRetries             Int      @default(2)
  noInputActionJson      Json?
  invalidInputActionJson Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  workspace         Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  options           AutoAttendantMenuOption[]
  answeringPolicies PhoneNumberAnsweringPolicy[]

  @@index([workspaceId, status])
  @@map("auto_attendant_menus")
}

model AutoAttendantMenuOption {
  id               String @id @default(cuid())
  menuId           String
  digit            String
  label            String
  actionType       String
  actionConfigJson Json   @default("{}")
  sortOrder        Int    @default(0)

  menu AutoAttendantMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([menuId, digit])
  @@index([menuId, sortOrder])
  @@map("auto_attendant_menu_options")
}

model PhoneNumberAnsweringPolicy {
  id                    String   @id @default(cuid())
  workspaceId           String
  phoneNumberId         String   @unique
  answeringMode         String   @default("browser") // browser | forward | auto_attendant | voicemail | greeting_then_forward
  forwardingGroupId     String?
  primaryDestinationId  String?
  autoAttendantMenuId   String?
  paused                Boolean  @default(false)
  greetingBeforeForward Boolean  @default(false)
  greetingText          String?
  scheduleJson          Json?
  holidayExceptionsJson Json?
  version               Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  forwardingGroup   ForwardingGroup?   @relation(fields: [forwardingGroupId], references: [id], onDelete: SetNull)
  autoAttendantMenu AutoAttendantMenu? @relation(fields: [autoAttendantMenuId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@map("phone_number_answering_policies")
}

model PhoneCallRoutingSession {
  id                   String   @id @default(cuid())
  workspaceId          String
  phoneNumberId        String?
  humanCallId          String?
