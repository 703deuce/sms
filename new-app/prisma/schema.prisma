  nextRunAt        DateTime?
  startedAt        DateTime     @default(now())
  completedAt      DateTime?
  lastSentAt       DateTime?
  replied          Boolean      @default(false)
  opened           Boolean      @default(false)
  dripCampaign     DripCampaign @relation(fields: [dripCampaignId], references: [id], onDelete: Cascade)

  @@unique([dripCampaignId, contactId])
  @@index([workspaceId, status])
  @@index([dripCampaignId, status])
  @@index([nextRunAt])
  @@map("drip_campaign_enrollments")
}

/// Conversational AI auto-responder for inbound SMS.
