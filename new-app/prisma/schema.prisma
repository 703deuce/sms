  phoneAssignments      VoiceAgentPhoneNumber[]
  knowledgeLinks        VoiceAgentKnowledgeBase[]
  toolLinks             VoiceAgentTool[]
  calls                 VoiceCall[]
  campaigns             VoiceCampaign[]
  routingRules          VoiceRoutingRule[]
  testRuns              VoiceTestRun[]
  remoteVersions        VoiceRemoteAssistantVersion[]
  canaryDeploys         VoiceCanaryDeploy[]
  scheduledEvents       VoiceScheduledEvent[]
  memoryConfigs         VoiceMemoryConfig[]
  transferDestinations  VoiceTransferDestination[]
  widgetConfigs         VoiceWidgetConfig[]
