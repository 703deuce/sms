enum VoiceAgentStatus {
  DRAFT
  TESTING
  ACTIVE
  PAUSED
  ARCHIVED
  CONFIGURATION_ERROR
}

enum VoiceCallDirection {
  INBOUND
  OUTBOUND
}

enum VoiceCallStatus {
  QUEUED
  INITIATED
  RINGING
  ANSWERED
  IN_PROGRESS
  COMPLETED
  NO_ANSWER
  BUSY
  FAILED
  CANCELLED
  VOICEMAIL
  TRANSFERRED
}

