  updatedAt         DateTime  @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient CampaignRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, stepKey])
  @@index([status, scheduledFor])
  @@index([campaignId, status])
  @@index([providerId])
  @@index([workspaceId, createdAt])
  @@map("campaign_messages")
}

model Suppression {
  id             String   @id @default(cuid())
  workspaceId    String
  phone          String?
  email          String?
  /// Normalized identity `p:+E164` or `e:email@x` for idempotent STOP inserts.
  suppressionKey String   @unique
  reason         String
  source         String?
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, phone])
  @@index([workspaceId, email])
  @@map("review_request_suppression")
}

model JobQueue {
  id             String         @id @default(cuid())
  workspaceId    String?
  jobType        String
  queueName      String         @default("default")
  payload        Json
  status         JobQueueStatus @default(pending)
  idempotencyKey String?        @unique
  attempts       Int            @default(0)
  maxAttempts    Int            @default(8)
  /// Lower number = higher priority (CRM high=10, medium=50, low=90).
  priority       Int            @default(50)
  runAfter       DateTime       @default(now())
  lockedAt       DateTime?
  lastError      String?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([status, priority, runAfter, queueName])
  @@index([jobType, status])
  @@map("job_queue")
}

/// Persisted heartbeat for background workers (SMS dispatch, etc.).
model WorkerHeartbeat {
  workerKey   String   @id
  workerId    String
  lastBeatAt  DateTime
  metricsJson Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lastBeatAt])
  @@map("worker_heartbeats")
}

/// Inbound automation webhooks (Zapier/Make/n8n) — not outbound Webhook destinations.
