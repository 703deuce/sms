/// Maps a Transovo object to an external CRM record (provider-agnostic).
model CrmObjectMapping {
  id                     String    @id @default(cuid())
  workspaceId            String
  provider               String
  objectType             String // contact | company | lead | deal | task | activity | call | sms | note
  internalId             String
  externalId             String
  externalUrl            String?
  parentExternalId       String?
  fingerprint            String? // phone/email hash for initial matching only
  syncHash               String? // hash of last successfully synced payload
  syncVersion            Int       @default(1)
  syncStatus             String    @default("synced") // synced | pending | conflict | deleted_external | error
  lastSyncedAt           DateTime?
  lastCrmModifiedAt      DateTime?
  lastInternalModifiedAt DateTime?
  externalDeletedAt      DateTime?
  syncDirection          String    @default("bidirectional") // inbound | outbound | bidirectional
  metadataJson           Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  workspace              Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, objectType, internalId])
  @@unique([workspaceId, provider, objectType, externalId])
  @@index([workspaceId, provider, fingerprint])
  @@index([workspaceId, provider, objectType, syncStatus])
  @@map("crm_object_mappings")
}

/// Admin-configurable field mappings between Transovo and a CRM provider.
model CrmFieldMapping {
  id            String    @id @default(cuid())
  workspaceId   String
  provider      String
  objectType    String
  internalField String
  externalField String
  transform     String? // none | e164 | lowercase | custom
  direction     String    @default("bidirectional")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, objectType, internalField, direction])
  @@index([workspaceId, provider])
  @@map("crm_field_mappings")
}

/// One synchronization run (initial / incremental / manual / webhook / scheduled).
model CrmSyncRun {
  id          String         @id @default(cuid())
  workspaceId String
  provider    String
  kind        String // initial | incremental | manual | webhook | scheduled | push
  /// inbound | outbound | bidirectional
  direction   String         @default("bidirectional")
  status      String         @default("queued") // queued | running | succeeded | failed | partial
  objectType  String? // optional primary object focus
  startedAt   DateTime?
  finishedAt  DateTime?
  durationMs  Int?
  attempts    Int            @default(0)
  statsJson   Json?
  lastError   String?
  cursorJson  Json?
