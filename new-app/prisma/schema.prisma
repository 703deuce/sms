}

model CampaignMessage {
  id                String    @id @default(cuid())
  workspaceId       String
  campaignId        String
  recipientId       String
  channel           String    @default("sms")
  stepKey           String?
  to                String
  body              String
  status            String    @default("queued")
  providerStatus    String?
  providerErrorCode String?
  failureCategory   String?
  scheduledFor      DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  providerId        String?
  trackingToken     String?   @unique
  destinationUrl    String?
  error             String?
  deliveredCounted  Boolean   @default(false)
  failedCounted     Boolean   @default(false)
  clickedCounted    Boolean   @default(false)
  sentCounted       Boolean   @default(false)
  advancedAfterSend Boolean   @default(false)
