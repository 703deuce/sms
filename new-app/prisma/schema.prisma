model VoiceAgent {
  id                    String                        @id @default(cuid())
  workspaceId           String
  name                  String
  description           String?
  agentType             String                        @default("custom")
  status                VoiceAgentStatus              @default(DRAFT)
  displayName           String?
  purpose               String?
  phoneNumberId         String?
  directions            String[]                      @default(["inbound", "outbound"])
  draftConfig           Json?
  publishedVersionId    String?
  telnyxAssistantId     String?
  telnyxConnectionId    String?
  callsHandled          Int                           @default(0)
  conversionRate        Float                         @default(0)
  healthStatus          String                        @default("ok")
  healthMessage         String?
  emergencyDisabled     Boolean                       @default(false)
  multiPartyEnabled     Boolean                       @default(false)
  outboundAiEnabled     Boolean                       @default(false)
  widgetEnabled         Boolean                       @default(false)
  memoryConfigId        String?
  insightGroupId        String?
  observabilityConfigId String?
  sourceSolutionSetupId String?
