{
  "name": "transovo-new-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "prisma"]
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "prisma generate && next build",
    "start": "node scripts/start-production.mjs",
    "typecheck": "tsc --noEmit",
    "test:phone": "node scripts/test-phone-runtime-logic.mjs && node scripts/test-phone-recording-resolve.mjs && node scripts/test-phone-complete.mjs",
    "test:power-dialer-engine": "npx tsx scripts/test-power-dialer-engine.ts",
    "test:power-dialer-phase3": "npx tsx scripts/test-power-dialer-phase3.ts",
    "test:power-dialer-phase4": "npx tsx scripts/test-power-dialer-phase4.ts",
    "test:power-dialer-phase5": "npx tsx scripts/test-power-dialer-phase5.ts",
    "test:power-dialer-phase6": "npx tsx scripts/test-power-dialer-phase6.ts",
    "test:power-dialer-phase7": "npx tsx scripts/test-power-dialer-phase7.ts",
    "test:power-dialer-phase8": "npx tsx scripts/test-power-dialer-phase8.ts",
    "test:power-dialer-phase9": "npx tsx scripts/test-power-dialer-phase9.ts",
    "test:power-dialer-metrics-consistency": "npx tsx scripts/test-power-dialer-metrics-consistency.ts",
    "test:power-dialer-authorization": "npx tsx scripts/test-power-dialer-authorization.ts",
    "test:phone:prod": "node scripts/test-phone-production-cert.mjs",
    "test:receptionist": "node scripts/test-receptionist-complete.mjs && node scripts/test-telephony-voice-catalog.mjs && node scripts/test-telephony-switch-sequence.mjs && node scripts/test-ai-receptionist-two-modes.mjs && node scripts/test-conversational-ivr-profile.mjs",
    "test:receptionist:runtime-verify": "NODE_OPTIONS='--import ../scripts/preload-server-only.mjs' npx tsx scripts/test-ai-receptionist-runtime-verification.ts",
    "test:voice-v3": "npx tsx scripts/test-receptionist-config-source.ts && node scripts/test-voice-v3-tools.mjs && node scripts/test-voice-v3-appointment-match.mjs",
    "sync:voice-v3-authority": "node ../packages/transovo-voice-v3-runtime/sync-to-new-app.mjs",
    "test:voice-v3:golden-parity": "pnpm run sync:voice-v3-authority && NODE_OPTIONS='--import ../scripts/preload-server-only.mjs' npx tsx scripts/verify-golden-runtime-parity.ts",
    "postinstall": "test -f prisma/schema.prisma && prisma generate || true"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.16.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "3.8.0",
    "shadcn": "^4.11.0",
    "@telnyx/webrtc": "^2.25.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "@livekit/protocol": "^1.40.0",
    "livekit-client": "^2.15.4",
    "livekit-server-sdk": "^2.13.0",
    "zod": "^3.24.0",
    "openai": "^4.0.0",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "prisma": "^6.16.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
