  "startMs": 6250,
  "endMs": 11817,
  "anchors": {
   "in": "cue annKM (announcer says the name)",
   "location": "L01:'Central'",
   "year": "L01:'Nineteen'"
  }
 },
 "engines": [
  {
   "role": "world",
   "engine": "three.js",
   "file": "lib/three.module.js"
  },
