  {
   "role": "runtime",
   "engine": "ms-props",
   "version": "0.1",
   "file": "ms-props.js"
  }
 ],
 "entry": {
  "html": "index.html",
  "api": "window.__scene",
  "methods": [
   "seek(t)",
