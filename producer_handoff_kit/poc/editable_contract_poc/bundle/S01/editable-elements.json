   "getProps()",
   "validate()",
   "describe()"
  ],
  "readyFlags": [
   "__ready",
   "__msReady"
  ]
 },
 "livePreview": {
  "capability": "live",
  "reasons": [
   "single WebGL scene, 6 meshes, one 4096x2560 canvas texture",
   "all editable props are applied by ms-props.js in < 1 frame budget on desktop GPUs; a text/colour edit repaints the page texture (about 0.2-1 s on software GL)"
  ],
  "requirements": {
   "webgl": "webgl1+",
   "maxTextureSize": 4096,
   "minDeviceMemoryGB": 4,
   "fonts": "FontFace API",
   "cssMask": true
  },
  "fallback": {
   "mode": "poster_then_render",
   "posterFrame": 166,
   "description": "if requirements fail, show the last rendered poster frame and queue a worker render of the same bundle + props"
  }
 },
