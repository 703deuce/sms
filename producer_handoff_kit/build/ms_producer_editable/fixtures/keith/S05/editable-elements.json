  ]
 },
 "livePreview": {
  "capability": "live",
  "reasons": [
   "single WebGL scene, 6 meshes, one 4096x2560 canvas texture",
   "all editable props are applied by ms-props.js in < 1 frame budget on desktop GPUs; a text/colour edit repaints the page texture (about 0.2-1 s on software GL)"
  ],
  "requirements": {
   "webgl": "webgl1+",
   "maxTextureSize": 4096,
   "minDeviceMemoryGB": 4,
   "fonts": "FontFace API",
   "cssMask": true
  },
  "fallback": {
   "mode": "poster_then_render",
   "posterFrame": 60,
   "description": "if requirements fail (no WebGL / texture size / memory), show the version's poster and rendered clip; edits are queued as a deterministic_render job"
  }
 },
