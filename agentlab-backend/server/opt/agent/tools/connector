#!/usr/bin/env python3
"""connector: Rick's one-click sign-in connectors (Microsoft 365, Calendly, Salesforce, Zoho CRM).
Tokens never leave the host broker; you call the APIs through it.

  connector status                          which are connected, granted scopes
  connector link <provider> [set]           sign-in link to give Rick (valid 15 min). microsoft sets: calendar | personal (+To Do) | work (+Teams chats/channels/meetings, work/school accounts only) | work-full (+SharePoint, Bookings)
  connector call <provider> <METHOD> <path> [--query '{"k":"v"}'] [--body '{...}'] [--header 'Prefer: outlook.timezone="America/New_York"']
      microsoft: Graph v1.0 paths, e.g. GET /me/calendarView --query '{"startDateTime":"2026-11-26T00:00:00","endDateTime":"2026-11-27T00:00:00"}'
                 POST /me/events, POST /me/sendMail, GET /me/messages, GET /me/joinedTeams, POST /teams/{id}/channels/{id}/messages,
                 GET /me/drive/root/children, GET /solutions/bookingBusinesses
      calendly:  GET /users/me, GET /event_types?user=..., GET /scheduled_events?user=...
      salesforce: /services/data/v62.0/sobjects/Lead (instance URL added for you)
      zoho:      /Leads, /Contacts (CRM v6 base added for you)
  connector disconnect <provider>
"""
import argparse, json, sys, urllib.request

B = 'http://127.0.0.1:6081'


def req(method, path, body=None):
    r = urllib.request.Request(B + path, data=json.dumps(body).encode() if body is not None else None, method=method,
                               headers={'Content-Type': 'application/json'})
    try:
        with urllib.request.urlopen(r, timeout=60) as x:
            return json.load(x)
    except urllib.error.HTTPError as e:
        return json.loads(e.read() or b'{}')
    except Exception as e:
        sys.exit(f'connector broker not reachable: {e}')


p = argparse.ArgumentParser(prog='connector', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
p.add_argument('cmd'); p.add_argument('provider', nargs='?'); p.add_argument('method', nargs='?'); p.add_argument('path', nargs='?')
p.add_argument('--query'); p.add_argument('--body'); p.add_argument('--header', action='append', default=[])
a = p.parse_args()
if a.cmd == 'status':
    for k, v in req('GET', '/status').items():
        print(f"{k:10} {'CONNECTED' if v['connected'] else 'not connected'}{'' if v['app_configured'] else ' (app keys missing)'}"
              f"  scopes: {v['granted_scopes'] or '-'}")
elif a.cmd == 'link':
    r = req('GET', f'/connect/{a.provider}' + (f'?scope={a.method}' if a.method in ('calendar', 'personal', 'work', 'work-full') else ''))
    print(r.get('url') or r)
elif a.cmd == 'call':
    hdr = dict(h.split(':', 1) for h in a.header)
    r = req('POST', f'/call/{a.provider}', {'method': a.method, 'path': a.path, 'query': json.loads(a.query) if a.query else None,
                                            'body': json.loads(a.body) if a.body else None, 'headers': {k.strip(): v.strip() for k, v in hdr.items()}})
    print(json.dumps(r, indent=1)[:60000])
elif a.cmd == 'disconnect':
    print(req('POST', f'/disconnect/{a.provider}', {}))
else:
    print(__doc__)
