#!/usr/bin/env python3
"""Hook (PreToolUse/PostToolUse on terminal): refuses rm/mv/etc. that touch paths outside the
conversation's job folder, /tmp and tool caches. PostToolUse records the terminal's current directory
so relative paths are judged against where the shell really is."""
import json, os, re, shlex, sys

HOME = '/home/openhands'
SAFE_EXTRA = ['/tmp', f'{HOME}/.cache', f'{HOME}/.npm', f'{HOME}/.local', f'{HOME}/.config', f'{HOME}/.deno',
              f'{HOME}/.cache/ms-playwright', '/var/tmp']
DESTRUCTIVE = {'rm', 'rmdir', 'unlink', 'shred', 'mv', 'truncate', 'srm', 'wipe'}
STATE = '/tmp/agent-guard'


def deny(reason):
    print(json.dumps({'decision': 'deny', 'reason': reason}))
    sys.exit(2)


# inserted into agent-guard
import subprocess

def _job_cid(job):
    ids = re.findall(r'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}', job or '')
    return ids[-1] if ids else None


def current_run_is_opus(job):
    try:
        import sys
        if '/opt/tools' not in sys.path:
            sys.path.insert(0, '/opt/tools')
        import runlib as R
        return R.current_run_is_opus(job)
    except Exception:
        cid = _job_cid(job)
        try:
            st = json.load(open(f'/workspace/runs/vision/{cid}.json'))
            return 'opus' in str(st.get('model') or '').lower()
        except Exception:
            return False


def is_visual_source_path(path):
    try:
        import sys
        if '/opt/tools' not in sys.path:
            sys.path.insert(0, '/opt/tools')
        import runlib as R
        return R.is_visual_source_path(path)
    except Exception:
        p = str(path or '').replace('\\', '/')
        ext = os.path.splitext(p)[1].lower()
        if ext in {'.tsx', '.jsx', '.vue', '.svelte', '.css', '.scss', '.sass', '.less', '.html', '.htm'}:
            return True
        return bool(re.search(r'(remotion|hyperframes?|cinematic|components|pages)/|film\.tsx', p, re.I)) and ext in {'.ts', '.js', '.tsx', '.jsx'}


def start_visual_build(job, task, path=None, draft=None):
    """Kick off a background Opus visual-build and return a short status line.

    `draft` is ignored: Opus must write visual source from scratch.
    """
    if not job:
        return 'no job folder'
    logdir = os.path.join(job, 'log')
    os.makedirs(logdir, exist_ok=True)
    try:
        st = json.load(open(os.path.join(logdir, 'visual-build.json')))
        if st.get('status') == 'running':
            return 'a visual-build is already running; wait with `visual-build --wait 180`'
    except Exception:
        pass
    # Do not save or forward a Haiku draft. Opus writes visual source from scratch.
    cmd = ['/opt/tools/visual-build', '--bg', '--job', job, task[:4000]]
    if path:
        cmd += ['--path', path]
    try:
        r = subprocess.run(cmd, cwd=job, capture_output=True, text=True, timeout=8)
        msg = (r.stdout or r.stderr or '').strip() or f'exit {r.returncode}'
        return msg
    except Exception as e:
        return f'could not start visual-build: {e}'


def deny_visual(job, path, task, draft=None):
    note = start_visual_build(job, task, path=path, draft=draft)
    deny(
        'BLOCKED: visual and front-end source (Remotion, HyperFrames, motion graphics, pages, UI, CSS/HTML) '
        'must be written by Opus, not by you. Do not draft index.html, tsx, or other visual source first. '
        'Mechanical work stays yours: downloads, file ops, running the render, research.\n'
        f'I started an Opus visual-build for {path or "this write"} (from scratch: plan, assets, VO/script timeline). {note}\n'
        'Wait for it with `visual-build --wait 180`, then continue from the files it wrote (see log/visual-build.json for paths and sizes). '
        'To request more visual code, run `visual-build "what to write"`.'
    )


def legacy_visual_guard():
    """The file-type visual guard was retired 2026-11-24 (model ownership + completion gate replace it)."""
    try:
        if '/opt/tools' not in sys.path:
            sys.path.insert(0, '/opt/tools')
        import runlib as R
        return bool(R.owner_config().get('legacy_visual_guard'))
    except Exception:
        return False


def check_visual_editor(ti, job):
    if not legacy_visual_guard() or current_run_is_opus(job):
        return
    path = str(ti.get('path') or '')
    if not path or not is_visual_source_path(path):
        return
    task = (
        f'Write {path} from scratch as complete visual/front-end source. '
        'Use the job plan, available footage/assets, and the voiceover or script timeline. '
        'Do not revise a draft — invent the composition yourself.'
    )
    deny_visual(job, path, task)


def visual_paths_in_command(cmd, cwd, job):
    paths = []
    for m in re.finditer(r'(?:>>?|tee(?:\s+-a)?)\s*([^\s;&|<>]+)', cmd):
        paths.append(m.group(1))
    for m in re.finditer(r'(?:^|[\s;&|])(?:cat|tee)\s+(?:>|>>)\s*([^\s;&|<>]+)', cmd):
        paths.append(m.group(1))
    out = []
    for raw in paths:
        if re.search(r'[$`]', raw):
            continue
        p = os.path.normpath(os.path.join(cwd or job or '/', os.path.expanduser(raw)))
        if is_visual_source_path(p):
            out.append(p)
    return out


def allowed_roots(job):
    roots = [job] + SAFE_EXTRA if job else SAFE_EXTRA
    return [os.path.realpath(r) for r in roots]


def inside(path, roots):
    p = os.path.realpath(path)
    return any(p == r or p.startswith(r.rstrip('/') + '/') for r in roots)



def block_opus_switch(payload):
    """While allow_opus is false, refuse switch_llm / switch_profile to lab-opus. Profile stays defined."""
    try:
        if '/opt/tools' not in sys.path:
            sys.path.insert(0, '/opt/tools')
        import runlib as R
        if R.allow_opus():
            return
    except Exception:
        return
    name = str(payload.get('tool_name') or '')
    if name not in ('switch_llm', 'switch_profile'):
        return
    ti = payload.get('tool_input') or {}
    blob = json.dumps(ti, default=str).lower()
    if any(k in blob for k in ('lab-opus', 'claude-opus', '"opus"', "'opus'", 'profile:lab-opus')):
        deny('lab-opus is defined but unused (allow_opus is false). Stay on the current model. '
             'Do not switch this conversation to Opus.')


def main():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return
    event = payload.get('event_type') or os.environ.get('OPENHANDS_EVENT_TYPE')
    if event == 'PreToolUse':
        block_opus_switch(payload)
    sid = str(payload.get('session_id') or os.environ.get('OPENHANDS_SESSION_ID') or 'x')
    job = payload.get('working_dir') or os.environ.get('OPENHANDS_PROJECT_DIR') or ''
    os.makedirs(STATE, exist_ok=True)
    state_file = os.path.join(STATE, re.sub(r'[^\w\-]', '', sid))
    if event == 'PostToolUse':
        resp = payload.get('tool_response') or {}
        cwd = None
        if isinstance(resp, dict):
            cwd = (resp.get('metadata') or {}).get('working_dir') or resp.get('working_dir')
        if cwd:
            open(state_file, 'w').write(cwd)
        return
    if event == 'PreToolUse' and 'browser' in str(payload.get('tool_name') or ''):
        ti = payload.get('tool_input') or {}
        if ti.get('include_screenshot') in (True, 'true', 'True', 1):
            if own_model_sees(job):
                deny('Browser-tool screenshots do not reach you (they are dropped before the model sees them). Your model can '
                     'see: run `browser-shot shot.png && view shot.png` in the terminal (same tab, same login) and judge it yourself. '
                     'Call browser_get_state without include_screenshot for the text view.')
            deny('Browser-tool screenshots do not reach you. Run `browser-shot shot.png` then `look shot.png "question"`, or '
                 'call browser_get_state without include_screenshot for the text view.')
        return
    if event == 'PreToolUse' and payload.get('tool_name') in ('file_editor', 'str_replace_editor', 'edit_file'):
        check_editor(payload.get('tool_input') or {}, job)
        check_visual_editor(payload.get('tool_input') or {}, job)
        return
    if event != 'PreToolUse' or (payload.get('tool_name') not in ('terminal', 'bash', 'execute_bash')):
        return
    cmd = str((payload.get('tool_input') or {}).get('command') or '')
    if not cmd.strip():
        return
    roots = allowed_roots(job)
    cwd = open(state_file).read().strip() if os.path.exists(state_file) else (job or '/')
    if legacy_visual_guard() and not current_run_is_opus(job):
        vpaths = visual_paths_in_command(cmd, cwd, job)
        if vpaths:
            deny_visual(job, vpaths[0], (
                f'Write {", ".join(vpaths)} from scratch as complete visual/front-end source. '
                'Use the job plan, available footage/assets, and the voiceover or script timeline. '
                'Do not revise a draft — invent the composition yourself.'
            ))
    check_cmd(cmd, cwd, job, roots, 0)


def own_model_sees(job):
    """Is this conversation's main model vision-capable? (status written by the runner)"""
    ids = re.findall(r'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}', job or '')
    if not ids:
        return False
    try:
        return bool(json.load(open(f'/workspace/runs/vision/{ids[-1]}.json')).get('vision'))
    except Exception:
        return False


EDITOR_WRITES = {'create', 'str_replace', 'insert', 'undo_edit', 'write', 'edit'}


def check_editor(ti, job):
    """The file editor runs inside the agent server, outside the terminal sandbox: it may only change files in
    this conversation's job folder (or /tmp). Viewing anything is fine."""
    cmd = str(ti.get('command') or '')
    if cmd == 'view' and os.path.splitext(str(ti.get('path') or ''))[1].lower() in ('.png', '.jpg', '.jpeg', '.gif', '.webp', '.bmp'):
        deny('Images opened with the file editor may not reach you (with DeepSeek they are dropped before the model sees them). '
             'Run `view <image>` in the terminal to see it yourself (vision models), or `look <image> "question"` if '
             '`view` says your model is text-only.')
    if cmd not in EDITOR_WRITES:
        return
    path = str(ti.get('path') or '')
    if not path:
        return
    full = path if os.path.isabs(path) else os.path.join(job or '/', path)
    roots = [os.path.realpath(r) for r in ([job] if job else []) + ['/tmp', '/var/tmp']]
    if not inside(full, roots):
        deny(f'The file editor may only change files inside your job folder ({job or "none"}) or /tmp, not {path}. '
             'Shared areas (memory, skills, other jobs) change only through their tools.')


def check_cmd(cmd, cwd, job, roots, depth):
    cwd_known = True
    try:
        lex = shlex.shlex(cmd, posix=True, punctuation_chars=';&|()')
        lex.whitespace_split = True
        tokens = list(lex)
    except ValueError:
        if any(re.search(rf'(^|[\s;&|(]){d}\s', cmd) for d in DESTRUCTIVE):
            deny('Could not parse this command safely. Split it into simpler commands with literal paths.')
        return
    segs, cur = [], []
    for t in tokens:
        if t and set(t) <= set(';&|()'):
            if cur: segs.append(cur); cur = []
        else:
            cur.append(t)
    if cur: segs.append(cur)
    for seg in segs:
        while seg and (seg[0] in ('sudo', 'command', 'builtin', 'nohup', 'time', 'env', 'xargs') or re.match(r'^\w+=', seg[0]) or seg[0].startswith('-') and seg[0] != '-'):
            seg = seg[1:]
        if not seg:
            continue
        prog = os.path.basename(seg[0])
        args = seg[1:]
        if prog in ('bash', 'sh', 'zsh', 'dash') and '-c' in args and depth < 3:
            i = args.index('-c')
            if i + 1 < len(args):
                check_cmd(args[i + 1], cwd, job, roots, depth + 1)
            continue
        if prog in ('cd', 'pushd'):
            target = args[0] if args else HOME
            if re.search(r'[$`*?]', target):
                cwd_known = False
            else:
                cwd = os.path.normpath(os.path.join(cwd, os.path.expanduser(target)))
            continue
        paths = []
        if prog in DESTRUCTIVE:
            paths = [x for x in args if not x.startswith('-')]
        elif prog == 'find' and any(x in ('-delete',) for x in args) or (prog == 'find' and '-exec' in args and any(x in ('rm', 'mv', 'shred') for x in args)):
            paths = [x for x in args[:next((i for i, x in enumerate(args) if x.startswith('-')), len(args))]] or ['.']
        elif prog == 'rsync' and any(x.startswith('--delete') or x.startswith('--remove-source') for x in args):
            paths = [x for x in args if not x.startswith('-')]
        elif prog == 'git' and args[:1] == ['clean']:
            paths = ['.']
        elif prog in ('dd',):
            paths = [x[3:] for x in args if x.startswith('of=')]
        if not paths:
            continue
        for raw in paths:
            if re.search(r'[$`]', raw):
                deny(f'"{prog}" with a variable path ({raw}) is blocked: use a literal path inside your job folder {job}.')
            if not raw.startswith('/') and not raw.startswith('~') and not cwd_known:
                deny(f'"{prog}" with a relative path after an unknown cd is blocked. Use an absolute path inside {job}.')
            p = os.path.normpath(os.path.join(cwd, os.path.expanduser(raw)))
            base = re.split(r'[*?\[]', p)[0] or '/'
            if base != p:
                base = base if base.endswith('/') else os.path.dirname(base) + '/'
            check = base.rstrip('/') or '/'
            if not inside(check, roots):
                deny(f'BLOCKED: "{prog}" on {p} is outside your job folder ({job}). You may only delete, move or '
                     f'overwrite files inside your own job folder or /tmp. If this is really needed, ask Rick.')
            if os.path.realpath(p) in [os.path.realpath(job)] and prog in ('rm', 'rmdir', 'shred'):
                deny(f'BLOCKED: refusing to delete the job folder itself ({job}). Delete specific files inside it instead.')


if __name__ == '__main__':
    main()
