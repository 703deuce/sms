#!/usr/bin/env python3
"""agent-mcp: Agent Lab's own tools as real tool calls (MCP over stdio, no dependencies).

OpenHands starts one copy per conversation (settings: agent_settings.mcp_config.agent).
Args:  --job <job folder>   the conversation's /workspace/jobs/<id> (set by whoever starts the conversation).
Tools: view, look, search, remember, recall, checkpoint. Results come back as normal tool results;
`view` returns the images themselves plus an automatic QA verdict (PASS / LOOKS BROKEN).
"""
import base64, hashlib, json, os, re, subprocess, sys, tempfile, threading, time

TOOLS = '/opt/tools'
UUID = r'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'
IMG = ('.png', '.jpg', '.jpeg', '.webp', '.gif', '.bmp')
VID = ('.mp4', '.mov', '.m4v', '.webm', '.mkv', '.avi')
CACHE = '/workspace/runs/view-cache'
HARD_CAP = 12
# API keys the CLIs need. The agent's own terminal inherits them from the agent server; an MCP stdio child only gets
# a minimal environment, so take exactly these names from the parent (the agent server). Values are never printed.
INHERIT = ('GEMINI_API_KEY', 'GOOGLE_API_KEY', 'DEEPSEEK_API_KEY', 'ELEVENLABS_API_KEY', 'DEEPGRAM_API_KEY', 'TZ', 'BOT_ID',
           'LANG', 'LC_ALL', 'SEARXNG_URL', 'LOOK_MODEL', 'LOOK_DS_MODEL', 'SEARCH_FALLBACK_MODEL')

def inherit_env():
    try:
        raw = open(f'/proc/{os.getppid()}/environ', 'rb').read().split(b'\0')
    except OSError:
        return
    for item in raw:
        k, _, v = item.decode('utf-8', 'replace').partition('=')
        if k in INHERIT and k not in os.environ:
            os.environ[k] = v
    os.environ['PATH'] = '/workspace/tools/bin:/opt/tools:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'

JOB = None

def job_dir():
    return JOB if JOB and os.path.isdir(JOB) else None

def abspath(p):
    p = os.path.expanduser(str(p).strip())
    if os.path.isabs(p):
        return os.path.realpath(p)
    if job_dir():
        return os.path.realpath(os.path.join(job_dir(), p))
    raise ToolError(f'"{p}" is a relative path and this conversation has no known job folder; give the absolute path '
                    '(your job folder is named in your session context, /workspace/jobs/<conversation id>/...).')

class ToolError(Exception):
    pass

def run(cmd, timeout=280, cwd=None):
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, cwd=cwd or job_dir() or '/tmp')
    out = (r.stdout or '').strip()
    err = (r.stderr or '').strip()
    return r.returncode, out, err

def text(s):
    return {'type': 'text', 'text': s}

# ---------------- view ----------------
def prep(src, outdir, i):
    dst = os.path.join(outdir, f'{i:02d}_{re.sub(r"[^A-Za-z0-9._-]", "_", os.path.basename(src))[:60]}.jpg')
    code, _, err = run(['ffmpeg', '-loglevel', 'error', '-y', '-i', src, '-frames:v', '1', '-vf',
                        "scale='if(gt(iw,ih),min(1280,iw),-2)':'if(gt(iw,ih),-2,min(1280,ih))'", '-q:v', '3', dst], timeout=120)
    if code or not os.path.exists(dst):
        raise ToolError(f'could not read image {src}: {err[:200]}')
    return dst

def sample(files, k):
    if len(files) <= k:
        return files
    return [files[round(i * (len(files) - 1) / (k - 1))] for i in range(k)] if k > 1 else files[:1]

def secs(t):
    if not t:
        return 0.0
    v = 0.0
    for part in str(t).split(':'):
        v = v * 60 + float(part)
    return v

def collect(paths, fps, start, end, k, outdir):
    srcs, notes = [], []
    for p in paths:
        p = abspath(p)
        low = p.lower()
        if os.path.isdir(p):
            fs = sorted(os.path.join(p, f) for f in os.listdir(p) if f.lower().endswith(IMG))
            if len(fs) > k:
                notes.append(f'{len(fs)} images in {p}; showing {k} evenly spaced.')
            srcs += [(f, None) for f in sample(fs, k)]
        elif low.endswith(VID):
            fd = os.path.join(outdir, 'frames'); os.makedirs(fd, exist_ok=True)
            cmd = ['ffmpeg', '-loglevel', 'error', '-y']
            if start: cmd += ['-ss', str(start)]
            if end: cmd += ['-to', str(end)]
            cmd += ['-i', p, '-vf', f'fps={fps or 1}', os.path.join(fd, f'{len(srcs):02d}_f_%04d.png')]
            code, _, err = run(cmd, timeout=240)
            fs = sorted(os.path.join(fd, f) for f in os.listdir(fd))
            if code or not fs:
                raise ToolError(f'could not extract frames from {p}: {err[:200]}')
            if len(fs) > k:
                notes.append(f'{len(fs)} frames at {fps or 1} fps; showing {k} evenly spaced (narrow with start/end or a lower fps).')
            t0 = secs(start)
            for f in sample(fs, k):
                n = int(re.search(r'_(\d+)\.png$', f).group(1))
                srcs.append((f, f'{os.path.basename(p)} @ {t0 + (n - 1) / float(fps or 1):.2f}s'))
        elif os.path.isfile(p) and low.endswith(IMG):
            srcs.append((p, None))
        elif not os.path.exists(p):
            raise ToolError(f'not found: {p}')
        else:
            raise ToolError(f'not an image, folder of images or video: {p}')
    if len(srcs) > k:
        notes.append(f'{len(srcs)} images given; showing the first {k} (max {HARD_CAP} per call).')
        srcs = srcs[:k]
    if not srcs:
        raise ToolError('no images found')
    return srcs, notes

OUTPUT_DIRS = re.compile(r'(^|/)(out|deliver|delivery|render|renders|qa|final|export|exports)(/|$)')


def opus_verdict(images, labels, question, workdir):
    """Short Opus call on just these frames (no conversation history). Returns (verdict_dict, err)."""
    argv = [f'{TOOLS}/opus-step', '--purpose', 'judge', '--json']
    q = (question or '').strip() or (
        'Is anything wrong with these images? Check: covered or cropped faces; cut-off or overlapping text; '
        'typography unreadable at 480p; headings overlapping the picture; bad crops; pillarboxing or letterboxing; '
        'watermarks that should have been cropped; lower-thirds covering faces; blank, frozen or black frames; '
        'choppy or misaligned captions; anything that looks unfinished or sloppy.'
    )
    argv += ['--question', q]
    for lab, f in zip(labels, images):
        argv += ['--image', f, '--label', str(lab)]
    try:
        code, out, err = run(argv, timeout=200, cwd=workdir or job_dir() or '/')
    except subprocess.TimeoutExpired:
        return None, 'Opus visual judge timed out'
    if code:
        return None, ((err or out) or 'Opus visual judge unavailable')[:300]
    report, cost = out, None
    try:
        data = json.loads(out)
        report = data.get('text') or out
        cost = data.get('cost_usd')
    except Exception:
        data = {}
    m = re.search(r'VERDICT:\s*(PASS|LOOKS BROKEN)\b\s*[-:]?\s*(.*)', report, re.I)
    if not m:
        return None, 'Opus visual judge returned no VERDICT line'
    broken = m.group(1).upper() == 'LOOKS BROKEN'
    return {'broken': broken, 'reason': (m.group(2) or '').strip(), 'report': report,
            'source': 'opus', 'cost_usd': cost}, None


def log_step_failure(detail, kind='verify'):
    job = job_dir()
    if not job:
        return
    rec = {'ts': time.time(), 'kind': kind, 'detail': str(detail)[:500], 'status': 'FAIL'}
    path = os.path.join(job, 'log', 'step-failures.jsonl')
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        open(path, 'a').write(json.dumps(rec) + '\n')
    except Exception:
        pass


def want_verdict(args, paths):
    """The second-model QA verdict exists for main models that cannot see images: the look report is their eyes.
    Models that see images judge them natively, so no second model runs and nothing waits, unless qa=true asks
    for a second opinion explicitly. Capability comes from the runner's per-conversation status (follows model switches)."""
    if not images_via_user_message()[2]:
        return True  # text-only model: the look report is its eyes
    return bool(args.get('qa'))


def verdict(images, question, workdir):
    """Automatic QA pass over exactly the images shown (look's strict checklist, DeepSeek vision then Gemini)."""
    d = os.path.join(workdir, 'qa'); os.makedirs(d, exist_ok=True)
    for i, f in enumerate(images):
        os.symlink(f, os.path.join(d, f'{i:02d}_{os.path.basename(f)}'))
    q = question or 'Is anything wrong with these images (cut-off or overlapping text, bad crops, blank/frozen frames, glitches, junk)?'
    try:
        code, out, err = run([f'{TOOLS}/look', d, q, '--second-opinion'], timeout=200, cwd=workdir)
    except subprocess.TimeoutExpired:
        return None, 'QA check timed out'
    if code or 'LOOKS BROKEN' not in out:
        return None, (err or out)[:300] or 'QA check unavailable'
    m = re.search(r'LOOKS BROKEN:\s*(yes|no)\b\s*[-:]?\s*(.*)', out, re.I)
    broken = bool(m and m.group(1).lower() == 'yes')
    return {'broken': broken, 'reason': (m.group(2).strip() if m else ''), 'report': out}, None

def view(args):
    paths = args.get('paths') or ([args['path']] if args.get('path') else [])
    if isinstance(paths, str):
        paths = [paths]
    if not paths:
        raise ToolError('give `paths`: one or more images, a folder of frames, or a video (with fps)')
    k = max(1, min(int(args.get('max') or 8), HARD_CAP))
    question = str(args.get('question') or '').strip()[:500]
    stamp = time.strftime('%Y%m%d-%H%M%S')
    base = os.path.join(job_dir(), 'log', 'view') if job_dir() else '/tmp/agent-view'
    outdir = os.path.join(base, f'{stamp}-{os.getpid()}-{threading.get_ident() % 10000}')
    os.makedirs(outdir, exist_ok=True)
    srcs, notes = collect(paths, args.get('fps'), args.get('start'), args.get('end'), k, outdir)
    sent = [prep(s, outdir, i) for i, (s, _) in enumerate(srcs, 1)]
    labels = [lab or (os.path.relpath(s, job_dir()) if job_dir() and s.startswith(job_dir() + '/') else s) for s, lab in srcs]
    # Facts the harness keeps per conversation, so finished looks are not repeated:
    #  - verdicts are keyed by the exact pixels (not the wording of the question): the same pixels always get the
    #    same recorded verdict, PASS or LOOKS BROKEN, until they change or recheck=true asks for a fresh one;
    #  - images already delivered to the model since its last summary are not sent again.
    digests = [hashlib.sha256(open(f, 'rb').read()).hexdigest() for f in sent]
    scope = str(args.get('_scope') or '')  # verify passes its criterion id: one recorded verdict per criterion and pixels
    key = hashlib.sha256(((JOB or 'nojob') + '\0' + scope + '\0' + '\0'.join(sorted(digests))).encode()).hexdigest()[:32]
    cache = os.path.join(CACHE, key + '.json')
    recheck = bool(args.get('recheck'))
    prior = None
    try:
        prior = json.load(open(cache))
    except Exception:
        pass
    via_user, model, sees = images_via_user_message()
    seen_at = already_delivered(digests) if (sees and not recheck) else None
    v, why, recorded = None, None, None
    on_opus = any(k in (model or '').lower() for k in ('opus', 'fable'))
    try:  # the Opus judge for Haiku views was retired 2026-11-24 (visual work is owned by the Opus visual owner)
        import runlib as _R
        opus_judge = bool(_R.owner_config().get('legacy_opus_judge_for_haiku'))
    except Exception:
        opus_judge = False
    if prior and not recheck and 'broken' in prior and (prior.get('source') == 'opus' or on_opus):
        v, recorded = {'broken': prior['broken'], 'reason': prior.get('reason', ''), 'report': prior.get('report', ''),
                       'question': prior.get('question', ''), 'source': prior.get('source')}, prior.get('at')
    elif not on_opus and opus_judge:
        v, why = opus_verdict(sent, labels, question, outdir)
        if v is None and want_verdict(args, paths):
            # fallback only if the Opus judge is down
            fv, fy = verdict(sent, question, outdir)
            if fv:
                v, why = fv, why  # keep the Opus error in why? prefer fallback verdict
                v['source'] = 'look-fallback'
            else:
                why = (why or fy or 'Opus visual judge unavailable')
        elif v is None:
            why = why or 'Opus visual judge unavailable'
    elif want_verdict(args, paths):
        v, why = verdict(sent, question, outdir)
        if v:
            v['source'] = 'look'
    else:
        why = 'main model is Opus; it judges the attached images itself'
    if v and not recorded:
        os.makedirs(CACHE, exist_ok=True)
        tmp = cache + f'.{os.getpid()}'
        json.dump({'at': time.time(), 'broken': v['broken'], 'reason': v['reason'], 'report': (v.get('report') or '')[:4000],
                   'labels': labels, 'question': question, 'source': v.get('source')}, open(tmp, 'w'))
        os.replace(tmp, cache)
    head = [f'{len(sent)} image(s): ' + ', '.join(labels)] + notes
    when = (f' (recorded {et_clock(recorded)} for these exact pixels' + (f', asked: "{v.get("question")}"' if v.get('question') else '')
            + '; recheck=true runs a fresh review)') if recorded else ''
    src = (v or {}).get('source') or ''
    if v and src == 'opus':
        if v['broken']:
            head.append('OPUS VERDICT: LOOKS BROKEN - ' + (v['reason'] or 'see findings') + when +
                        '. This verdict is authoritative (Opus judged these exact frames). Fix the issues before shipping.')
        else:
            head.append('OPUS VERDICT: PASS' + (f' - {v["reason"]}' if v.get('reason') else '') + when +
                        '. This verdict is authoritative (Opus judged these exact frames). Still fix any minor issues listed.')
        head.append('VERDICT: ' + ('LOOKS BROKEN - ' + (v['reason'] or 'see findings') if v['broken'] else 'PASS') + '.')
    elif v and not v['broken']:
        head.append('VERDICT: PASS - automatic QA found nothing broken' + (f' ({v["reason"]})' if v['reason'] else '') + when + '.')
    elif v:
        head.append('VERDICT: LOOKS BROKEN - ' + (v['reason'] or 'see the QA report') + when +
                    '. This is a second model\'s review; your own eyes on the images decide.')
    else:
        head.append(f'VERDICT: none ({why}).')
    via = False
    if not sees:
        head.append(f'Your model ({model}) has vision turned off in this conversation, so no pictures are attached; the QA '
                    'report below is what the look model (a second model\'s eyes) saw in these exact images. Treat it as your eyes.')
    elif seen_at:
        head.append(f'These exact images are already in your context: they were delivered in the [view] message at {seen_at} '
                    'and are unchanged since, so they are not attached again (recheck=true re-sends them).')
        via = True
    elif via_user:
        qname = queue_images(sent, labels, question)
        if qname and wait_delivery(qname):
            head.append(f'The images are in the [view] message placed directly after this result ({model} receives images '
                        'only in user-role messages).')
            mark_delivered(digests)
            via = True
        else:
            head.append('The images could not be attached (the delivery service did not confirm). Use look for a description.')
            via = True
    content = [text('\n'.join(head))]
    for lab, f in ([] if (via or not sees) else zip(labels, sent)):
        content.append(text(lab))
        content.append({'type': 'image', 'data': base64.b64encode(open(f, 'rb').read()).decode(), 'mimeType': 'image/jpeg'})
    if not via and sees:
        mark_delivered(digests)
    if v and v.get('report') and not recorded:
        content += blocks('QA report:\n' + v['report'])
    log_image_check(labels, 'PASS' if v and not v['broken'] else 'LOOKS BROKEN' if v else 'n/a',
                    'look-report' if not sees else 'already-in-context' if seen_at else 'user-attachment' if via else 'tool-result')
    return content

def et_clock(ts):
    from datetime import datetime
    from zoneinfo import ZoneInfo
    return datetime.fromtimestamp(ts or 0, ZoneInfo('America/New_York')).strftime('%-I:%M %p ET')

def summary_epoch():
    """How many times this conversation's history has been summarized (the runner logs each one in log/context-log.md).
    Images delivered before the latest summary are no longer in the model's context."""
    try:
        return open(os.path.join(job_dir(), 'log', 'context-log.md')).read().count('\n## Condensation at ')
    except Exception:
        return 0

def _delivered_path():
    return os.path.join(job_dir(), 'log', 'view', 'delivered.json') if job_dir() else None

def already_delivered(digests):
    p = _delivered_path()
    if not p or not digests:
        return None
    try:
        d = json.load(open(p))
    except Exception:
        return None
    ep = summary_epoch()
    rows = [d.get(x) for x in digests]
    if all(r and r.get('epoch') == ep for r in rows):
        return et_clock(max(r['at'] for r in rows))
    return None

def mark_delivered(digests):
    p = _delivered_path()
    if not p:
        return
    try:
        d = json.load(open(p))
    except Exception:
        d = {}
    ep, now = summary_epoch(), time.time()
    for x in digests:
        d[x] = {'at': now, 'epoch': ep}
    os.makedirs(os.path.dirname(p), exist_ok=True)
    tmp = p + f'.{os.getpid()}'
    json.dump(d, open(tmp, 'w'))
    os.replace(tmp, p)

def wait_delivery(qname, timeout=20):
    """Wait until the runner has put the attachment POST on the wire (view-queue/sent/<name>). The server holds this
    conversation's state lock while this tool runs, so that POST lands right after this result and before the model's
    next call. Returns False if the runner reports it did not send (or never answers)."""
    ackf = os.path.join('/workspace/runs/view-queue/sent', qname)
    t0 = time.time()
    while time.time() - t0 < timeout:
        if os.path.exists(ackf):
            try:
                note = open(ackf).read().strip()
            except OSError:
                note = ''
            time.sleep(0.15)  # let the request reach the server and queue on the lock
            return note != 'not sent'
        time.sleep(0.05)
    return False

# Providers whose API route forwards images only in user-role messages (LiteLLM's DeepSeek adapter collapses tool-message
# content to text, and the SDK then refuses the request). For these the images are delivered by the runner as an
# attachment message right after the tool result. Override with VIEW_USER_IMAGE_PROVIDERS (comma list).
USER_IMAGE_PROVIDERS = [x.strip() for x in os.environ.get('VIEW_USER_IMAGE_PROVIDERS', 'deepseek').split(',') if x.strip()]

def conversation_id():
    ids = re.findall(UUID, JOB or '')
    return ids[-1] if ids else None

def images_via_user_message():
    cid = conversation_id()
    st = {}
    # The runner writes this status within one tick (5 s) of a conversation appearing or switching model; a view in the
    # very first seconds waits for it, otherwise images could go inline where some providers drop them.
    for _ in range(40):
        try:
            st = json.load(open(f'/workspace/runs/vision/{cid}.json')) if cid else {}
            break
        except Exception:
            if not cid:
                break
            time.sleep(0.25)
    model = str(st.get('model') or '')
    provider = model.split('/', 1)[0].lower() if '/' in model else ('deepseek' if 'deepseek' in model.lower() else '')
    sees = st.get('vision') is not False  # unknown -> assume it can see
    return provider in USER_IMAGE_PROVIDERS, model or 'this model', sees

def queue_images(sent, labels, note):
    cid = conversation_id()
    if not cid:
        return False
    q = '/workspace/runs/view-queue'
    os.makedirs(q, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=q, prefix='.tmp-')
    with os.fdopen(fd, 'w') as f:
        json.dump({'conversation_id': cid, 'images': sent, 'labels': labels, 'note': note[:500], 'created': time.time(),
                   'source': 'agent_view'}, f)
    os.chmod(tmp, 0o644)
    name = f'{cid}-{time.strftime("%Y%m%d-%H%M%S")}-{os.getpid()}-{threading.get_ident() % 10000}-{int(time.time() * 1000) % 100000}.json'
    os.rename(tmp, os.path.join(q, name))
    return name

# ---------------- thin wrappers over the existing CLIs ----------------
def cli(name, argv, timeout=280):
    try:
        code, out, err = run([f'{TOOLS}/{name}'] + argv, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise ToolError(f'{name} timed out after {timeout}s')
    msg = out + (('\n' + err) if err else '')
    if code:
        raise ToolError(msg.strip() or f'{name} failed (exit {code})')
    return [text(msg.strip() or '(no output)')]

def search(a):
    argv = [str(a.get('query') or '')]
    if not argv[0].strip(): raise ToolError('query is required')
    if a.get('n'): argv += ['-n', str(int(a['n']))]
    if a.get('videos'): argv += ['--videos']
    if a.get('time'): argv += ['--time', str(a['time'])]
    if a.get('engines'): argv += ['--engines', str(a['engines'])]
    return cli('search', argv, timeout=150)

def remember(a):
    argv = []
    if a.get('type'): argv += ['--type', str(a['type'])]
    if a.get('shared'): argv += ['--shared']
    if a.get('replace'): argv += ['--replace', str(a['replace'])]
    t = str(a.get('text') or '').strip()
    if not t: raise ToolError('text is required')
    return cli('remember', argv + [t], timeout=60)

def recall(a):
    argv = []
    if a.get('all'): argv = ['--all']
    else:
        q = str(a.get('query') or '').strip()
        if not q: raise ToolError('query is required (or all=true)')
        argv = [q]
        if a.get('n'): argv += ['-n', str(int(a['n']))]
    if a.get('type'): argv += ['--type', str(a['type'])]
    return cli('recall', argv, timeout=60)

def checkpoint(a):
    note = str(a.get('note') or '').strip()
    if not note: raise ToolError('note is required')
    if not job_dir(): raise ToolError('no job folder known for this conversation; run `checkpoint "..."` in the terminal instead')
    return cli('checkpoint', [note], timeout=30)

def look(a):
    p = abspath(a.get('path') or '')
    argv = [p, str(a.get('question') or 'Describe briefly what you see.')]
    if a.get('frames'): argv += ['--frames', str(int(a['frames']))]
    if a.get('second_opinion'): argv += ['--second-opinion']
    return cli('look', argv, timeout=290)


# ---------------- MCP servers on demand: find in the official registry, connect through the runner ----------------
REGISTRY = 'https://registry.modelcontextprotocol.io/v0/servers'
MCP_DIR = '/workspace/runs/mcp'

def http_json(url, timeout=30):
    import urllib.request
    req = urllib.request.Request(url, headers={'Accept': 'application/json', 'User-Agent': 'agent-lab-mcp/1.0'})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)

def mcp_find(a):
    import urllib.parse
    q = str(a.get('query') or '').strip()
    if not q: raise ToolError('query is required (a service or capability, e.g. "github", "postgres", "weather")')
    n = max(1, min(int(a.get('n') or 8), 20))
    try:
        d = http_json(f'{REGISTRY}?search={urllib.parse.quote(q)}&version=latest&limit=50')
    except Exception as e:
        raise ToolError(f'registry unavailable ({type(e).__name__}: {str(e)[:150]}); search npm/PyPI/GitHub with agent_search instead')
    seen, rows = set(), []
    for item in d.get('servers') or []:
        sv = item.get('server') or {}
        meta = ((item.get('_meta') or {}).get('io.modelcontextprotocol.registry/official') or {})
        if meta.get('status') not in (None, 'active') or sv.get('name') in seen:
            continue
        seen.add(sv.get('name'))
        lines = [f"- {sv.get('name')} v{sv.get('version')}: {(sv.get('description') or '').strip()[:220]}"]
        repo = (sv.get('repository') or {}).get('url')
        if repo: lines.append(f'    repo: {repo}')
        for pk in sv.get('packages') or []:
            envs = pk.get('environmentVariables') or []
            need = [f"{e.get('name')}{' (secret)' if e.get('isSecret') else ''}{'' if e.get('isRequired') else ' optional'}" for e in envs]
            lines.append(f"    package: {pk.get('registryType')} {pk.get('identifier')}@{pk.get('version')} "
                         f"({(pk.get('transport') or {}).get('type', 'stdio')})" + (f"; env: {', '.join(need)}" if need else '; no keys needed'))
        for rm in sv.get('remotes') or []:
            hs = [h.get('name') for h in (rm.get('headers') or [])]
            lines.append(f"    remote: {rm.get('type')} {rm.get('url')}" + (f"; headers: {', '.join(hs)}" if hs else ''))
        rows.append('\n'.join(lines))
        if len(rows) >= n:
            break
    if not rows:
        return [text(f'No registry servers match "{q}". Try other words, or agent_search for "<service> MCP server" '
                     '(prefer the vendor\'s own GitHub/npm/PyPI package).')]
    return [text(f'Official MCP registry results for "{q}" (registry-listed; prefer the service vendor\'s own server):\n'
                 + '\n'.join(rows) + '\n\nConnect one with agent_mcp_connect (registry_name=..., or package/url).')]

def runner_call(op, payload, timeout=170):
    """Ask the run daemon (outside this container, holds the server token) to change MCP settings."""
    import uuid
    rid = uuid.uuid4().hex
    req_dir, res_dir = f'{MCP_DIR}/requests', f'{MCP_DIR}/responses'
    os.makedirs(req_dir, exist_ok=True)
    body = {'id': rid, 'op': op, 'conversation_id': conversation_id(), 'job': JOB, 'created': time.time(), **payload}
    fd, tmp = tempfile.mkstemp(dir=req_dir, prefix='.tmp-')
    with os.fdopen(fd, 'w') as f:
        json.dump(body, f)
    os.chmod(tmp, 0o664)
    os.rename(tmp, f'{req_dir}/{rid}.json')
    deadline = time.time() + timeout
    out = f'{res_dir}/{rid}.json'
    while time.time() < deadline:
        if os.path.exists(out):
            time.sleep(0.2)
            r = json.load(open(out))
            try: os.unlink(out)
            except OSError: pass
            if not r.get('ok'):
                raise ToolError(r.get('message') or 'failed')
            return [text(r.get('message') or 'done')]
        time.sleep(1)
    raise ToolError('the Agent Lab runner did not answer in time; try again in a minute')

def mcp_connect(a):
    keys = ('name', 'registry_name', 'package', 'registry_type', 'version', 'url', 'transport', 'args', 'env', 'secrets', 'description')
    payload = {k: a.get(k) for k in keys if a.get(k) not in (None, '', [])}
    # name alone loads a server already in the Agent Lab library (see agent_mcp_list)
    return runner_call('connect', payload)

def mcp_list(a):
    return runner_call('list', {}, timeout=60)

def mcp_remove(a):
    if not a.get('name'): raise ToolError('name is required')
    return runner_call('remove', {'name': a['name']}, timeout=60)


def load_browser(a):
    """Add this job's browser tools to THIS conversation mid-run (they then stay loaded)."""
    return runner_call('load_browser', {}, timeout=60)


