def find_skill(name):
    sk = skills()
    key = str(name or '').strip()
    if key in sk:
        return key, sk[key]
    for k, v in sk.items():  # also accept the display name from frontmatter
        if v.get('name', '').lower() == key.lower():
            return k, v
    raise ToolError(f'no skill "{key}". Installed: {", ".join(sk) or "none"}')

def helper_files(d):
    out = []
    for root, dirs, files in os.walk(d):
        dirs[:] = sorted(x for x in dirs if not x.startswith('.') and x not in ('node_modules', '__pycache__'))
        for f in sorted(files):
            rel = os.path.relpath(os.path.join(root, f), d)
            if rel != 'SKILL.md' and not f.startswith('.'):
                out.append((rel, os.path.getsize(os.path.join(root, f))))
    return out

def skill(a):
    slug, v = find_skill(a.get('name'))
    d = v['path']
    body = open(os.path.join(d, 'SKILL.md'), encoding='utf-8', errors='replace').read()
    manifest('skill', slug, 'SKILL.md', os.path.join(d, 'SKILL.md'), len(body))
    files = helper_files(d)
    top = [f for f in files if '/' not in f[0] or f[0].count('/') == 1 and not f[0].startswith(('producer_handoff_kit/', 'scripts/'))]
    rest = len(files) - len(top)
    listing = '\n'.join(f'  {rel} ({size:,} bytes)' for rel, size in top)
    tail = (f'\n\n---\nSkill directory: {d}\nHelper files (open the ones SKILL.md tells you to, in full, with '
            f'skill_file name="{slug}" path="<file>"; nothing is summarized or cut):\n{listing}'
            + (f'\n  (+{rest} more files in deeper folders such as scripts/ and producer_handoff_kit/; list them with ls)' if rest else ''))
    return [text(f'# Skill: {slug}\n')] + blocks(body) + [text(tail)]

def skill_file(a):
    slug, v = find_skill(a.get('name'))
    d = os.path.realpath(v['path'])
    rel = str(a.get('path') or '').strip()
    p = os.path.realpath(rel if os.path.isabs(rel) else os.path.join(d, rel))
    if not p.startswith(d + os.sep) or not os.path.isfile(p):
        raise ToolError(f'no file "{rel}" in skill {slug} (paths are relative to {d})')
    body = open(p, encoding='utf-8', errors='replace').read()
    manifest('file', slug, os.path.relpath(p, d), p, len(body))
    return [text(f'# {slug}/{os.path.relpath(p, d)} ({len(body):,} chars, complete)\n')] + blocks(body)


# ---------------- shared task record + standard verification (PASS / FAIL / UNABLE_TO_VERIFY) ----------------
def tasklib():
    import tasklib as T
    return T

def need_job():
    if not job_dir():
        raise ToolError('no job folder known for this conversation')
    return job_dir()

def skills_loaded():
    out = []
    try:
        for line in open(os.path.join(job_dir(), 'log', 'read-manifest.jsonl')):
            r = json.loads(line)
            if r.get('kind') in ('skill', 'file'):
                k = f"{r.get('skill')}/{r.get('file')}"
                if k not in out:
                    out.append(k)
    except (OSError, ValueError, TypeError):
        pass
    return out

def task_reply(rec, head=''):
    T = tasklib()
    tail = ''
    if T.all_pass(rec):
        tail = ('\n\nALL CRITERIA PASS. The record is now in the deliver phase: the request is met. Call finish and write your final report to Rick now '
                '(deliverable paths, what each check measured). Do not gather more sources or re-check or polish passing work.')
    return [text((head + '\n\n' if head else '') + T.render(rec, skills_loaded()) + tail)]

def task_start(a):
    T, job = tasklib(), need_job()
    rec = T.load(job)
    if rec and not a.get('replace'):
        return task_reply(rec, 'A task record already exists (log/task.json); change it with task_update.')
    crit = [str(c) for c in (a.get('criteria') or []) if str(c).strip()]
    size = str(a.get('size') or ('big' if len(a.get('milestones') or []) > 4 else 'medium'))
    rec = T.new(str(a.get('goal') or '').strip() or '(goal not given)', size, crit, a.get('milestones') or [], str(a.get('notes') or ''))
    T.save(job, rec)
    return task_reply(rec, 'Task record created at log/task.json. Criteria change status only through `verify`.')

def task_update(a):
    T, job = tasklib(), need_job()
    rec = T.load(job)
    if not rec:
        raise ToolError('no task record yet; call task_start first')
    for c in a.get('add_criteria') or []:
        rec['criteria'].append({'id': f"C{len(rec['criteria']) + 1}", 'text': str(c), 'status': 'pending', 'evidence': '',
                                'findings': '', 'checked_at': None, 'check': None, 'fingerprint': None})
    for m in a.get('add_milestones') or []:
        rec['milestones'].append(T.milestone(len(rec['milestones']), m))
    if a.get('milestone'):
        key = str(a['milestone']).upper()
        m = next((x for x in rec['milestones'] if x['id'].upper() == key), None)
        if not m:
            raise ToolError(f"no milestone {a['milestone']}")
        m['status'] = str(a.get('status') or 'done')
        if m['status'] == 'done':
            m['done_at'] = T.now_et()
            rec['completed'].append(f"{m['id']} {m['text']}")
            try:
                cli('checkpoint', [f"{m['id']} done: {m['text']}" + (f" ({a['note']})" if a.get('note') else '')], timeout=30)
            except Exception:
                pass
    if a.get('completed'):
        rec['completed'].append(str(a['completed']))
    if a.get('notes'):
        rec['notes'] = str(a['notes'])
    T.save(job, rec)
    return task_reply(rec, 'Updated.')

def task_status(a):
    rec = tasklib().load(need_job())
    return task_reply(rec) if rec else [text('No task record yet. For a medium or big task, call task_start (goal, criteria, milestones).')]

def fingerprint(paths):
    import hashlib
    h = hashlib.sha256()
    for p in paths:
        try:
            st = os.stat(abspath(p)); h.update(f'{abspath(p)}:{st.st_size}:{st.st_mtime_ns}'.encode())
        except OSError:
            h.update(f'{p}:missing'.encode())
    return h.hexdigest()[:16]

def ffprobe_json(p):
    code, out, err = run(['ffprobe', '-v', 'error', '-show_entries', 'format=duration:stream=codec_type,width,height',
                          '-of', 'json', abspath(p)], timeout=60)
    if code:
        raise ToolError(f'ffprobe failed: {(err or out)[:200]}')
    return json.loads(out)

def check_media(a):
    p = a.get('path') or ''
    d = ffprobe_json(p)
    dur = float((d.get('format') or {}).get('duration') or 0)
    v = next((x for x in d.get('streams') or [] if x.get('codec_type') == 'video'), {})
    has_audio = any(x.get('codec_type') == 'audio' for x in d.get('streams') or [])
    found, ev = [], [f'{os.path.basename(p)}: {dur:.2f}s, {v.get("width")}x{v.get("height")}, audio={"yes" if has_audio else "no"}']
    if a.get('duration') is not None:
        tol = float(a.get('tolerance') if a.get('tolerance') is not None else 1.0)
        if abs(dur - float(a['duration'])) > tol:
            found.append(f'duration {dur:.2f}s, expected {a["duration"]}s ±{tol}')
    if a.get('height') and int(v.get('height') or 0) != int(a['height']):
        found.append(f'height {v.get("height")}, expected {a["height"]}')
    if a.get('width') and int(v.get('width') or 0) != int(a['width']):
        found.append(f'width {v.get("width")}, expected {a["width"]}')
    if a.get('audio') and not has_audio:
        found.append('no audio stream')
    if a.get('lufs') is not None and has_audio:
        code, out, err = run(['ffmpeg', '-nostats', '-i', abspath(p), '-af', 'ebur128', '-f', 'null', '-'], timeout=300)
        m = re.findall(r'I:\s+(-?[\d.]+) LUFS', err or '')
        if m:
            lu = float(m[-1]); ev.append(f'loudness {lu} LUFS')
            if abs(lu - float(a['lufs'])) > 2:
                found.append(f'loudness {lu} LUFS, expected {a["lufs"]} ±2')
    return ('FAIL' if found else 'PASS'), '; '.join(ev), '; '.join(found), [p]

def check_file(a):
    p = abspath(a.get('path') or '')
    if not os.path.isfile(p):
        return 'FAIL', '', f'{a.get("path")} does not exist', [p]
    size = os.path.getsize(p); found = []
    if size < int(a.get('min_bytes') or 1):
        found.append(f'only {size} bytes')
    if a.get('contains'):
        body = open(p, encoding='utf-8', errors='replace').read()
        if not re.search(a['contains'], body, re.M):
            found.append(f'pattern {a["contains"]!r} not found')
    return ('FAIL' if found else 'PASS'), f'{a.get("path")}: {size:,} bytes', '; '.join(found), [p]

def check_command(a):
    cmd = str(a.get('command') or '')
    if not cmd:
        raise ToolError('command is required')
    job = need_job(); os.makedirs(os.path.join(job, 'log', 'verify'), exist_ok=True)
    outp = os.path.join(job, 'log', 'verify', f'{int(time.time())}.txt')
    try:
        r = subprocess.run([f'{TOOLS}/job-sandbox', '--root', job, '--', 'bash', '-lc', cmd], cwd=job, capture_output=True, text=True, timeout=int(a.get('timeout') or 1800))
    except subprocess.TimeoutExpired:
        return 'UNABLE_TO_VERIFY', '', 'the check command did not finish', a.get('inputs') or []
    full = (r.stdout or '') + (r.stderr or '')
    open(outp, 'w').write(full)
    tail = full.strip()[-1500:]
    ev = f'exit {r.returncode}; full output {os.path.relpath(outp, job)}' + (f'; last lines: {tail}' if tail else '')
    return ('PASS' if r.returncode == 0 else 'FAIL'), ev, ('' if r.returncode == 0 else 'command failed, see output'), a.get('inputs') or []

def check_urls(a):
    import urllib.request
    bad, ok = [], []
    for u in a.get('urls') or []:
        try:
            req = urllib.request.Request(u, method='GET', headers={'User-Agent': 'Mozilla/5.0 agent-lab-verify'})
            with urllib.request.urlopen(req, timeout=30) as r:
                ok.append(f'{r.status} {u}')
        except Exception as e:
            bad.append(f'{u}: {str(e)[:80]}')
    if not ok and not bad:
        raise ToolError('urls is required')
    return ('FAIL' if bad else 'PASS'), '; '.join(ok), '; '.join(bad), []

def verify(a):
    """Run one check for one criterion and record PASS / FAIL / UNABLE_TO_VERIFY with evidence in log/task.json."""
    T, job = tasklib(), need_job()
    rec = T.load(job)
    if not rec:
        raise ToolError('no task record yet; call task_start with your success criteria first')
    try:
        c = T.find(rec, a.get('criterion'))
    except KeyError as e:
        raise ToolError(str(e))
    kind = str(a.get('kind') or '')
    extra = []
    paths = [x for x in ([a.get('path')] + list(a.get('paths') or []) + list(a.get('inputs') or [])) if x]
    fp = fingerprint(paths) + ':' + kind + ':' + json.dumps({k: a.get(k) for k in sorted(a) if k != 'criterion'}, sort_keys=True)[:400]
    if c['status'] == 'PASS' and c.get('fingerprint') == fp and not a.get('recheck'):
        return task_reply(rec, f"ALREADY PASSED: {c['id']} passed at {c['checked_at'][11:16]} ET on these exact inputs. Nothing to re-check.")
    try:
        if kind == 'media':
            status, ev, found, _ = check_media(a)
        elif kind == 'file':
            status, ev, found, _ = check_file(a)
        elif kind == 'command':
            status, ev, found, _ = check_command(a)
        elif kind == 'urls':
            status, ev, found, _ = check_urls(a)
        elif kind == 'images':
            res = view({**{k: a[k] for k in ('paths', 'fps', 'start', 'end', 'max', 'question') if a.get(k) is not None},
                        'paths': a.get('paths') or [a.get('path')], 'qa': not images_via_user_message()[2], 'recheck': bool(a.get('recheck')), '_scope': c['id']})
            head = res[0]['text'] if res and res[0].get('type') == 'text' else ''
            status = ('FAIL' if 'OPUS VERDICT: LOOKS BROKEN' in head or 'VERDICT: LOOKS BROKEN' in head else 'PASS' if 'OPUS VERDICT: PASS' in head or 'VERDICT: PASS' in head else 'UNABLE_TO_VERIFY')
            if status == 'UNABLE_TO_VERIFY' and images_via_user_message()[2] and 'OPUS VERDICT' not in head:
                own = str(a.get('status') or '').upper()
                if own in ('PASS', 'FAIL') and a.get('self_check'):
                    status = own
                    head = f"VERDICT: {'PASS' if own == 'PASS' else 'LOOKS BROKEN'} (your own judgment: {a['self_check']})\n" + head
                else:
                    head = ('VERDICT: none yet. You can see these images yourself: look at them, then call verify again for this '
                            'criterion with status PASS or FAIL and self_check describing what you saw.\n') + head
            m = re.search(r'VERDICT: [^\n]*', head)
            ev, found = (m.group(0) if m else head[:300]), ('' if status == 'PASS' else (m.group(0) if m else 'no verdict'))
            extra = res
            if status == 'PASS' and a.get('self_check'):
                ev += f"; your own judgment: {a['self_check']}"
        elif kind == 'manual':
            status = str(a.get('status') or '').upper()
            if status not in ('PASS', 'FAIL', 'UNABLE_TO_VERIFY') or not a.get('evidence'):
                raise ToolError('manual needs status (PASS/FAIL/UNABLE_TO_VERIFY) and evidence (what you measured or saw, with paths)')
            ev, found = f"(self-assessed) {a['evidence']}", str(a.get('findings') or '')
        else:
            raise ToolError('kind must be one of: media, images, file, command, urls, manual')
    except ToolError as e:
        if kind not in ('media', 'images', 'file', 'command', 'urls', 'manual') or 'manual needs' in str(e):
            raise
        status, ev, found = 'UNABLE_TO_VERIFY', '', str(e)
    c.update(status=status, evidence=ev, findings=found, checked_at=T.now_et(), check=kind,
             fingerprint=fp if status == 'PASS' else None)
    rec['history'].append({'at': c['checked_at'], 'criterion': c['id'], 'status': status, 'kind': kind})
    if a.get('milestone'):
        mk = str(a['milestone']).upper()
        for m in rec.get('milestones') or []:
            if m['id'].upper() == mk and c['id'].upper() not in [x.upper() for x in m.get('criteria') or []]:
                m.setdefault('criteria', []).append(c['id'])
    done_ms = T.auto_milestones(rec) if status == 'PASS' else []
    if T.all_pass(rec):
        rec['phase'] = 'deliver'
    T.save(job, rec)
    for m in done_ms:
        try:
            cli('checkpoint', [f"{m['id']} done (verified): {m['text']}"], timeout=30)
        except Exception:
            pass
    if status == 'PASS':
        try:
            cli('checkpoint', [f"{c['id']} PASS ({kind}): {c['text']}"], timeout=30)
        except Exception:
            pass
    head = {'PASS': f"{c['id']} PASS." + (' Milestone ' + ', '.join(m['id'] for m in done_ms) + ' marked done (verified).' if done_ms else ''), 'FAIL': f"{c['id']} FAIL: {found}. Only {c['id']} is open from this check; criteria already PASS keep their recorded result.",
            'UNABLE_TO_VERIFY': f"{c['id']} UNABLE_TO_VERIFY: {found}. Use another check kind, or report it as unverified."}[status]
    if status == 'FAIL':
        log_step_failure(f"{c['id']}: {found or ev}", kind=kind)
    out = task_reply(rec, head)
    return out + [x for x in extra[1:]] if extra else out

