HANDLERS = {n: f for n, f, _, _ in SPEC}

# ---------------- MCP stdio plumbing ----------------
OUT = threading.Lock()

def send(msg):
    data = json.dumps(msg, ensure_ascii=False)
    with OUT:
        sys.stdout.write(data + '\n'); sys.stdout.flush()

def call(mid, name, args):
    try:
        if name not in HANDLERS:
            raise ToolError(f'unknown tool {name}')
        content, err = HANDLERS[name](args or {}), False
    except ToolError as e:
        content, err = [text(str(e))], True
    except subprocess.TimeoutExpired as e:
        content, err = [text(f'timed out: {e}')], True
    except Exception as e:
        content, err = [text(f'{name} failed: {type(e).__name__}: {str(e)[:300]}')], True
    send({'jsonrpc': '2.0', 'id': mid, 'result': {'content': content, 'isError': err}})

def main():
    global JOB
    a = sys.argv[1:]
    def _resolve_job(j):
        if not j or j in ('auto', 'cwd'):
            j = os.environ.get('OPENHANDS_PROJECT_DIR') or os.environ.get('JOB') or os.getcwd()
        return (j or '').rstrip('/')
    if '--job' in a and a.index('--job') + 1 < len(a):
        j = _resolve_job(a[a.index('--job') + 1])
        if re.match(rf'^/workspace/jobs/{UUID}(/helpers/{UUID})*$', j):
            JOB = j
            os.makedirs(JOB, exist_ok=True)
            os.chdir(JOB)
    if JOB is None:
        j = _resolve_job(None)
        if re.match(rf'^/workspace/jobs/{UUID}(/helpers/{UUID})*$', j):
            JOB = j
            os.makedirs(JOB, exist_ok=True)
            os.chdir(JOB)
    inherit_env()
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        mid, method = msg.get('id'), msg.get('method')
        if method == 'initialize':
            pv = (msg.get('params') or {}).get('protocolVersion') or '2025-06-18'
            send({'jsonrpc': '2.0', 'id': mid, 'result': {
                'protocolVersion': pv, 'capabilities': {'tools': {'listChanged': False}},
                'serverInfo': {'name': 'agent', 'version': '1.0.0'},
                'instructions': 'Agent Lab tools. view returns images as its result with a QA verdict.'}})
        elif method == 'tools/list':
            desc = ('Load a skill: returns its full SKILL.md (never cut), its directory and the list of its helper files. '
                    'The runner already attaches the skills your task needs to your first message; load another one only '
                    'when AGENTS.md or a skill names it (list them with `ls /workspace/skills`). Then read the helper files '
                    'its SKILL.md names for your situation with skill_file.')
            send({'jsonrpc': '2.0', 'id': mid, 'result': {'tools': [
                {'name': n, 'description': desc if d == 'SKILL_DESCRIPTION' else d, 'inputSchema': s} for n, _, d, s in SPEC]}})
        elif method == 'tools/call':
            p = msg.get('params') or {}
            threading.Thread(target=call, args=(mid, p.get('name'), p.get('arguments')), daemon=True).start()
        elif method == 'ping':
            send({'jsonrpc': '2.0', 'id': mid, 'result': {}})
        elif mid is not None:
            send({'jsonrpc': '2.0', 'id': mid, 'error': {'code': -32601, 'message': f'method not found: {method}'}})

if __name__ == '__main__':
    main()
