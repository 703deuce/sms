#!/usr/bin/env python3
"""Hook: injects memory + skills into the conversation.
SessionStart  -> job folder, all shared facts and rules, a few recent facts, project list, skills index.
UserPromptSubmit -> facts relevant to the user's message (hybrid recall)."""
import json, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

def now_line():
    from datetime import datetime, timedelta
    from zoneinfo import ZoneInfo
    tz = 'America/New_York'
    n = datetime.now(ZoneInfo(tz))
    t = n + timedelta(days=1)
    return (f"[Clock] Now: {n.strftime('%A, %B %-d, %Y, %-I:%M %p %Z')} ({tz}). Today is {n.strftime('%A %b %-d')}; "
            f"tomorrow is {t.strftime('%A %b %-d')}. Read every relative date or time (today, tonight, tomorrow, Monday, "
            "next week) in this zone, and state all times to Rick in ET unless he asks otherwise.")


def vision_line(job):
    """Tell the agent whether its own model can see images (status written by the runner per conversation)."""
    import re
    ids = re.findall(r'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}', job or '')
    st = None
    if ids:
        try:
            st = json.load(open(f'/workspace/runs/vision/{ids[-1]}.json'))
        except Exception:
            st = None
    if st and st.get('vision'):
        return (f"[Vision] Your model ({st.get('model')}) can see images. Look at images, frames and screenshots yourself with "
                "the `agent_view` tool (images come back as its result, with a PASS / LOOKS BROKEN verdict); "
                "`watch-media` in the terminal for whole video+audio.")
    if st:
        return (f"[Vision] Your model ({st.get('model')}) is text-only here: use the `agent_look` tool (or `look` in the terminal) "
                "for images/frames and `watch-media` for whole video/audio.")
    return ('[Vision] Use the `agent_view` tool to see images yourself; if you cannot see what it returns, use `agent_look`.')


# Messages that come from the system (runner, tools, helpers, schedules), not typed by Rick.
SYSTEM_TAGS = ('[Recovery]', '[Step budget]', '[view]', '[Context restored]', '[Helper ', '[Vision helper ',
               '[Reminder you set earlier]', '[Scheduled run', '[Webhook', '[Goal check', '[Loop guard]', '[Skill gate]',
               '[Visual gate]', '[Browser ready]', '[Model routing]')


def open_questions():
    """Open ask-user questions (structured lookup, read-only)."""
    if os.path.exists('/opt/tools/flags/ASK_USER_OFF'):
        return ''
    import sqlite3
    try:
        db = sqlite3.connect('file:/workspace/runs/runs.db?mode=ro', uri=True, timeout=3)
        rows = db.execute("SELECT id, title, question, choices FROM questions WHERE status='open' ORDER BY created_at LIMIT 5").fetchall()
        db.close()
    except Exception:
        return ''
    return ''.join(f"\n- {r[0]} (job: {(r[1] or '')[:60]}): {r[2][:400]}" + (f' choices: {r[3]}' if r[3] not in (None, '[]') else '')
                   for r in rows)


def busy_run(job):
    """True when this conversation has a run in progress right now (structured lookup in runs.db, not message text)."""
    if os.path.exists('/opt/tools/flags/STEERING_OFF'):
        return False
    import re, sqlite3
    ids = re.findall(r'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}', job or '')
    if not ids:
        return False
    try:
        db = sqlite3.connect('file:/workspace/runs/runs.db?mode=ro', uri=True, timeout=3)
        cid = ids[-1]
        row = db.execute("SELECT 1 FROM runs WHERE status='running' AND (conversation_id=? OR conversation_id=?) LIMIT 1",
                         (cid, cid.replace('-', ''))).fetchone()
        db.close()
        return bool(row)
    except Exception:
        return False


def log_loaded(job, kind, ids):
    """Context manifest: which memories were put in front of the agent (same file as skill loads and images)."""
    if not ids or not str(job).startswith('/workspace/jobs/'):
        return
    try:
        from datetime import datetime
        from zoneinfo import ZoneInfo
        os.makedirs(f'{job}/log', exist_ok=True)
        with open(f'{job}/log/read-manifest.jsonl', 'a') as f:
            f.write(json.dumps({'at': datetime.now(ZoneInfo('America/New_York')).isoformat(timespec='seconds'),
                                'kind': kind, 'ids': list(ids)}) + '\n')
    except OSError:
        pass


def main():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        payload = {}
    event = payload.get('event_type') or os.environ.get('OPENHANDS_EVENT_TYPE', '')
    job = payload.get('working_dir') or os.environ.get('OPENHANDS_PROJECT_DIR', '')
    sysmsg = event == 'UserPromptSubmit' and str(payload.get('message') or '').lstrip().startswith(SYSTEM_TAGS)
    out = [now_line()] + ([] if sysmsg else [vision_line(job)]) if event in ('SessionStart', 'UserPromptSubmit') else []
    try:
        import memlib as m
        db = m.connect()
    except Exception as e:
        db = None
        out.append(f'(memory unavailable: {e})')
    if event == 'SessionStart':
        out.append(f'# Session context (auto-loaded)\nYour job folder for this conversation is `{job}`. Work only inside it. For file_editor, use absolute paths under that folder. '
                   '(plus /tmp). Never delete or move anything outside it.')
        if db is not None:
            rows = db.execute(f'''SELECT id, bot_id, type, text, created_at FROM facts f WHERE {m.active_clause()}
                                  AND (bot_id='shared' OR type='rule') ORDER BY type, id DESC LIMIT 40''', m.scopes()).fetchall()
            seen = {r[0] for r in rows}
            recent = [r for r in db.execute(f'''SELECT id, bot_id, type, text, created_at FROM facts f WHERE {m.active_clause()}
                                  ORDER BY id DESC LIMIT 15''', m.scopes()).fetchall() if r[0] not in seen][:8]
            facts = rows + recent
            log_loaded(job, 'memory-session-start', [r[0] for r in facts])
            out.append('\n## Long-term memory (rules, shared facts, recent facts)\n' +
                       ('\n'.join(m.fmt(r) for r in facts) if facts else '(no facts saved yet)') +
                       '\nMore: `recall "query"`. Save new ones with `remember`.')
        pdir = '/workspace/memory/projects'
        if os.path.isdir(pdir):
            projs = sorted(f[:-3] for f in os.listdir(pdir) if f.endswith('.md'))
            if projs:
                out.append('\n## Project notes\n' + ', '.join(projs) + '  (read with `project-note <slug>`)')
        try:
            import skilllib as s
            sk = s.all_skills()
            out.append('\n## Skills\nThe runner attaches the skills your task needs (see your first message). '
                       f'{len(sk)} are installed; load another with `agent_skill` only when AGENTS.md or a skill names it '
                       '(`ls /workspace/skills` lists them).')
        except Exception as e:
            out.append(f'(skills unavailable: {e})')
    elif event == 'UserPromptSubmit' and db is not None:
        full = str(payload.get('message') or '')
        msg = full[:2000]
        from_system = full.lstrip().startswith(SYSTEM_TAGS)
        is_jobdir = job.startswith('/workspace/jobs/') and msg.strip()
        try:
            continuation = full.lstrip().startswith(('[Recovery]', '[Step budget]', '[view]', '[Context restored]'))
            if is_jobdir and not continuation and not os.path.exists(f'{job}/log/goal.md'):
                # pin the original goal: the first message of the conversation (Rick's, or a routine's task)
                os.makedirs(f'{job}/log', exist_ok=True)
                with open(f'{job}/log/goal.md', 'w') as f:
                    f.write('# Original goal (first message of this conversation)\n\n' + full + '\n')
            elif is_jobdir and not from_system:
                # a later message from Rick: keep a durable log, and mark it as the newest instruction
                from datetime import datetime
                from zoneinfo import ZoneInfo
                ts = datetime.now(ZoneInfo('America/New_York')).strftime('%a %b %-d, %-I:%M %p ET')
                with open(f'{job}/log/instructions.md', 'a') as f:
                    f.write(f'\n## {ts}\n{full.strip()}\n')
                if busy_run(job):
                    out.append("[Steering] Rick sent this while you were in the middle of the task. Apply it from your "
                               'very next step without restarting: keep finished work that still fits, change course '
                               'where he says, stop anything he tells you to stop, and acknowledge it in one line in your '
                               'next reply. If it is only a question (status, ETA), answer briefly and keep working. '
                               '(Saved to log/instructions.md; where it differs from the original request or plan, this '
                               'message wins.)')
                else:
                    out.append("[Newest instruction] This message is Rick's latest instruction in this conversation "
                               '(also saved to log/instructions.md). Where it differs from the original request, an earlier '
                               'plan or a summary, follow this one.')
        except Exception:
            pass
        if msg.strip() and not from_system:
            rows = m.search(db, msg, 8)
            log_loaded(job, 'memory-recall', [r[0] for r in rows or []])
            if rows:
                out.append('[Memory: facts that may be relevant to this message]\n' + '\n'.join(m.fmt(r) for r in rows))
    if event == 'UserPromptSubmit' and not str(payload.get('message') or '').lstrip().startswith(SYSTEM_TAGS):
        oq = open_questions()
        if oq:
            out.append('[Open questions from paused background jobs] ' + oq + '\nIf Rick\'s message answers one of these, '
                       'record it with `answer <id> "his answer in his words"` (the job resumes by itself) and confirm in one '
                       'line. If it does not, ignore this list. When he asks what is pending, list these.')
    if out:
        print(json.dumps({'additionalContext': '\n'.join(out)}))

if __name__ == '__main__':
    main()
