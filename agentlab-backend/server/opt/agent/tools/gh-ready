#!/bin/bash
# gh-ready: set up git/gh to use the signed-in user's own GitHub token (vault secret GITHUB_TOKEN). Prints status only, never the token.
# The token comes from the Agent Lab secrets page (name GITHUB_TOKEN); each user stores their own, no shared org token.
if [ -z "${GITHUB_TOKEN:-}" ]; then
  echo '{"ok":false,"need":"GITHUB_TOKEN","how":"user adds a secret named GITHUB_TOKEN (their own fine-grained PAT) on the Agent Lab secrets page"}'; exit 1
fi
git config --global credential.https://github.com.helper '!gh auth git-credential' 2>/dev/null
git config --global url."https://github.com/".insteadOf "git@github.com:" 2>/dev/null
who=$(gh api user -q .login 2>/dev/null)
if [ -n "$who" ]; then echo "{\"ok\":true,\"login\":\"$who\"}"; else echo '{"ok":false,"error":"token present but GitHub rejected it (expired or missing scopes)"}'; exit 1; fi
