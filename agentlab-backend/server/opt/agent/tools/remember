#!/usr/bin/env python3
"""remember: save a long-term fact.

usage: remember [--type rule|person|project|preference|fact|tool]
  --type tool  "<tool>: what works" (one note per tool; a new note for the same tool replaces the old one) [--shared] [--replace ID] "text"
       remember --reindex        (backfill missing embeddings)
  --shared     visible to every bot (default: only this bot, $BOT_ID)
  --replace ID the new fact supersedes fact #ID (kept for history, hidden from recall)
Near-duplicates are not saved twice; you'll be shown the existing fact instead.
"""
import os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import memlib as m

a = sys.argv[1:]
if not a or a[0] in ('-h', '--help'):
    print(__doc__); sys.exit(0)
db = m.connect()
if a[0] == '--reindex':
    rows = db.execute('SELECT id, text FROM facts WHERE id NOT IN (SELECT rowid FROM facts_vec)').fetchall()
    done = 0
    for fid, text in rows:
        v = m.embed(text)
        if v:
            db.execute('INSERT INTO facts_vec(rowid, embedding) VALUES (?, ?)', (fid, m.pack(v))); done += 1
    db.commit(); print(f'reindexed {done}/{len(rows)}'); sys.exit(0)
typ, shared, replace, words = 'fact', False, None, []
i = 0
while i < len(a):
    if a[i] == '--type': typ = a[i + 1]; i += 2
    elif a[i] == '--shared': shared = True; i += 1
    elif a[i] == '--replace': replace = int(a[i + 1].lstrip('#')); i += 2
    else: words.append(a[i]); i += 1
text = ' '.join(words).strip()
if typ not in m.TYPES: sys.exit(f'remember: --type must be one of {", ".join(m.TYPES)}')
if not text: sys.exit('remember: no text')
bot = 'shared' if shared else m.BOT
if typ == 'tool':
    # tool notes stay one per tool: "<tool>: what works". A new note for the same tool replaces the old one.
    if ':' not in text[:60]:
        sys.exit('remember: a tool note starts with the tool name and a colon, e.g. "yt-dlp: use --cookies-from-browser chromium for IG"')
    key = text.split(':', 1)[0].strip().lower()
    if not replace:
        prev = [r for r in db.execute(f"SELECT id, text FROM facts f WHERE type='tool' AND {m.active_clause()}", m.scopes()).fetchall()
                if r[1].split(':', 1)[0].strip().lower() == key]
        if prev:
            replace = prev[-1][0]
if replace:
    old = db.execute('SELECT id, replaced_by, bot_id FROM facts WHERE id=?', (replace,)).fetchone()
    if not old: sys.exit(f'remember: no fact #{replace}')
    if old[2] not in m.scopes(): sys.exit(f'remember: fact #{replace} belongs to another bot')
same = db.execute(f'SELECT id, bot_id, type, text, created_at FROM facts f WHERE lower(text)=lower(?) AND {m.active_clause()}',
                  (text, *m.scopes())).fetchone()
if same and same[0] != replace:
    print('Already remembered:', m.fmt(same)); sys.exit(0)
v = m.embed(text)
if v and not replace:
    near = db.execute('SELECT rowid, distance FROM facts_vec WHERE embedding MATCH ? AND k = 8 ORDER BY distance', (m.pack(v),)).fetchall()
    live = {r[0]: r for r in db.execute(f'SELECT id, bot_id, type, text, created_at FROM facts f WHERE {m.active_clause()}', m.scopes())}
    near = [(fid, d) for fid, d in near if fid in live]
    if near and near[0][1] < 0.06:
        print('Already remembered (near-duplicate):', m.fmt(live[near[0][0]]))
        print('If the new wording should win, run: remember --replace', near[0][0], '...'); sys.exit(0)
    similar = [live[fid] for fid, d in near if d < 0.25]
else:
    similar = []
cur = db.execute('INSERT INTO facts(bot_id, type, text, created_at, source) VALUES (?,?,?,?,?)',
                 (bot, typ, text, m.now(), m.source_from_cwd()))
fid = cur.lastrowid
if v: db.execute('INSERT INTO facts_vec(rowid, embedding) VALUES (?, ?)', (fid, m.pack(v)))
if replace: db.execute('UPDATE facts SET replaced_by=? WHERE id=?', (fid, replace))
db.commit()
print(f'Saved #{fid} [{typ}] ({"shared" if shared else bot})' + (f', replacing #{replace}' if replace else ''))
if similar:
    print('Related facts already saved (if one is now wrong, run `remember --replace <id> "..."` or `forget <id>`):')
    for r in similar[:4]: print('  ' + m.fmt(r))
