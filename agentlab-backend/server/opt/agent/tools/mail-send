#!/usr/bin/env python3
"""mail-send: send email from your AgentMail inbox (every send is logged).

usage: mail-send --reply MESSAGE_ID "text"                      reply to a message in your inbox (to its sender)
       mail-send --to ADDRESS --subject "Subject" "text"         new email: for now ONLY to Rick's own addresses
                 [--cc ADDRESS] [--html FILE] [--attach FILE]    (run mail-address to see them)
       mail-send --log                                           show recent sends

--attach FILE may be repeated. If an attachment cannot be sent (missing file,
unreadable, empty, too large for AgentMail's 6 MB inline limit, or rejected by
the mail API), the tool returns a clear error and does not send a message with
the file silently dropped.
"""
import argparse, base64, json, mimetypes, os, sys
sys.path.insert(0, '/opt/tools')
import keyclient as K

ap = argparse.ArgumentParser(add_help=False)
ap.add_argument('text', nargs='?')
ap.add_argument('--reply')
ap.add_argument('--to', action='append', default=[])
ap.add_argument('--cc', action='append', default=[])
ap.add_argument('--subject')
ap.add_argument('--html')
ap.add_argument('--attach', action='append', default=[], metavar='FILE')
ap.add_argument('--log', action='store_true')
ap.add_argument('-h', '--help', action='store_true')
a = ap.parse_args()
if a.help:
    print(__doc__); sys.exit(0)
if a.log:
    code, r = K.req('GET', '/mail/sendlog?n=20')
    print('\n'.join(json.dumps(x) for x in r.get('sends') or []) or '(no sends)'); sys.exit(0)
if not a.text:
    K.die('message text required')
body = {'text': a.text, 'by': os.environ.get('CONVERSATION_ID')}
if a.html:
    try:
        body['html'] = open(a.html).read()
    except Exception as e:
        K.die(f'cannot read --html {a.html}: {e}')
atts = []
for path in a.attach:
    if not os.path.isfile(path):
        K.die(f'attachment not found (not sent): {path}')
    try:
        data = open(path, 'rb').read()
    except Exception as e:
        K.die(f'cannot read attachment {path} (not sent): {e}')
    if not data:
        K.die(f'attachment is empty (not sent): {path}')
    mt = mimetypes.guess_type(path)[0] or 'application/octet-stream'
    atts.append({
        'filename': os.path.basename(path),
        'content_type': mt,
        'content': base64.b64encode(data).decode(),
    })
if atts:
    body['attachments'] = atts
if a.reply:
    code, r = K.req('POST', '/mail/reply', {'message_id': a.reply, **body})
else:
    if not a.to or not a.subject:
        K.die('new email needs --to and --subject (or use --reply MESSAGE_ID)')
    code, r = K.req('POST', '/mail/send', {'to': a.to, 'cc': a.cc, 'subject': a.subject, **body})
if code != 200:
    K.die(f"not sent ({code}): {r.get('error') or r.get('message') or r}")
# If we asked to attach files, the proxy must have accepted them. A bare 200
# with no attachments in a drop-old-proxy would be a silent drop — treat as error.
if atts:
    confirmed = r.get('attachments_sent')
    expected = [x['filename'] for x in atts]
    if confirmed != expected:
        K.die('attachment not confirmed (not a successful attachment send): '
              f'wanted {expected}, proxy confirmed {confirmed!r}. '
              'The message may have gone out without the file. Do not ignore this.')
out = {'sent': True, 'message_id': r.get('message_id'), 'thread_id': r.get('thread_id')}
if atts:
    out['attachments'] = [x['filename'] for x in atts]
print(json.dumps(out))
