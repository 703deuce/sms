#!/usr/bin/env python3
"""run-script: run ONE Python script that calls Agent Lab tools in a loop (labtools: search, read_page, fetch,
read_file, write_file, sh), so a bulk job takes one step and only the script's printed output comes back.

usage: run-script script.py [--timeout 300] [--max-output 8000]
  The script runs in your job folder's sandbox (writes only there and in /tmp), with a hard timeout and at most 60
  tool calls. Print a short summary; write big results to a file. Full output is saved to log/scripts/<name>-<time>.log.
  Example script:
      from labtools import search, read_page
      for q in ["brewery Asheville", "brewery Durham"]:
          for h in search(q, n=5): print(h["title"], h["url"])
Off switch: /opt/tools/flags/RUN_SCRIPT_OFF."""
import os, subprocess, sys, time

a = sys.argv[1:]
if not a or a[0] in ('-h', '--help'):
    print(__doc__); sys.exit(0)
if os.path.exists('/opt/tools/flags/RUN_SCRIPT_OFF'):
    sys.exit('run-script is switched off; use the terminal and the tools directly.')
script, timeout, cap = None, 300, 8000
i = 0
while i < len(a):
    if a[i] == '--timeout':
        timeout = max(5, min(int(a[i + 1]), 900)); i += 2
    elif a[i] == '--max-output':
        cap = max(500, min(int(a[i + 1]), 30000)); i += 2
    else:
        script = a[i]; i += 1
if not script or not os.path.isfile(script):
    sys.exit(f'run-script: no such script: {script}')
script = os.path.abspath(script)
sys.path.insert(0, '/opt/tools')
try:
    import landlocklib  # noqa: F401
    jroot = None
    import re
    m = re.match(r'^(/workspace/jobs/[0-9a-f-]{36}(?:/helpers/[0-9a-f-]{36})*)', os.path.realpath(os.getcwd()))
    jroot = m.group(1) if m else None
except Exception:
    jroot = None
cmd = ['/opt/tools/job-sandbox'] + (['--root', jroot] if jroot else []) + ['--', sys.executable, '-u', script]
env = dict(os.environ, PYTHONPATH='/opt/tools' + (':' + os.environ['PYTHONPATH'] if os.environ.get('PYTHONPATH') else ''))
logdir = os.path.join(jroot or os.getcwd(), 'log', 'scripts')
os.makedirs(logdir, exist_ok=True)
logf = os.path.join(logdir, f"{os.path.basename(script).rsplit('.', 1)[0]}-{time.strftime('%H%M%S')}.log")
t0 = time.time()
with open(logf, 'w') as lf:
    try:
        p = subprocess.run(cmd, stdout=lf, stderr=subprocess.STDOUT, timeout=timeout, env=env, cwd=os.getcwd())
        rc = p.returncode
    except subprocess.TimeoutExpired:
        rc = 124
out = open(logf, errors='replace').read()
secs = round(time.time() - t0, 1)
if len(out) > cap:
    out = out[:cap * 2 // 3] + f'\n... [{len(out) - cap} chars cut; full output: {logf}] ...\n' + out[-cap // 3:]
sys.stdout.write(out)
print(f'\n[run-script] exit {rc}' + (' (timed out)' if rc == 124 else '') + f' in {secs}s; full log: {logf}')
sys.exit(rc)
