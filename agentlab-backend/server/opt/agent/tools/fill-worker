#!/usr/bin/env python3
"""Internal: runs in the container, called ONLY by the host vault service (vaultd) with credentials on stdin.
Types them into the matching login page via CDP. Prints a status JSON that never contains the values."""
import json, re, sys
from urllib.parse import urlparse

USER_SEL = ("input[autocomplete=username], input[type=email], input[name*=email i], input[name*=user i], input[name*=login i], "
            "input[id*=email i], input[id*=user i], input[id*=login i], input[type=text]")
PASS_SEL = "input[type=password]"
OTP_SEL = ("input[autocomplete=one-time-code], input[name*=otp i], input[name*=totp i], input[name*=code i], input[name*=token i], "
           "input[id*=otp i], input[id*=code i], input[inputmode=numeric]")

def norm(h): return re.sub(r"[^A-Z0-9]+", "_", h.upper()).strip("_")

def visible(pg, sel):
    for el in pg.locator(sel).all():
        try:
            if el.is_visible() and el.is_enabled(): return el
        except Exception: pass
    return None

def main():
    req = json.loads(sys.stdin.read())
    key = req["site_key"]; mode = req["mode"]
    from playwright.sync_api import sync_playwright
    with sync_playwright() as p:
        b = p.chromium.connect_over_cdp("http://127.0.0.1:9222")
        pages = [pg for c in b.contexts for pg in c.pages if pg.url.startswith("http")]
        cand = []
        for pg in pages:
            h = norm(urlparse(pg.url).hostname or "")
            if h == key or h.endswith("_" + key) or key.endswith("_" + h): cand.append(pg)
        if not cand:
            print(json.dumps({"ok": False, "error": "no open tab on that site; open the login page first (desktop-open URL)"})); return
        pg = cand[-1]; filled = []
        if mode == "totp":
            el = visible(pg, OTP_SEL)
            if not el: print(json.dumps({"ok": False, "error": "no one-time-code field visible on the page"})); return
            el.fill(req["code"]); filled.append("otp"); last = el
        else:
            u = visible(pg, USER_SEL) if req.get("user") is not None else None
            pw = visible(pg, PASS_SEL)
            last = None
            if u and (mode in ("login", "user")):
                u.fill(req["user"]); filled.append("username"); last = u
                if not pw and mode == "login":      # two-step login: submit username, wait for password field
                    u.press("Enter")
                    try: pg.wait_for_selector(PASS_SEL, state="visible", timeout=9000)
                    except Exception: pass
                    pw = visible(pg, PASS_SEL)
            if pw and mode in ("login", "pass"):
                pw.fill(req["password"]); filled.append("password"); last = pw
            if not filled:
                print(json.dumps({"ok": False, "error": "no login fields visible on the page"})); return
        submitted = False
        if req.get("submit") and last is not None:
            last.press("Enter"); submitted = True
            try: pg.wait_for_load_state("domcontentloaded", timeout=8000)
            except Exception: pass
        print(json.dumps({"ok": True, "filled": filled, "submitted": submitted,
                          "page": (urlparse(pg.url).hostname or "")}))
        b.close()

main()
