{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://transovo.example/schemas/common.schema.json",
 "$defs": {
  "assetId": {
   "type": "string",
   "pattern": "^ast_[a-f0-9]{32}$"
  },
  "fontId": {
   "type": "string",
   "pattern": "^fnt_[a-f0-9]{32}(\\.[0-9]+)?$"
  },
  "bundleId": {
   "type": "string",
   "pattern": "^bnd_[a-f0-9]{32}$"
  },
  "anyAsset": {
   "type": "string",
   "pattern": "^(ast|fnt|bnd)_[a-f0-9]{32}(\\.[0-9]+)?$"
  },
  "hex": {
   "type": "string",
   "pattern": "^#[0-9A-Fa-f]{6}$"
  },
  "sha": {
   "type": "string",
   "pattern": "^[a-f0-9]{64}$"
  },
  "iso": {
   "type": "string",
   "format": "date-time"
  },
  "fontSel": {
   "type": "object",
   "required": [
    "faces"
   ],
   "additionalProperties": false,
   "properties": {
    "faces": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "pattern": "^fnt_[a-f0-9]{32}(\\.[0-9]+)?$"
     }
    },
    "weight": {
     "type": "number",
     "minimum": 1,
     "maximum": 1000
    },
    "style": {
     "enum": [
      "normal",
      "italic"
     ]
    },
    "label": {
     "type": "string"
    }
   }
  },
  "sceneId": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_-]{1,64}$"
  }
 }
}
