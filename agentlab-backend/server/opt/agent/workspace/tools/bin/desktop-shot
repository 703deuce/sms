#!/usr/bin/env python3
"""desktop-shot: screenshot the agent desktop.

usage: desktop-shot [-o out.png]
Default output: desktop-shot.png in the current directory (or /workspace/desktop/shot.png).
Then look at it with: look out.png "what is on the screen?"
"""
import os, sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _desktop import api, die

def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(__doc__); return
    out = "desktop-shot.png"
    if "-o" in args:
        out = args[args.index("-o") + 1]
    elif args and not args[0].startswith("-"):
        out = args[0]
    try:
        _, raw, headers = api("GET", "/shot")
    except Exception as e:
        die("desktop-shot", str(e))
    if (headers.get("Content-Type") or "").startswith("application/json") or not raw:
        die("desktop-shot", "screenshot failed")
    os.makedirs(os.path.dirname(out) or ".", exist_ok=True)
    with open(out, "wb") as f:
        f.write(raw)
    print(f"wrote {out} ({len(raw)} bytes)")

if __name__ == "__main__":
    main()
