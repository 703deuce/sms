#!/usr/bin/env python3
"""image-gen: generate an image with Gemini Nano Banana (gemini-nano-banana-2.1).

usage: image-gen "prompt" [--ref img] [-o out.png] [--size 1K|2K|4K] [--aspect 1:1] [--model MODEL]
  --ref      optional reference image (repeatable)
  -o         output path (default: image-gen.png)
  --size     1K (default, cheapest), 2K, or 4K
  --aspect   e.g. 1:1, 16:9, 9:16
Needs GEMINI_API_KEY. Appends a usage line to /workspace/usage/usage.jsonl.
"""
import os, sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _image import generate, DEFAULT_MODEL, die


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        return
    prompt_parts, refs, out, size, aspect, model = [], [], "image-gen.png", "1K", "1:1", DEFAULT_MODEL
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("-o", "--out"):
            out = args[i + 1]; i += 2
        elif a == "--ref":
            refs.append(args[i + 1]); i += 2
        elif a == "--size":
            size = args[i + 1]; i += 2
        elif a == "--aspect":
            aspect = args[i + 1]; i += 2
        elif a == "--model":
            model = args[i + 1]; i += 2
        elif a.startswith("-"):
            die(f"unknown option {a}")
        else:
            prompt_parts.append(a); i += 1
    for r in refs:
        if not os.path.exists(r):
            die(f"reference not found: {r}")
    generate(" ".join(prompt_parts), refs, out, size=size, aspect=aspect, model=model, tool="image-gen")


if __name__ == "__main__":
    main()
