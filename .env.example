# Public app URL (webhooks + tracking links)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Supabase (same as Local SEO Express) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Apply tables once: paste supabase/schema.sql into the Supabase SQL editor.
# Telnyx additive columns: supabase/telnyx-provider-fields.sql
# Campaign library + growth tools: supabase/product-library-fields.sql

# --- Messaging provider ---
# mock (default) | twilio | telnyx
# MESSAGING_PROVIDER=mock

# --- Telnyx (preferred for new customers) ---
# TELNYX_API_KEY=
# TELNYX_PUBLIC_KEY=                 # Ed25519 public key for webhook signatures
# TELNYX_ORG_ID=
# TELNYX_MODE=live
# TELNYX_API_BASE_URL=https://api.telnyx.com/v2
# TELNYX_USE_TWEXIT=false
# Platform admin profile only — never use for customer sending:
# TELNYX_DEFAULT_MESSAGING_PROFILE_ID=
# TELNYX_CONNECTION_ID=
# TELNYX_APPLICATION_ID=
# Webhooks (auto-built from APP_URL):
#   POST /api/telnyx/messaging   — inbound + delivery (messaging profile)
#   POST /api/telnyx/compliance  — 10DLC brand/campaign events

# --- Twilio ISV (retained for rollback; do not delete until Telnyx verified) ---
# TWILIO_ACCOUNT_SID=AC…
# TWILIO_ACCOUNT_AUTH_TOKEN=
# TWILIO_PRIMARY_PROFILE_SID=BU…
# TWILIO_MODE=live
# MESSAGING_ADAPTER=twilio
# TWILIO_STATUS_EMAIL=compliance@yourdomain.com

# Encrypt subaccount auth tokens at rest (Twilio path)
# INTEGRATION_SECRET_KEY=

# Cron auth for POST /api/jobs/process
# CRON_SECRET=

# Optional Redis / BullMQ
# QUEUE_DRIVER=bullmq
# REDIS_URL=rediss://...

# Optional email (campaign email steps)
# BREVO_API_KEY=
# REVIEW_REQUEST_FROM_EMAIL=noreply@transovo.ai
# REVIEW_REQUEST_FROM_NAME=Transovo AI
# REVIEW_LINK_FALLBACK=https://transovo.ai
