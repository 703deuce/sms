# Public app URL (Twilio webhooks + tracking links)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Supabase (same as Local SEO Express) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma / migrations still need the Supabase Postgres URI while the data layer
# finishes moving to supabase-js. Get it from:
# Supabase → Project Settings → Database → Connection string (URI)
# Use the pooler (6543) for the app, direct (5432) for migrate/push if needed.
DATABASE_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# --- Twilio ISV (parent account) ---
# TWILIO_ACCOUNT_SID=AC…
# TWILIO_ACCOUNT_AUTH_TOKEN=
# TWILIO_PRIMARY_PROFILE_SID=BU…
# TWILIO_MODE=live
# MESSAGING_ADAPTER=twilio
# TWILIO_STATUS_EMAIL=compliance@yourdomain.com

# Encrypt subaccount auth tokens at rest
# INTEGRATION_SECRET_KEY=

# Cron auth for POST /api/jobs/process
# CRON_SECRET=

# Optional Redis / BullMQ
# QUEUE_DRIVER=bullmq
# REDIS_URL=rediss://...

# Optional email (campaign email steps)
# BREVO_API_KEY=
# REVIEW_REQUEST_FROM_EMAIL=noreply@transovo.ai
# REVIEW_REQUEST_FROM_NAME=Transovo AI
# REVIEW_LINK_FALLBACK=https://transovo.ai
