# PostgreSQL connection (required for Prisma migrate/seed; UI works with mock data without DB)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/transovo_sms?schema=public"

# Public app URL (Twilio webhooks + tracking links)
APP_URL="http://localhost:3000"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Twilio ISV (parent account) ---
# TWILIO_ACCOUNT_SID=AC…
# Parent auth token (TrustHub + webhook signatures). Aliases: TWILIO_PARENT_AUTH_TOKEN, TWILIO_WEBHOOK_AUTH_TOKEN
# TWILIO_ACCOUNT_AUTH_TOKEN=
# TWILIO_AUTH_TOKEN=
# Optional API key pair (legacy parent send path)
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# Approved ISV Primary Customer Profile
# TWILIO_PRIMARY_PROFILE_SID=BU…
# Turn on live adapter (otherwise mock)
# TWILIO_MODE=live
# MESSAGING_ADAPTER=twilio
# TWILIO_STATUS_EMAIL=compliance@yourdomain.com
# MESSAGING_NUMBER_GRACE_DAYS=14

# Encrypt subaccount auth tokens at rest (required in production / live mode)
# INTEGRATION_SECRET_KEY=generate-a-long-random-secret

# Cron auth for POST /api/jobs/process
# CRON_SECRET=generate-a-random-secret

# Optional Redis / BullMQ workers
# QUEUE_DRIVER=bullmq
# REDIS_URL=redis://localhost:6379

# Optional email channel (campaign email steps)
# BREVO_API_KEY=
# REVIEW_LINK_FALLBACK=https://transovo.ai

# Optional: NextAuth secret if upgrading to full Auth.js session
# AUTH_SECRET=generate-a-random-secret
