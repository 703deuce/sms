# Public app URL (webhooks + tracking links)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Supabase API (app runtime — same as Local SEO Express) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres (schema control — required for Cursor / Prisma) ---
# Supabase → Connect → Session pooler URI (port 5432).
# URL-encode special characters in the password (! → %21, @ → %40, etc.).
# Example:
# DATABASE_URL="postgresql://postgres.YOUR_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
#
# Once set, Cursor can apply the full schema with:
#   npm run db:push
DATABASE_URL=

# --- Messaging provider ---
# mock (default) | twilio | telnyx
# MESSAGING_PROVIDER=mock

# --- Telnyx (preferred for new customers) ---
# TELNYX_API_KEY=
# TELNYX_PUBLIC_KEY=                 # Ed25519 public key for webhook signatures
# TELNYX_ORG_ID=
# TELNYX_MODE=live
# TELNYX_API_BASE_URL=https://api.telnyx.com/v2
# TELNYX_USE_TWEXIT=false
# Platform admin profile only — never use for customer sending:
# TELNYX_DEFAULT_MESSAGING_PROFILE_ID=
# Voice Call Control Application id (NOT softphone credential id):
# TELNYX_CONNECTION_ID=
# Optional: reuse a specific Outbound Voice Profile (otherwise Transovo creates/attaches one):
# TELNYX_OUTBOUND_VOICE_PROFILE_ID=
# Softphone WebRTC credential (separate from Call Control):
# TELNYX_TELEPHONY_CREDENTIAL_ID=
# TELNYX_APPLICATION_ID=
# TELNYX_TEXML_APP_ID=
# Webhooks (auto-built from APP_URL):
#   POST /api/telnyx/messaging   — inbound + delivery (messaging profile)
#   POST /api/telnyx/voice       — Call Control + AI voice events
#   POST /api/telnyx/compliance  — 10DLC brand/campaign events
# Number buy dual-provisions messaging_profile_id + connection_id automatically.

# --- Twilio ISV (retained for rollback; do not delete until Telnyx verified) ---
# TWILIO_ACCOUNT_SID=AC…
# TWILIO_ACCOUNT_AUTH_TOKEN=
# TWILIO_PRIMARY_PROFILE_SID=BU…
# TWILIO_MODE=live
# MESSAGING_ADAPTER=twilio
# TWILIO_STATUS_EMAIL=compliance@yourdomain.com

# Encrypt subaccount auth tokens at rest (Twilio path) + CRM OAuth tokens / state HMAC
# INTEGRATION_SECRET_KEY=

# --- ElevenLabs (TTS via Telnyx AI Assistants; never expose to the browser) ---
# Paid ElevenLabs API key. Stored as Telnyx integration secret identifier elevenlabs_transovo.
# ELEVENLABS_KEY=
# ELEVENLABS_API_KEY=   # alias accepted

# --- Native OAuth (Calendly / Typeform / …) ---
# Callback (exact, no trailing slash):
#   {APP_URL}/api/integrations/native/calendly/callback
# Webhook ingest:
#   {APP_URL}/api/integrations/native/webhooks/calendly?token=…
# CALENDLY_CLIENT_ID=
# CALENDLY_CLIENT_SECRET=
# Signing key from Calendly developer OAuth app (either name works):
# CALENDLY_WEBHOOK_SIGNING_KEY=
# CALENDLY_WEBHOOK_SECRET=
# Note: Calendly webhook *subscriptions* require Standard/Teams/Enterprise.
# Free plans still sync via incremental reconciliation.

# --- CRM OAuth (Salesforce + Zoho CRM + Pipedrive) ---
# Register these EXACT callbacks in the provider consoles (NOT Coolify env vars):
#   {APP_URL}/api/crm/salesforce/callback
#   {APP_URL}/api/crm/zoho/callback
#   {APP_URL}/api/crm/pipedrive/callback
# Example with APP_URL=https://transovo.ai:
#   https://transovo.ai/api/crm/salesforce/callback
#   https://transovo.ai/api/crm/zoho/callback
#   https://transovo.ai/api/crm/pipedrive/callback
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# Optional HMAC for generic inbound webhook route (CDC/Streaming not subscribed):
# SALESFORCE_WEBHOOK_SECRET=
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# Optional Zoho Accounts host override (normally derived from OAuth callback location):
# ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
# ZOHO_WEBHOOK_SECRET=
# PIPEDRIVE_CLIENT_ID=
# PIPEDRIVE_CLIENT_SECRET=
# PIPEDRIVE_WEBHOOK_SECRET=
# CRM_WEBHOOK_SECRET=

# Cron auth for POST /api/jobs/process
# CRON_SECRET=

# Optional Redis / BullMQ
# QUEUE_DRIVER=bullmq
# REDIS_URL=rediss://...

# --- Voice runtime provider ---
# livekit (default for dev) | telnyx (legacy Telnyx AI Assistant)
# VOICE_RUNTIME_PROVIDER=livekit

# --- LiveKit Cloud (Coolify — minimal set) ---
# These three are required. LIVEKIT_URL may be EITHER:
#   wss://sms-xxxxx.livekit.cloud
#   sms-xxxxx.sip.livekit.cloud          ← common Coolify setup (code accepts this)
# LIVEKIT_URL=sms-xxxxx.sip.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
#
# Optional (defaults are fine):
# LIVEKIT_AGENT_NAME=transovo-voice-runtime   # shared worker for inbound + outbound
# LIVEKIT_OUTBOUND_TRUNK_ID=              # optional; auto-provisioned on first outbound dial
# LIVEKIT_OUTBOUND_TRUNK_NAME=transovo-telnyx-outbound
# LIVEKIT_OUTBOUND_ROOM_PREFIX=transovo-outbound-
# TELNYX_SIP_OUTBOUND_ADDRESS=sip.telnyx.com
# TELNYX_SIP_OUTBOUND_USERNAME=             # Telnyx credential for LiveKit outbound trunk
# TELNYX_SIP_OUTBOUND_PASSWORD=
# OUTBOUND_VOICE_TEST_MODE=0                # set to 1 for CLI smoke script only
# OUTBOUND_TEST_PHONE=                      # dev destination e.g. +15714776175
# OUTBOUND_AUTO_SMOKE_CALL=0                # set to 1 to auto-dial OUTBOUND_TEST_PHONE ~45s after deploy
# OUTBOUND_REALTIME_TEST=0                  # set to 1 to auto-provision realtime clone on boot + target auto-smoke at it
# FRONTDESK_REALTIME_TEST=0                 # upgrade frontdesk to realtime + reassign inbound DID on boot
# FRONTDESK_PHONE_E164=+18663464256         # inbound DID for frontdesk (default 866); stolen from Amy exclusively
# INBOUND_REALTIME_TEST=0                   # Amy only — do NOT set if you want frontdesk-only realtime
# VOICE_INBOUND_REALTIME=0                  # Amy only — do NOT set if you want frontdesk-only realtime
# OUTBOUND_SMOKE_AGENT_ID=                  # optional override; auto-set to realtime clone when OUTBOUND_REALTIME_TEST=1
# VOICE_REALTIME_MODEL=gpt-realtime-2.1-mini # realtime pipeline model (mini first, then gpt-realtime-2.1 for full)
# VOICE_REALTIME_OUTPUT_MODE=native          # native = OpenAI realtime audio out; elevenlabs = realtime text + ElevenLabs TTS
# VOICE_REALTIME_VOICE=marin                 # default native voice; also: coral, shimmer, cedar, sage, etc.
# OUTBOUND_AUTO_SMOKE_VOICE=coral            # per-deploy auto-smoke voice override (wins over VOICE_REALTIME_VOICE)
# OUTBOUND_VOICE_BENCHMARK_VOICES=marin,coral,shimmer,cedar
# OUTBOUND_VOICE_BENCHMARK_DELAY_SEC=180     # pause between benchmark dials (CLI script)
# VOICE_REALTIME_REASONING_EFFORT=low        # gpt-realtime-2.1 full model only (not mini)
# VOICE_REALTIME_VAD_MODE=semantic           # semantic (default) or server
# VOICE_REALTIME_VAD_EAGERNESS=high          # semantic only: low | medium | high | auto (default high)
# VOICE_REALTIME_INTERRUPT_RESPONSE=1        # allow caller barge-in during agent speech (default on)
# VOICE_REALTIME_VAD_THRESHOLD=0.7           # server_vad only
# VOICE_REALTIME_VAD_SILENCE_MS=400          # server_vad only — ms of silence before end-of-turn
# VOICE_REALTIME_VAD_PREFIX_MS=300           # server_vad only
# WORKSPACE_ID=ws_1                         # workspace for cron/auto smoke calls
# DISABLE_INPROCESS_VOICE_RUNTIME=1   # set when running voice-runtime externally
# OPENAI_API_KEY=
# ELEVENLABS_KEY=
#
# You do NOT need LIVEKIT_SIP_HOST if LIVEKIT_URL is already the *.sip.livekit.cloud value.

# Voice pipeline providers (LiveKit Agents — defaults to BYO plugins)
# VOICE_STT_PROVIDER=deepgram-plugin
# VOICE_STT_MODEL=deepgram/flux-general-en
# DEEPGRAM_API_KEY=
# VOICE_STT_LANGUAGE=en
# VOICE_LLM_PROVIDER=openai
# VOICE_LLM_MODEL=gpt-4.1-mini
# VOICE_LLM_PRESET=gpt-4.1-mini
# VOICE_TTS_PROVIDER=elevenlabs-plugin
# VOICE_TTS_MODEL=eleven_flash_v2_5
# VOICE_TTS_VOICE=cgSgspJ2msm6clMCkdW9
# VOICE_TURN_PRESET=flux_eager
# VOICE_FLUX_EAGER_EOT_THRESHOLD=0.3
# VOICE_FLUX_EOT_THRESHOLD=0.7
# ELEVENLABS_API_KEY=   # alias: ELEVENLABS_KEY
# Inference-only (not used in production):
# VOICE_STT_PROVIDER=inference
# VOICE_LLM_PRESET=gemma-4-31b

# Telnyx LLM via OpenAI-compatible plugin (optional):
# TELNYX_INFERENCE_API_KEY=

# Optional email (campaign email steps)
# BREVO_API_KEY=
# REVIEW_REQUEST_FROM_EMAIL=noreply@transovo.ai
# REVIEW_REQUEST_FROM_NAME=Transovo AI
# REVIEW_LINK_FALLBACK=https://transovo.ai
