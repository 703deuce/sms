{
  "_meta": {
    "version": "2026-10-25",
    "status": "DRAFT. All weights, lambdas, thresholds and sweet spots are JUDGMENT calls derived from clip_playbook_research.md, not measured. Tune them against labeled clips and post performance (VVSA, sends, completion).",
    "score_keys": [
      "hook",
      "self_contained",
      "payoff",
      "energy",
      "value"
    ],
    "signal_keys": [
      "laugh_in_landing",
      "peak_arousal",
      "hook_pitch_var",
      "opening_clean",
      "ending_clean",
      "specificity",
      "qa_contained"
    ],
    "formula": "base=sum(w[k]*score[k]); sig=sum(sw[f]*feature[f]); final=clamp(10*((1-lambda)*base/10 + lambda*sig) - penalties, 0, 10)",
    "ui_mapping": {
      "Hook": "hook",
      "Flow": "round(mean(self_contained,payoff))",
      "Value": "value",
      "Overall": "round(final)"
    },
    "platform_hard_limits": {
      "youtube_shorts": {
        "max_s": 180,
        "max_s_with_content_id_claim": 60,
        "note": "3-min Shorts since 2024-10-15; >1 min with active Content ID claim is blocked (YouTube Help)"
      },
      "instagram_reels": {
        "max_s": 180,
        "note": "Reels up to 3 min recommendation-eligible (Instagram/Mosseri, see research \u00a71.4)"
      },
      "tiktok": {
        "max_s": null,
        "note": "verify: upload limits change often; do not hard-code"
      },
      "linkedin": {
        "max_s": null,
        "note": "verify"
      },
      "x": {
        "max_s": null,
        "note": "verify (depends on account tier)"
      }
    },
    "length_note": "min_s/max_s are soft by genre; sweet_spot_s is where to land when the thought allows. Length follows the thought; never cut a payoff to hit a range. Sweet spots are source-reported starting points plus judgment."
  },
  "default_genre": "podcast_interview",
  "ui_genre_map": {
    "podcast": "podcast_interview",
    "interview": "podcast_interview",
    "talk": "podcast_interview",
    "education": "solo_educational",
    "comedy": "comedy_standup",
    "business": "business_marketing",
    "motivational": "motivational_sermon",
    "gaming": "gaming_stream",
    "sports": "sports_tv",
    "news": "news_commentary",
    "howto": "howto_tutorial",
    "vlog": "solo_educational",
    "other": "podcast_interview"
  },
  "clip_length_buckets": {
    "auto": { "min_ms": 15000, "max_ms": 90000, "prefer_min_ms": 15000, "prefer_max_ms": 90000 },
    "lt30": { "min_ms": 10000, "max_ms": 30000 },
    "30_60": { "min_ms": 30000, "max_ms": 60000 },
    "60_90": { "min_ms": 60000, "max_ms": 90000 }
  },
  "chunk_minutes": 20,
  "chunk_overlap_minutes": 2,
  "pass2_context_seconds": 120,
  "global": {
    "hard_gates": {
      "self_contained_min": 5,
      "payoff_min": 4,
      "payoff_min_waived_for": [
        "teaser"
      ],
      "reject_if_ends_mid_sentence": true,
      "reject_if_ends_mid_list": true,
      "reject_if_meaning_changed": true
    },
    "snap": {
      "min_boundary_pause_s": 0.3,
      "preferred_end_pause_s": 0.4,
      "pad_start_s": 0.15,
      "pad_end_s": 0.35,
      "comedy_laugh_tail_s": [
        2,
        4
      ]
    },
    "penalties": {
      "crosstalk": {
        "threshold": 0.15,
        "per_unit": 10,
        "multiplier_by_genre": {
          "podcast_interview": 0.3,
          "solo_educational": 1.0,
          "comedy_standup": 0.0,
          "business_marketing": 1.0,
          "motivational_sermon": 1.0,
          "gaming_stream": 0.2,
          "sports_tv": 1.0,
          "news_commentary": 0.2,
          "howto_tutorial": 1.0
        }
      },
      "dead_air": {
        "internal_pause_s": 1.0,
        "threshold_ratio": 0.15,
        "per_unit": 10,
        "exempt": "comedy pre-punch pause"
      },
      "length_out_of_range": {
        "per_second": 0.05,
        "max": 2.0
      },
      "filler_open": {
        "value": 0.5,
        "tokens": [
          "so",
          "um",
          "uh",
          "yeah",
          "like",
          "and",
          "but",
          "anyway",
          "okay",
          "i mean",
          "great question"
        ]
      },
      "dangling_reference_open": {
        "value": 1.5,
        "tokens": [
          "he",
          "she",
          "they",
          "it",
          "that",
          "this",
          "those",
          "these",
          "but",
          "which",
          "also"
        ]
      }
    },
    "selection": {
      "min_final": 6.5,
      "max_clips": 20,
      "clips_per_minute": 0.333,
      "min_archetypes_per_hour": 2,
      "max_same_archetype_share": 0.5,
      "overlap": "forbid",
      "near_duplicate_text_jaccard": 0.5
    },
    "feature_definitions": {
      "laugh_in_landing": "1 if a laugh=1 sentence starts within 4 s after the payoff sentence ends (or is the payoff) and is inside the clip; else 0",
      "peak_arousal": "clip(max loud_z in clip,0,3)/3",
      "hook_pitch_var": "mean pitch_var of sentences overlapping the first 3 s",
      "opening_clean": "1 if first sentence pause_before>=0.3 AND does not start with filler/dangling token; 0.5 if only one; 0 if neither",
      "ending_clean": "1 if last sentence pause_after>=0.4 and not an unanswered q=1; 0.5 if pause_after 0.2-0.4; else 0",
      "specificity": "min(1, 2*share of sentences with num_ent=1)",
      "qa_contained": "1 if every q=1 in clip (except the first sentence's question) is answered inside; 1 if the clip opens on a q=1 and contains its answer; 0.5 if no questions; 0 if a question is left unanswered or the answer's question is missing",
      "crosstalk_ratio": "share of clip duration in xtalk=1 sentences"
    }
  },
