# transovo-voice service — copy to Coolify env (do not commit secrets)

# Use livekit_cloud for production PSTN (matches transovo-web MEDIA_BACKEND_MODE).
# Set self_hosted only when routing Telnyx to voice.transovo.ai.
MEDIA_BACKEND_MODE=livekit_cloud

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OPENAI_API_KEY=

# Public web app URL (HTTPS) or Docker network URL (http://web:3000)
TRANSOVO_BACKEND_URL=https://app.transovo.ai

# Same value as transovo-web TRANSOVO_INTERNAL_API_KEY
TRANSOVO_INTERNAL_API_KEY=

LIVEKIT_AGENT_NAME=transovo-voice-runtime

# PSTN noise cancellation (LiveKit BVCTelephony). Set to 0 to disable.
# VOICE_TELEPHONY_NOISE_CANCELLATION=1

# Optional realtime overrides
# VOICE_REALTIME_MODEL=gpt-realtime-2
# VOICE_REALTIME_VOICE=marin
