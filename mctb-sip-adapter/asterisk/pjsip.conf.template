; Telnyx FQDN → this host. Inbound only — no PBX features.

[global]
type=global
max_forwards=70
user_agent=Transovo-MCTB-SIP-Adapter

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:${SIP_UDP_PORT}
external_media_address=${EXTERNAL_SIP_IP}
external_signaling_address=${EXTERNAL_SIP_IP}
local_net=127.0.0.0/8
local_net=10.0.0.0/8
local_net=172.16.0.0/12
local_net=192.168.0.0/16

[telnyx-aor]
type=aor
max_contacts=0
remove_existing=yes

[telnyx-endpoint]
type=endpoint
transport=transport-udp
context=mctb-inbound
disallow=all
allow=ulaw,alaw,g722
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
timers=no
100rel=yes
inband_progress=yes
aors=telnyx-aor
identify_by=ip

[telnyx-identify]
type=identify
endpoint=telnyx-endpoint
match=${TELNYX_SIP_IDENTIFY_IPS}
