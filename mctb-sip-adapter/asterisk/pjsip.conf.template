; Telnyx FQDN → this host. Inbound only — no PBX features.

[global]
type=global
max_forwards=70
user_agent=Transovo-MCTB-SIP-Adapter

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:${SIP_UDP_PORT}
external_media_address=${EXTERNAL_SIP_IP}
external_signaling_address=${EXTERNAL_SIP_IP}
local_net=127.0.0.0/8
local_net=10.0.0.0/8
local_net=172.16.0.0/12
local_net=192.168.0.0/16

[telnyx-aor]
type=aor
max_contacts=0
remove_existing=yes

[telnyx-endpoint]
type=endpoint
transport=transport-udp
context=mctb-inbound
disallow=all
allow=ulaw,alaw,g722
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
trust_id_inbound=yes
send_pai=yes
timers=no
100rel=yes
inband_progress=yes
aors=telnyx-aor
identify_by=ip

; Telnyx signaling IPs — https://sip.telnyx.com/voice.json (match=0.0.0.0/0 is invalid)
[telnyx-identify]
type=identify
endpoint=telnyx-endpoint
match=192.76.120.10
match=64.16.250.10
match=192.76.120.31
match=64.16.250.13
match=185.246.41.140
match=185.246.41.141
match=103.115.244.145
match=103.115.244.146
match=103.115.244.158
match=103.115.244.159
match=185.246.42.128
match=185.246.42.129
match=192.76.120.14
match=192.76.120.72
match=192.76.120.73
match=192.76.120.74
match=192.76.120.75
match=192.76.120.76
match=192.76.120.0/24
