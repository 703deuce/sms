[general]
static=yes
writeprotect=no
clearglobalvars=no

[globals]

[mctb-inbound]
; Telnyx PSTN/SIP ingress for MCTB press-1 consent.
; Match E.164 (+1866..., 1866..., 571..., etc.) — _X. does NOT match leading '+'.
exten => _.,1,NoOp(MCTB inbound ${CALLERID(num)} -> ${EXTEN} uniqueid=${UNIQUEID})
 same => n,Set(CHANNEL(hangup_handler_push)=mctb-hangup,s,1)
 same => n,Progress()
 same => n,AGI(mctb_inbound.py)
 same => n,Hangup()

; Fallback when Telnyx sends blank/extension-less INVITE
exten => s,1,NoOp(MCTB inbound s ${CALLERID(num)} uniqueid=${UNIQUEID})
 same => n,Set(CHANNEL(hangup_handler_push)=mctb-hangup,s,1)
 same => n,Progress()
 same => n,AGI(mctb_inbound.py)
 same => n,Hangup()

[mctb-hangup]
exten => s,1,NoOp(MCTB hangup handler complete)
