# Private Motion Studio render worker. This is NOT a public web service.
FROM node:22-bookworm
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    chromium ffmpeg fonts-dejavu-core fontconfig python3 python3-requests ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /root/modal_motion
RUN npm install --no-audit --no-fund puppeteer-core@24.31.0 hyperframes@0.9.52
COPY worker/modal_motion/capture.mjs worker/modal_motion/pipeline.py /root/modal_motion/
COPY worker/motion_render_host/server.py /opt/motion_render_host/server.py
ENV CHROMIUM_BIN=/usr/bin/chromium \
    HYPERFRAMES_TELEMETRY=0 \
    DO_NOT_TRACK=1 \
    RENDER_WORK_DIR=/work \
    PORT=8098
VOLUME ["/work"]
CMD ["python3", "-u", "/opt/motion_render_host/server.py"]
